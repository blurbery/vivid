+
+    // Vivid: a payload size the rest of the OBU cannot hold is a parse
+    // error before anything is reserved for it.
+    let available = reader.available()?;
+    ensure!(
+        (emdf_payload_size as u64)
+            .checked_mul(8)
+            .is_some_and(|bits| bits <= available),
+        "emdf_payload_size {emdf_payload_size}: more than the RPU can hold"
+    );
     let mut converted_buf = Vec::with_capacity(emdf_payload_size + 1);
     converted_buf.push(0x19);
 
