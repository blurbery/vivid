 use libc::{c_char, size_t};
 use std::{
     ffi::{CStr, CString},
+    panic::{AssertUnwindSafe, catch_unwind},
     path::PathBuf,
     ptr::{null, null_mut},
     slice,
 };
 
+use anyhow::{Result, anyhow};
+
 use crate::rpu::{ConversionMode, dovi_rpu::DoviRpu, utils::parse_rpu_file};
 
 use super::c_structs::*;
 
+// Vivid (Lucid Engine): no Rust panic may reach or abort at the C API
+// boundary. The library is built with panic=unwind, and every exported
+// function runs its work through `guard`, which catches a panic so the
+// function can return its normal error result instead: an RpuOpaque (or
+// RpuOpaqueList) carrying an error from the parsers, a null pointer from
+// the getters and writers, and -1 from the functions returning a status.
+// A function that was changing the RPU when it panicked also drops the
+// RPU, so a half-converted RPU is never written out later.
+
+const PANIC_ERROR: &str = "internal error (panic caught at the C API boundary)";
+
+// Runs `f`, returning None if it panicked.
+fn guard<T>(f: impl FnOnce() -> T) -> Option<T> {
+    catch_unwind(AssertUnwindSafe(f)).ok()
+}
+
+// A C string for an error message, without panicking on interior NULs.
+fn error_cstring(message: String) -> CString {
+    CString::new(message.replace('\0', "")).unwrap_or_default()
+}
+
+// Shared by the three parsers: a null buffer or an impossible length is a
+// parse error, and a panic while parsing is reported like any parse error.
+unsafe fn parse_buffer(
+    buf: *const u8,
+    len: size_t,
+    parse: fn(&[u8]) -> Result<DoviRpu>,
+) -> *mut RpuOpaque {
+    let opaque = guard(|| {
+        let res = if buf.is_null() {
+            Err(anyhow!("null buffer"))
+        } else if len > isize::MAX as usize {
+            Err(anyhow!("invalid buffer length {len}"))
+        } else {
+            let data = unsafe { slice::from_raw_parts(buf, len) };
+            parse(data)
+        };
+
+        RpuOpaque::from(res)
+    })
+    .unwrap_or_else(|| {
+        RpuOpaque::new(
+            None,
+            Some(error_cstring(format!("Failed parsing RPU: {PANIC_ERROR}"))),
+        )
+    });
+
+    Box::into_raw(Box::new(opaque))
+}
+
+// Records a panic in a writer as the writer's error.
+fn write_panicked(opaque: &mut RpuOpaque) -> *mut Data {
+    opaque.error = Some(error_cstring(format!(
+        "Failed writing byte buffer: {PANIC_ERROR}"
+    )));
+
+    null_mut()
+}
+
+// Drops an RPU that panicked while being changed, keeping the error.
+fn edit_panicked(opaque: &mut RpuOpaque, what: &str) -> i32 {
+    opaque.rpu = None;
+    opaque.error = Some(error_cstring(format!("{what}: {PANIC_ERROR}")));
+
+    -1
+}
