+        {"accept-compressed", OPT_BOOL(accept_compressed)},
+        {"manage-audio-session", OPT_BOOL(manage_audio_session)},
+        {"compressed-lead", OPT_DOUBLE(compressed_lead), M_RANGE(1, 30)},
+        {"compressed-start-grace", OPT_DOUBLE(compressed_start_grace), M_RANGE(1, 30)},
+        {"compressed-first-start-grace", OPT_DOUBLE(compressed_first_start_grace),
+            M_RANGE(0, 30)},
+        {"compressed-buffer", OPT_DOUBLE(compressed_buffer), M_RANGE(0.5, 2)},
+        {"compressed-anchor-start", OPT_BOOL(compressed_anchor_start)},
+        {"compressed-anchor-resume", OPT_BOOL(compressed_anchor_resume)},
+#if TARGET_OS_TV
+        // The bounded PCM mode exists on tvOS only.
+        {"max-lookahead", OPT_DOUBLE(max_lookahead), M_RANGE(0, 10)},
+#endif
+        {0}
+    },
+    .options_prefix = "ao-avfoundation",
 };
