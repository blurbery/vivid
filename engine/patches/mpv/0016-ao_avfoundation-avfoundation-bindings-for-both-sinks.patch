+static bool open_create_queue(void *ctx)
+{
+    struct ao *ao = ctx;
+    struct priv *p = ao->priv;
+    p->queue = dispatch_queue_create("avfoundation event",
+        dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL,
+                                                QOS_CLASS_USER_INTERACTIVE, 0));
+    if (!p->queue)
+        return false;
+    dispatch_queue_set_specific(p->queue, &queue_key, ao, NULL);
+    return true;
+}
+
+static bool open_pcm(void *ctx)
+{
+    return avfao_pcm_av_open(ctx);
+}
+
+static bool open_compressed(void *ctx, enum avfao_codec codec)
+{
+    return avfao_cx_av_open(ctx, codec);
+}
+
+static void open_discard(void *ctx)
+{
+    struct ao *ao = ctx;
+    struct priv *p = ao->priv;
+    if (p->compressed) {
+        avfao_cx_av_discard(ao);
+    } else {
+        avfao_pcm_av_discard(ao);
+    }
+    if (p->queue)
+        dispatch_release(p->queue);
+    p->queue = NULL;
+}
+
+static const struct avfao_open_ops open_ops = {
