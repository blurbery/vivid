+
+#ifndef MP_AO_AVFOUNDATION_PCM_H
+#define MP_AO_AVFOUNDATION_PCM_H
+
+#include "ao_avfoundation_core.h"
+
+// The renderer and synchroniser are opaque handles here; the glue owns the
+// AVSampleBufferAudioRenderer and AVSampleBufferRenderSynchronizer objects.
+struct avfao_pcm_ops {
+    int64_t (*sync_time)(void *ctx, void *sync);
+    double (*sync_rate)(void *ctx, void *sync);
+    void (*set_rate)(void *ctx, void *sync, double rate);
+    bool (*ready)(void *ctx, void *renderer);
+    // AVQueuedSampleBufferRenderingStatus as an integer.
+    int (*status)(void *ctx, void *renderer);
+    // hasSufficientMediaDataForReliablePlaybackStart as 0 or 1, or -1 where
+    // the OS does not have it.
+    int (*sufficient)(void *ctx, void *renderer);
+    void (*flush)(void *ctx, void *renderer);
+    void (*stop_requesting)(void *ctx, void *renderer);
+    // Unbounded mode: feed from readiness callbacks on the AO queue.
+    void (*request_when_ready)(void *ctx, void *renderer);
+    void *(*buffer_new)(void *ctx, size_t bytes);
+    void (*buffer_free)(void *ctx, void *buffer);
+    // Wraps the buffer in a block buffer and a ready sample buffer at pts_ns
+    // and enqueues it. Always takes ownership of the buffer. Returns false
+    // (after logging) when either CoreMedia buffer cannot be created.
+    bool (*enqueue)(void *ctx, void *renderer, void *buffer, size_t bytes,
+                    int frames, int64_t pts_ns);
+    // Bounded mode feed timer: on = fire now, then every 50 ms (5 ms
+    // leeway); off = fire never.
+    void (*timer)(void *ctx, bool on);
+    // Fresh sink pieces. synchroniser_new adds the renderer and turns off
+    // the delayed rate change where the OS has it.
+    void *(*renderer_new)(void *ctx);
+    void *(*synchroniser_new)(void *ctx, void *renderer);
+    float (*volume)(void *ctx, void *renderer);
+    void (*set_volume)(void *ctx, void *renderer, float volume);
+    bool (*muted)(void *ctx, void *renderer);
+    void (*set_muted)(void *ctx, void *renderer, bool muted);
+    // Registers (on) or removes (off) the two restart notifications.
+    void (*observe)(void *ctx, void *renderer, bool on);
+    // Releases either handle (each may be NULL).
+    void (*release)(void *ctx, void *renderer, void *sync);
+    // The driver's reset then start, as a restart notification asks.
+    void (*restart)(void *ctx);
+};
+
+#define AVFAO_PCM_TICK_READS 4
+#define AVFAO_PCM_LINE_INTERVAL_NS (2 * AVFAO_NS_PER_S)
+#define AVFAO_PCM_LINE_DETAIL_NS (250 * AVFAO_NS_PER_MS)
+
+struct avfao_pcm {
+    const struct avfao_host *host;
+    const struct avfao_pcm_ops *ops;
+    void *ctx;
+    struct avfao_trace *trace;
+
+    void *renderer;
+    void *sync;
+
+    int rate;
+    int frame_bytes;
+
+    // Bounded mode (tvOS with max-lookahead above 0).
+    bool bounded;
+    int64_t bound_ns;
+    bool feeding;
+    bool fresh_pending;
+    int64_t line_ns;
+
+    // End of the last enqueued buffer on the renderer timeline.
+    int64_t end_ns;
+};
+
+void avfao_pcm_init(struct avfao_pcm *pcm, const struct avfao_host *host,
+                    const struct avfao_pcm_ops *ops, void *ctx,
+                    struct avfao_trace *trace, int rate, int frame_bytes);
+
+// Decides the mode at init. max_lookahead is 0 where the option does not
+// exist. timer_ok says whether the bounded feed timer could be created.
+void avfao_pcm_choose_mode(struct avfao_pcm *pcm, double max_lookahead,
+                           double audio_buffer, bool timer_ok);
+
+// One 100 ms read from mpv onto the renderer (both modes).
+void avfao_pcm_feed(struct avfao_pcm *pcm);
+// Bounded mode timer tick.
+void avfao_pcm_tick(struct avfao_pcm *pcm);
+void avfao_pcm_set_feeding(struct avfao_pcm *pcm, bool on);
+
+// Transport. In bounded mode all of these run on the AO queue.
+void avfao_pcm_reset(struct avfao_pcm *pcm);
+void avfao_pcm_start(struct avfao_pcm *pcm);
+void avfao_pcm_pause(struct avfao_pcm *pcm, bool paused);
+
+// A WasFlushedAutomatically or OutputConfigurationDidChange notification.
+// object is the renderer that posted it.
+void avfao_pcm_notification(struct avfao_pcm *pcm, const char *name,
+                            bool has_flush_time, double flush_time,
+                            void *object);
+
+#endif
