     sources += files('audio/out/ao_avfoundation.m')
     sources += files('audio/out/ao_avfoundation_core.c')
+    sources += files('audio/out/ao_avfoundation_pcm.c')
     # The AVFoundation output uses the CoreFoundation string helpers in
