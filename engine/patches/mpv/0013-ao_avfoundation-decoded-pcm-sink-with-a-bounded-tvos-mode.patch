+#include "audio/format.h"
+#include "audio/out/ao_avfoundation_av.h"
+#include "audio/out/ao_coreaudio_chmap.h"
+#include "audio/out/ao_coreaudio_utils.h"
+#include "common/msg.h"
+#include "ta/ta_talloc.h"
+
+#include <TargetConditionals.h>
+
+@interface MPAVFRendererObserver : NSObject {
+    struct ao *ao;
+}
+- (instancetype)initWithAO:(struct ao *)_ao;
+- (void)handleRestartNotification:(NSNotification *)notification;
+@end
+
+@implementation MPAVFRendererObserver
+- (instancetype)initWithAO:(struct ao *)_ao
+{
+    self = [super init];
+    if (self)
+        ao = _ao;
+    return self;
+}
+
+- (void)handleRestartNotification:(NSNotification *)notification
+{
+    struct priv *p = ao->priv;
+    char *name = cfstr_get_cstr((CFStringRef)notification.name);
+    void *object = notification.object;
+
+    if (!p->pcm.bounded) {
+        // Upstream's handling, on the posting thread.
+        avfao_pcm_notification(&p->pcm, name, false, 0, object);
+        talloc_free(name);
+        return;
+    }
+
+    bool has_flush_time = false;
+    double flush_time = 0;
+    id value = notification.userInfo[AVSampleBufferAudioRendererFlushTimeKey];
+    if ([value isKindOfClass:[NSValue class]]) {
+        has_flush_time = true;
+        flush_time = CMTimeGetSeconds([(NSValue *)value CMTimeValue]);
+    }
+    struct ao *target = ao;
+    avfao_av_run(target, ^{
+        @autoreleasepool {
+            avfao_pcm_notification(&p->pcm, name, has_flush_time, flush_time, object);
+        }
+    });
+    talloc_free(name);
+}
+@end
+
+// ---- renderer and synchroniser operations for the C side
+
+static int64_t op_sync_time(void *ctx, void *sync)
+{
+    return avfao_av_cmtime_ns([(AVSampleBufferRenderSynchronizer *)sync currentTime]);
+}
+
+static double op_sync_rate(void *ctx, void *sync)
+{
+    return [(AVSampleBufferRenderSynchronizer *)sync rate];
+}
+
+static void op_set_rate(void *ctx, void *sync, double rate)
+{
+    [(AVSampleBufferRenderSynchronizer *)sync setRate:(float)rate];
+}
+
+static bool op_ready(void *ctx, void *renderer)
+{
+    return [(AVSampleBufferAudioRenderer *)renderer isReadyForMoreMediaData];
+}
+
+static int op_status(void *ctx, void *renderer)
+{
+    return (int)[(AVSampleBufferAudioRenderer *)renderer status];
+}
+
+static int op_sufficient(void *ctx, void *renderer)
+{
+    if (@available(iOS 14.5, tvOS 14.5, macOS 11.3, *)) {
+        return [(AVSampleBufferAudioRenderer *)renderer
+                    hasSufficientMediaDataForReliablePlaybackStart] ? 1 : 0;
+    }
+    return -1;
+}
+
+static void op_flush(void *ctx, void *renderer)
+{
+    [(AVSampleBufferAudioRenderer *)renderer flush];
+}
+
+static void op_stop_requesting(void *ctx, void *renderer)
+{
+    [(AVSampleBufferAudioRenderer *)renderer stopRequestingMediaData];
+}
+
+static void op_request_when_ready(void *ctx, void *renderer)
+{
+    struct ao *ao = ctx;
+    struct priv *p = ao->priv;
+    [(AVSampleBufferAudioRenderer *)renderer requestMediaDataWhenReadyOnQueue:p->queue
+        usingBlock:^{
+            @autoreleasepool {
+                avfao_pcm_feed(&p->pcm);
+            }
+        }];
+}
+
+static void *op_buffer_new(void *ctx, size_t bytes)
+{
+    return CFAllocatorAllocate(NULL, (CFIndex)bytes, 0);
+}
+
+static void op_buffer_free(void *ctx, void *buffer)
+{
+    CFAllocatorDeallocate(NULL, buffer);
+}
+
+static bool op_enqueue(void *ctx, void *renderer, void *buffer, size_t bytes,
+                       int frames, int64_t pts_ns)
+{
+    struct ao *ao = ctx;
+    struct priv *p = ao->priv;
+    size_t frame_bytes = p->pcm.frame_bytes;
+    CMBlockBufferRef block_buffer = NULL;
+    CMSampleBufferRef sample_buffer = NULL;
+    bool ok = false;
+    OSStatus err;
+
+    if ((err = CMBlockBufferCreateWithMemoryBlock(
+        NULL,
+        buffer,
+        bytes,
+        NULL,
+        NULL,
+        0,
+        frames * frame_bytes,
+        0,
+        &block_buffer
+    )) != noErr) {
+        MP_FATAL(ao, "failed to create block buffer\n");
+        MP_VERBOSE(ao, "CMBlockBufferCreateWithMemoryBlock returned %d\n", (int)err);
+        CFAllocatorDeallocate(NULL, buffer);
+        goto done;
+    }
+    // The block buffer owns the memory from here on.
+
+    CMSampleTimingInfo timing[] = {(CMSampleTimingInfo) {
+        .duration = CMTimeMake(1, p->pcm.rate),
+        .presentationTimeStamp = CMTimeMake(pts_ns, 1000000000),
+        .decodeTimeStamp = kCMTimeInvalid
+    }};
+    size_t sample_sizes[] = {frame_bytes};
+    if ((err = CMSampleBufferCreateReady(
+        NULL,
+        block_buffer,
+        p->format_description,
+        frames,
+        1,
+        timing,
+        1,
+        sample_sizes,
+        &sample_buffer
+    )) != noErr) {
+        MP_FATAL(ao, "failed to create sample buffer\n");
+        MP_VERBOSE(ao, "CMSampleBufferCreateReady returned %d\n", (int)err);
+        goto done;
+    }
+
+    [(AVSampleBufferAudioRenderer *)renderer enqueueSampleBuffer:sample_buffer];
+    ok = true;
+
+done:
+    if (block_buffer)
+        CFRelease(block_buffer);
+    if (sample_buffer)
+        CFRelease(sample_buffer);
+    return ok;
+}
+
+static void op_timer(void *ctx, bool on)
+{
+    struct ao *ao = ctx;
+    struct priv *p = ao->priv;
+    if (!p->pcm_timer)
+        return;
+    if (on) {
+        dispatch_source_set_timer(p->pcm_timer, dispatch_time(DISPATCH_TIME_NOW, 0),
+                                  50 * NSEC_PER_MSEC, 5 * NSEC_PER_MSEC);
+    } else {
+        dispatch_source_set_timer(p->pcm_timer, DISPATCH_TIME_FOREVER,
+                                  DISPATCH_TIME_FOREVER, 0);
+    }
+}
+
+static void *op_renderer_new(void *ctx)
+{
+    return [[AVSampleBufferAudioRenderer alloc] init];
+}
+
+static void *op_synchroniser_new(void *ctx, void *renderer)
+{
+    AVSampleBufferRenderSynchronizer *sync = [[AVSampleBufferRenderSynchronizer alloc] init];
+    if (!sync)
+        return NULL;
+    [sync addRenderer:(AVSampleBufferAudioRenderer *)renderer];
+#if HAVE_MACOS_11_3_FEATURES
+    if (@available(tvOS 14.5, iOS 14.5, macOS 11.3, *))
+        [sync setDelaysRateChangeUntilHasSufficientMediaData:NO];
+#endif
+    return sync;
+}
+
+static float op_volume(void *ctx, void *renderer)
+{
+    return [(AVSampleBufferAudioRenderer *)renderer volume];
+}
+
+static void op_set_volume(void *ctx, void *renderer, float volume)
+{
+    [(AVSampleBufferAudioRenderer *)renderer setVolume:volume];
+}
+
+static bool op_muted(void *ctx, void *renderer)
+{
+    return [(AVSampleBufferAudioRenderer *)renderer isMuted];
+}
+
+static void op_set_muted(void *ctx, void *renderer, bool muted)
+{
+    [(AVSampleBufferAudioRenderer *)renderer setMuted:muted];
+}
+
+static void op_observe(void *ctx, void *renderer, bool on)
+{
+    struct ao *ao = ctx;
+    struct priv *p = ao->priv;
+    NSNotificationCenter *center = [NSNotificationCenter defaultCenter];
+    id object = (AVSampleBufferAudioRenderer *)renderer;
+    if (on) {
+#if HAVE_MACOS_12_FEATURES
+        if (@available(tvOS 15.0, iOS 15.0, macOS 12.0, *)) {
+            [center addObserver:p->observer selector:@selector(handleRestartNotification:)
+                name:AVSampleBufferAudioRendererOutputConfigurationDidChangeNotification
+                object:object];
+        }
+#endif
+        [center addObserver:p->observer selector:@selector(handleRestartNotification:)
+            name:AVSampleBufferAudioRendererWasFlushedAutomaticallyNotification
+            object:object];
+    } else {
+#if HAVE_MACOS_12_FEATURES
+        if (@available(tvOS 15.0, iOS 15.0, macOS 12.0, *)) {
+            [center removeObserver:p->observer
+                name:AVSampleBufferAudioRendererOutputConfigurationDidChangeNotification
+                object:object];
+        }
+#endif
+        [center removeObserver:p->observer
+            name:AVSampleBufferAudioRendererWasFlushedAutomaticallyNotification
+            object:object];
+    }
+}
+
+static void op_release(void *ctx, void *renderer, void *sync)
+{
+    if (sync)
+        [(AVSampleBufferRenderSynchronizer *)sync release];
+    if (renderer)
+        [(AVSampleBufferAudioRenderer *)renderer release];
+}
+
+static void op_restart(void *ctx)
+{
+    avfao_av_reset(ctx);
+    avfao_av_start(ctx);
+}
+
+static const struct avfao_pcm_ops pcm_ops = {
+    .sync_time = op_sync_time,
+    .sync_rate = op_sync_rate,
+    .set_rate = op_set_rate,
+    .ready = op_ready,
+    .status = op_status,
+    .sufficient = op_sufficient,
+    .flush = op_flush,
+    .stop_requesting = op_stop_requesting,
+    .request_when_ready = op_request_when_ready,
+    .buffer_new = op_buffer_new,
+    .buffer_free = op_buffer_free,
+    .enqueue = op_enqueue,
+    .timer = op_timer,
+    .renderer_new = op_renderer_new,
+    .synchroniser_new = op_synchroniser_new,
+    .volume = op_volume,
+    .set_volume = op_set_volume,
+    .muted = op_muted,
+    .set_muted = op_set_muted,
+    .observe = op_observe,
+    .release = op_release,
+    .restart = op_restart,
+};
+
+// ---- opening and closing
+
+bool avfao_pcm_av_open(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    AudioChannelLayout *layout = NULL;
+    p->compressed = false;
+    avfao_pcm_init(&p->pcm, &p->host, &pcm_ops, ao, &p->trace, ao->samplerate, 0);
+
+    AVSampleBufferAudioRenderer *renderer = op_renderer_new(ao);
+    if (!renderer) {
+        MP_FATAL(ao, "failed to create audio renderer\n");
+        MP_VERBOSE(ao, "AVSampleBufferAudioRenderer failed to initialize\n");
+        goto error;
+    }
+    p->pcm.renderer = renderer;
+
+#if TARGET_OS_OSX
+    // Output device selection only exists on macOS. iOS and tvOS route audio
+    // through the shared AVAudioSession instead.
+    if (ao->device && ao->device[0]) {
+        [renderer setAudioOutputDeviceUniqueID:(NSString*)cfstr_from_cstr(ao->device)];
+    }
+#endif
+
+    p->pcm.sync = op_synchroniser_new(ao, renderer);
+    if (!p->pcm.sync) {
+        MP_FATAL(ao, "failed to create rendering synchronizer\n");
+        MP_VERBOSE(ao, "AVSampleBufferRenderSynchronizer failed to initialize\n");
+        goto error;
+    }
+
+    // AVSampleBufferAudioRenderer only supports interleaved formats
+    ao->format = af_fmt_from_planar(ao->format);
+    if (af_fmt_is_planar(ao->format)) {
+        MP_FATAL(ao, "planar audio formats are unsupported\n");
+        goto error;
+    }
+
+    AudioStreamBasicDescription asbd;
+    ca_fill_asbd(ao, &asbd);
+    size_t layout_size;
+    layout = ca_get_acl(ao, &layout_size);
+
+    OSStatus err;
+    if ((err = CMAudioFormatDescriptionCreate(
+        NULL,
+        &asbd,
+        layout_size,
+        layout,
+        0,
+        NULL,
+        NULL,
+        &p->format_description
+    )) != noErr) {
+        MP_FATAL(ao, "failed to create audio format description\n");
+        MP_VERBOSE(ao, "CMAudioFormatDescriptionCreate returned %d\n", (int)err);
+        goto error;
+    }
+    talloc_free(layout);
+    layout = NULL;
+
+    p->pcm.frame_bytes = af_fmt_to_bytes(ao->format) * ao->channels.num;
+
+    // AVSampleBufferAudioRenderer read ahead aggressively
+    ao->device_buffer = ao->samplerate * 2;
+
+    p->observer = [[MPAVFRendererObserver alloc] initWithAO:ao];
+    op_observe(ao, p->pcm.renderer, true);
+
+    // tvOS can bound the renderer queue and feed it from a timer.
+    double max_lookahead = 0;
+#if TARGET_OS_TV
+    max_lookahead = p->max_lookahead;
+#endif
+    bool timer_ok = false;
+    if (max_lookahead > 0) {
+        p->pcm_timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, p->queue);
+        if (p->pcm_timer) {
+            dispatch_source_set_event_handler(p->pcm_timer, ^{
+                @autoreleasepool {
+                    avfao_pcm_tick(&p->pcm);
+                }
+            });
+            dispatch_source_set_timer(p->pcm_timer, DISPATCH_TIME_FOREVER,
+                                      DISPATCH_TIME_FOREVER, 0);
+            dispatch_resume(p->pcm_timer);
+            timer_ok = true;
+        }
+    }
+    avfao_pcm_choose_mode(&p->pcm, max_lookahead, ao->def_buffer, timer_ok);
+
+    return true;
+
+error:
+    talloc_free(layout);
+    return false;
+}
+
+// Releases the sink's objects. Closing keeps upstream's order (renderer,
+// synchroniser, queue and format description, then the observer); a failed
+// open leaves the queue to the centre.
+static void release_objects(struct ao *ao, bool closing)
+{
+    struct priv *p = ao->priv;
+    if (p->pcm_timer) {
+        dispatch_release(p->pcm_timer);
+        p->pcm_timer = NULL;
+    }
+    if (p->pcm.renderer)
+        [(AVSampleBufferAudioRenderer *)p->pcm.renderer release];
+    if (p->pcm.sync)
+        [(AVSampleBufferRenderSynchronizer *)p->pcm.sync release];
+    p->pcm.renderer = NULL;
+    p->pcm.sync = NULL;
+    if (closing && p->queue) {
+        dispatch_release(p->queue);
+        p->queue = NULL;
+    }
+    if (p->format_description)
+        CFRelease(p->format_description);
+    p->format_description = NULL;
+    if (p->observer) {
+        [[NSNotificationCenter defaultCenter] removeObserver:p->observer];
+        [p->observer release];
+        p->observer = nil;
+    }
+}
+
+void avfao_pcm_av_discard(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    // Nothing can be running on the queue yet.
+    if (p->pcm_timer)
+        dispatch_source_cancel(p->pcm_timer);
+    release_objects(ao, false);
+}
+
+void avfao_pcm_av_close(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    if (p->pcm_timer) {
+        dispatch_source_t timer = p->pcm_timer;
+        avfao_av_run(ao, ^{
+            dispatch_source_cancel(timer);
+        });
+    }
+    release_objects(ao, true);
+}
+
+// ---- driver calls
+
+void avfao_pcm_av_reset(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    avfao_av_run(ao, ^{
+        @autoreleasepool {
+            avfao_pcm_reset(&p->pcm);
+        }
+    });
+}
+
+void avfao_pcm_av_start(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    if (!p->pcm.bounded) {
+        avfao_pcm_start(&p->pcm);
+        return;
+    }
+    avfao_av_run(ao, ^{
+        @autoreleasepool {
+            avfao_pcm_start(&p->pcm);
+        }
+    });
+}
+
+void avfao_pcm_av_pause(struct ao *ao, bool paused)
+{
+    struct priv *p = ao->priv;
+    if (!p->pcm.bounded) {
+        avfao_pcm_pause(&p->pcm, paused);
+        return;
+    }
+    avfao_av_run(ao, ^{
+        @autoreleasepool {
+            avfao_pcm_pause(&p->pcm, paused);
+        }
+    });
+}
+
+static int renderer_control(struct ao *ao, enum aocontrol cmd, void *arg)
+{
+    struct priv *p = ao->priv;
+    AVSampleBufferAudioRenderer *renderer = p->pcm.renderer;
+
+    switch (cmd) {
+    case AOCONTROL_GET_MUTE:
+        *(bool*)arg = [renderer isMuted];
+        return CONTROL_OK;
+    case AOCONTROL_GET_VOLUME:
+        *(float*)arg = [renderer volume] * 100;
+        return CONTROL_OK;
+    case AOCONTROL_SET_MUTE:
+        [renderer setMuted:*(bool*)arg];
+        return CONTROL_OK;
+    case AOCONTROL_SET_VOLUME:
+        [renderer setVolume:*(float*)arg / 100];
+        return CONTROL_OK;
+    default:
+        return CONTROL_UNKNOWN;
+    }
+}
+
+int avfao_pcm_av_control(struct ao *ao, enum aocontrol cmd, void *arg)
+{
+    struct priv *p = ao->priv;
+    if (!p->pcm.bounded)
+        return renderer_control(ao, cmd, arg);
+    // Never overlaps a renderer replacement.
+    __block int r;
+    avfao_av_run(ao, ^{
+        r = renderer_control(ao, cmd, arg);
+    });
+    return r;
+}
