new file mode 100644
index 0000000000..0000000000
--- /dev/null
+++ b/audio/out/ao_avfoundation_compressed.c
@@ -0,0 +1,366 @@
+/*
+ * AVFoundation audio output: AC-3 and E-AC-3 passthrough through AVPlayer.
+ *
