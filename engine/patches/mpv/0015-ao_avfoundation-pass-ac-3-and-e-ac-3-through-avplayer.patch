+#ifndef MP_AO_AVFOUNDATION_IEC61937_H
+#define MP_AO_AVFOUNDATION_IEC61937_H
+
+#include "ao_avfoundation_core.h"
+
+#define AVFAO_IEC_HEADER 8
+#define AVFAO_IEC_FRAMES_PER_BURST 1536
+#define AVFAO_CARRIER_FRAME_BYTES 4
+#define AVFAO_WINDOW_HISTORY INT64_C(2097152)
+#define AVFAO_WINDOW_SLACK INT64_C(1048576)
+#define AVFAO_WINDOW_BYTES_PER_SECOND 786432.0
+
+// The plain AC-3 or E-AC-3 bytes handed to AVPlayer, indexed by their offset
+// from the start of the item's stream. Bytes below base are gone; head is
+// just past the newest byte.
+struct avfao_window {
+    uint8_t *data;
+    int64_t capacity;
+    int64_t storage_offset; // stream offset of data[0]
+    int64_t base;
+    int64_t head;
+};
+
+bool avfao_window_alloc(struct avfao_window *w, int64_t capacity);
+void avfao_window_free(struct avfao_window *w);
+void avfao_window_clear(struct avfao_window *w);
+int64_t avfao_window_space(const struct avfao_window *w);
+// Bytes from offset (base <= offset < head) to the head.
+const uint8_t *avfao_window_bytes(const struct avfao_window *w, int64_t offset);
+// Keep at most AVFAO_WINDOW_HISTORY bytes below low_water.
+void avfao_window_trim(struct avfao_window *w, int64_t low_water);
+// Window size for a steady lead: history + slack + 2 x lead x 768 KiB/s.
+int64_t avfao_window_capacity(double lead_seconds);
+
+// What to do with one pending loader request.
+enum avfao_serve {
+    AVFAO_SERVE_WAIT,       // at the write head
+    AVFAO_SERVE_DATA,       // respond with *len bytes from its offset
+    AVFAO_SERVE_FINISH,     // a bounded request at its end
+    AVFAO_SERVE_BELOW,      // below the retained window: fail (ESPIPE)
+    AVFAO_SERVE_BEYOND,     // past the write head: fail (ENOTSUP)
+};
+
+// end is the request's end offset, or -1 for a request to the end of the
+// resource. Logs the two refusals.
+enum avfao_serve avfao_serve_request(const struct avfao_host *host,
+                                     const struct avfao_window *w,
+                                     int64_t offset, int64_t end, int64_t *len);
+
+struct avfao_iec {
+    int data_type;     // low 7 bits of Pc
+    int burst_bytes;   // repetition period in bytes
+    bool pd_in_bits;   // AC-3 counts Pd in bits, E-AC-3 in bytes
+    int64_t burst_ns;  // one burst period at the codec rate
+
+    uint8_t *carry;    // bytes read from mpv but not yet resolved
+    int64_t carry_len;
+    int64_t carry_size;
+};
+
+bool avfao_iec_alloc(struct avfao_iec *iec, enum avfao_codec codec,
+                     int carrier_rate);
+void avfao_iec_free(struct avfao_iec *iec);
+
+// Turns the carry-over buffer into payloads in the window. Adds one burst
+// period to *fed_ns per accepted payload and to *dropped_ns per rejected
+// one. Returns false when the stream must fall back to PCM.
+bool avfao_iec_unwrap(struct avfao_iec *iec, struct avfao_window *w,
+                      const struct avfao_host *host,
+                      int64_t *fed_ns, int64_t *dropped_ns);
+
+#endif
