+
+#ifndef MP_AO_AVFOUNDATION_COMPRESSED_H
+#define MP_AO_AVFOUNDATION_COMPRESSED_H
+
+#include "ao_avfoundation_core.h"
+#include "ao_avfoundation_iec61937.h"
+#include "ao_avfoundation_startup.h"
+
+#define AVFAO_FILL_MAX_READS 64
+#define AVFAO_HEARTBEAT_EVERY 100
+#define AVFAO_HEARTBEAT_DETAIL_EVERY 5
+
+// AVPlayerItemStatusReadyToPlay.
+#define AVFAO_ITEM_READY 1
+
+// Everything the passthrough sink does to AVPlayer, its item and the
+// resource loader. All of it runs on the AO queue.
+struct avfao_cx_ops {
+    // Asset with the loader attached, item, its one property, then current.
+    bool (*item_create)(void *ctx);
+    // Rate 0, every pending loader request finished as cancelled, loader
+    // detached, current item cleared, item and asset released.
+    void (*item_teardown)(void *ctx);
+    void (*set_rate)(void *ctx, float rate);
+    // seekToTime:kCMTimeZero with no completion handler.
+    void (*seek_to_start)(void *ctx);
+    // The item's timebase time, when there is one and it is numeric.
+    bool (*timebase_time)(void *ctx, int64_t *ns);
+    // The item's currentTime, when numeric.
+    bool (*current_time)(void *ctx, int64_t *ns);
+    int (*item_status)(void *ctx);
+    int (*time_control)(void *ctx);
+    // True when the item failed or the player has an error; fills in the
+    // error's description, domain and code (or "unknown", "-" and 0).
+    bool (*failure)(void *ctx, char *desc, size_t desc_size, char *domain,
+                    size_t domain_size, long *code);
+    // Runs avfao_cx_serve_request() over the pending loader requests in
+    // arrival order, then avfao_window_trim() at their low-water mark.
+    void (*serve)(void *ctx);
+    // Smallest distance from the write head back to a pending data
+    // request at or behind it, or -1.
+    int64_t (*reader_gap)(void *ctx);
+    // Feed timer: armed = first fire in 50 ms, then every 50 ms (25 ms
+    // leeway); idle = fire never.
+    void (*timer)(void *ctx, bool armed);
+};
+
+struct avfao_cx_cfg {
+    double lead;           // compressed-lead
+    double grace;          // compressed-start-grace
+    double first_grace;    // compressed-first-start-grace
+    bool anchor_start;
+    bool anchor_resume;
+};
+
+struct avfao_cx {
+    const struct avfao_host *host;
+    const struct avfao_cx_ops *ops;
+    void *ctx;
+    struct avfao_trace *trace;
+
+    enum avfao_codec codec;
+    int carrier_rate;
+    int read_frames;
+
+    struct avfao_startup_cfg cfg;
+    struct avfao_startup st;
+    struct avfao_iec iec;
+    struct avfao_window win;
+
+    // For the AO's lifetime.
+    bool fallback;
+    uint64_t heartbeat;
+    bool playing;               // desired state
+
+    // For the current item.
+    bool item;
+    int64_t fed_ns;
+    int64_t consumed_frames;
+    int64_t dropped_ns;
+    bool eof;
+    int last_status;
+    int last_time_control;
+};
+
+bool avfao_cx_init(struct avfao_cx *cx, const struct avfao_host *host,
+                   const struct avfao_cx_ops *ops, void *ctx,
+                   struct avfao_trace *trace, enum avfao_codec codec,
+                   int carrier_rate, const struct avfao_cx_cfg *cfg);
+void avfao_cx_uninit(struct avfao_cx *cx);
+
+// Transport, on the AO queue.
+void avfao_cx_start(struct avfao_cx *cx);
+void avfao_cx_reset(struct avfao_cx *cx);
+void avfao_cx_pause(struct avfao_cx *cx, bool paused);
+
+// One feed step (timer ticks, new loader data requests, start, unpause).
+void avfao_cx_step(struct avfao_cx *cx);
+// Supervision alone, as the end of a feed step runs it.
+void avfao_cx_supervise(struct avfao_cx *cx);
+// Gives up on passthrough so mpv reopens audio as PCM. At most once.
+void avfao_cx_fallback(struct avfao_cx *cx);
+
+// The compressed clock and the feed position, both clamped to the fed
+// duration.
+int64_t avfao_cx_clock(const struct avfao_cx *cx);
+int64_t avfao_cx_feed_position(const struct avfao_cx *cx);
+
+// For the glue's serving pass.
+enum avfao_serve avfao_cx_serve_request(struct avfao_cx *cx, int64_t offset,
+                                        int64_t end, int64_t *len);
+
+#endif
