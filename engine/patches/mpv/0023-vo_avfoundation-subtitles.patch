+// Subtitles and OSD for the AVFoundation video output: change tracking over
+// the objects mpv's osd_render() returns, rasterising every object into one
+// premultiplied BGRA canvas (and a CoreGraphics snapshot for compositing),
+// dirty tracking of pool surfaces and the timed subtitle samples of the
+// separate layer.
+
+#ifndef MP_AVFOUNDATION_SUBTITLES_H
+#define MP_AVFOUNDATION_SUBTITLES_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include <CoreMedia/CoreMedia.h>
+
+#include "frame.h"
+#include "pixels.h"
+
+struct mp_log;
+struct sub_bitmap_list;
+struct sub_bitmaps;
+struct avf_subs;
+
+#define AVF_DIRTY_SURFACES 4
+#define AVF_DIRTY_IDLE_NS 2000000000LL
+
+// Performance counters behind the subtitle performance summary. The output
+// adds its own timings (enqueues, samples, waits, margins) directly.
+struct avf_subs_perf {
+    unsigned renders, skipped, empty, frames;
+    int64_t render_ns, render_max_ns;
+    int64_t clear_ns, blend_ns, cg_ns, bbox_ns;
+    unsigned sub_enqueues;
+    int64_t sub_enqueue_ns;
+    int64_t video_sample_ns;
+    int64_t wait_ns;
+    unsigned margins;
+    int64_t margin_total_ns, margin_min_ns;
+    unsigned sample_drops;
+};
+
+struct avf_subs *avf_subs_create(struct mp_log *log);
+void avf_subs_destroy(struct avf_subs *s);
+
+// Draws the frame's objects (the list osd_render() returned, in mpv's order)
+// unless they are unchanged since the last render. composite selects the
+// Picture in Picture mode, which also needs the CoreGraphics snapshot.
+void avf_subs_render(struct avf_subs *s, const struct sub_bitmap_list *list,
+                     int canvas_w, int canvas_h, bool composite);
+
+// Clearing the subtitle cache: drops the cached image and buffer, forgets the
+// recorded objects, clears the pending mark and empties the bounding box.
+// Never flushes a layer.
+void avf_subs_clear(struct avf_subs *s);
+
+// Forgets the recorded objects, so the next frame renders again.
+void avf_subs_reset_tracking(struct avf_subs *s);
+
+// After a display layer recovery: tracking and the pending mark are reset.
+void avf_subs_reset_after_recovery(struct avf_subs *s);
+
+bool avf_subs_present(const struct avf_subs *s);
+bool avf_subs_pending(const struct avf_subs *s);
+struct avf_irect avf_subs_bbox(const struct avf_subs *s);
+
+// Fills the composite inputs from the cached rendering.
+void avf_subs_overlay(const struct avf_subs *s, struct avf_overlay *ov);
+
+// The subtitle sample due on the separate layer (+1), or NULL when none is
+// pending or it could not be made: the cached canvas if a subtitle is
+// present, otherwise a freshly cleared buffer.
+CMSampleBufferRef avf_subs_sample(struct avf_subs *s, int canvas_w, int canvas_h,
+                                  int64_t pts_ns);
+
+// The pending sample reached the layer.
+void avf_subs_sample_enqueued(struct avf_subs *s);
+
+// The 60-flip maintenance: flushes excess pool buffers and forgets surfaces
+// idle for more than 2 s.
+void avf_subs_maintain(struct avf_subs *s);
+
+struct avf_subs_perf *avf_subs_perf(struct avf_subs *s);
+
+// The subtitle performance summary: due after 32 renders, or after at least
+// one render and 300 frames. Logged at verbose (built only when verbose
+// logging is on); the counters then start again.
+bool avf_subs_perf_due(const struct avf_subs *s);
+void avf_subs_perf_emit(struct avf_subs *s, int canvas_w, int canvas_h);
+
+// Monotonic nanoseconds used for the timings and the dirty-tracking ages.
+int64_t avf_subs_now(void);
+
+#endif
