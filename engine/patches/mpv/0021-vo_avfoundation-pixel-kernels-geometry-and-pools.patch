+
+// CoreVideo buffer pools of the AVFoundation video output. Every pool uses
+// the same attributes: at least 3 buffers, a maximum buffer age of 1 s, and
+// Metal-compatible, IOSurface-backed buffers.
+
+#ifndef MP_AVFOUNDATION_POOL_H
+#define MP_AVFOUNDATION_POOL_H
+
+#include <stdbool.h>
+
+#include <CoreVideo/CoreVideo.h>
+
+struct mp_log;
+
+struct avf_pool {
+    const char *name;           // for log lines
+    CVPixelBufferPoolRef pool;
+    int w, h;
+    OSType format;
+};
+
+// Returns a buffer (+1) of this size and format, replacing the pool first if
+// any of the three changed (the old pool's excess buffers are flushed). Sets
+// *recreated when a new pool was made. Logs an error and returns NULL when
+// the pool or the buffer cannot be made.
+CVPixelBufferRef avf_pool_get(struct avf_pool *p, struct mp_log *log,
+                              int w, int h, OSType format, bool *recreated);
+
+// Flushes buffers beyond the pool's minimum.
+void avf_pool_flush_excess(struct avf_pool *p);
+
+void avf_pool_release(struct avf_pool *p);
+
+#endif
