+
+// Pixel kernels for the AVFoundation video output: software upload copies,
+// the two direct subtitle blends and the YUV subtitle composite. Plain memory
+// in, plain memory out; no framework calls.
+
+#ifndef MP_AVFOUNDATION_PIXELS_H
+#define MP_AVFOUNDATION_PIXELS_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+// Half-open integer rectangle. Empty when x1 <= x0 or y1 <= y0.
+struct avf_irect {
+    int x0, y0, x1, y1;
+};
+
+bool avf_irect_empty(struct avf_irect r);
+struct avf_irect avf_irect_intersect(struct avf_irect a, struct avf_irect b);
+// Union of two rectangles; an empty one contributes nothing.
+struct avf_irect avf_irect_union(struct avf_irect a, struct avf_irect b);
+// The canonical empty box for a canvas: x0 = w, y0 = h, x1 = y1 = 0.
+struct avf_irect avf_irect_empty_box(int w, int h);
+
+// ---- software upload ------------------------------------------------------
+
+// Copies rows of min(src_stride, dst_stride) bytes, or the whole plane as one
+// block when the strides are equal.
+void avf_copy_plane(uint8_t *dst, ptrdiff_t dst_stride,
+                    const uint8_t *src, ptrdiff_t src_stride, int rows);
+
+// Copies width bytes per row, or one block when the strides are equal.
+void avf_copy_rows(uint8_t *dst, ptrdiff_t dst_stride,
+                   const uint8_t *src, ptrdiff_t src_stride,
+                   int width_bytes, int rows);
+
+// Interleaves 8-bit U and V rows sample by sample (U first).
+void avf_interleave_uv8(uint8_t *dst, ptrdiff_t dst_stride,
+                        const uint8_t *u, ptrdiff_t u_stride,
+                        const uint8_t *v, ptrdiff_t v_stride,
+                        int samples, int rows);
+
+// Copies 16-bit samples shifted left by shift bits.
+void avf_shift_rows16(uint8_t *dst, ptrdiff_t dst_stride,
+                      const uint8_t *src, ptrdiff_t src_stride,
+                      int samples, int rows, int shift);
+
+// Interleaves 16-bit U and V samples (U first), each shifted left.
+void avf_interleave_uv16(uint8_t *dst, ptrdiff_t dst_stride,
+                         const uint8_t *u, ptrdiff_t u_stride,
+                         const uint8_t *v, ptrdiff_t v_stride,
+                         int samples, int rows, int shift);
+
+// ---- subtitle blends into premultiplied BGRA --------------------------------
+
+struct avf_bgra {
+    uint8_t *data;
+    ptrdiff_t stride;
+    int w, h;
+};
+
+// libass A8 mask with colour 0xRRGGBBTT at (x, y), clipped to the canvas.
+void avf_blend_libass(const struct avf_bgra *dst, const uint8_t *mask,
+                      ptrdiff_t mask_stride, int x, int y, int w, int h,
+                      uint32_t color);
+
+// Premultiplied BGRA part at (x, y), clipped to the canvas.
+void avf_blend_bgra(const struct avf_bgra *dst, const uint8_t *src,
+                    ptrdiff_t src_stride, int x, int y, int w, int h);
+
+// Clears a rectangle (clamped to the canvas) to transparent.
+void avf_clear_bgra(const struct avf_bgra *dst, struct avf_irect r);
+
+// ---- YUV composite ------------------------------------------------------------
+
+enum avf_matrix {
+    AVF_MATRIX_BT709,
+    AVF_MATRIX_BT601,
+    AVF_MATRIX_BT2020,
+};
+
+// A biplanar 4:2:0 frame: 8-bit samples, or 10 significant bits at the top
+// of each little-endian 16-bit word.
+struct avf_yuv {
+    uint8_t *luma;
+    ptrdiff_t luma_stride;
+    uint8_t *chroma;            // interleaved Cb, Cr
+    ptrdiff_t chroma_stride;
+    int w, h;
+    bool ten_bit;
+    bool full_range;
+    enum avf_matrix matrix;
+};
+
+// Maps a subtitle bounding box (canvas coordinates) into frame pixels through
+// the source and destination rectangles, with one pixel of slack on each side,
+// clamped to the source rectangle (itself clamped to the frame). Returns false
+// when any rectangle involved, or the result, is empty.
+bool avf_blend_rect(struct avf_irect box, struct avf_irect src,
+                    struct avf_irect dst, int canvas_w, int canvas_h,
+                    int frame_w, int frame_h, struct avf_irect *out);
+
+// Blends the premultiplied BGRA canvas into the frame over rect (frame
+// pixels), sampling the canvas at the nearest position through src and dst.
+void avf_yuv_blend(const struct avf_yuv *frame, const struct avf_bgra *canvas,
+                   struct avf_irect rect, struct avf_irect src,
+                   struct avf_irect dst);
+
+#endif
