+#include <math.h>
+#include <string.h>
+
+#include "geometry.h"
+
+#pragma STDC FP_CONTRACT OFF
+
+int avf_pixel_extent(double size, double scale)
+{
+    double v = fma(size, scale, 0.5);
+    if (!(v >= 1.0))
+        return 1;
+    if (v >= 2147483647.0)
+        return 2147483647;
+    return (int)v; // truncates
+}
+
+double avf_layer_scale(double contents_scale, double screen_scale)
+{
+    return contents_scale > 0 ? contents_scale : screen_scale;
+}
+
+bool avf_canvas_empty(const struct avf_canvas *c)
+{
+    return c->w <= 0 || c->h <= 0;
+}
+
+void avf_frame_space_canvas(int frame_w, int frame_h, int p_w, int p_h,
+                            struct avf_canvas *out)
+{
+    memset(out, 0, sizeof(*out));
+    out->display_par = 1.0;
+    if (frame_w <= 0 || frame_h <= 0)
+        return;
+    out->w = frame_w;
+    out->h = frame_h;
+    out->src = out->dst = (struct avf_irect){ 0, 0, frame_w, frame_h };
+    if (p_w > 0 && p_h > 0)
+        out->display_par = p_h / (double)p_w;
+}
