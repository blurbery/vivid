+ */
+
+// Geometry for the AVFoundation video output: the host layer's pixel size
+// and the subtitle canvas in frame space (Picture in Picture compositing).
+// The display-space canvas comes from upstream's vo_get_src_dst_rects().
+
+#ifndef MP_AVFOUNDATION_GEOMETRY_H
+#define MP_AVFOUNDATION_GEOMETRY_H
+
+#include <stdbool.h>
+
+#include "pixels.h"
+
+// Pixels covered by size points at scale: the larger of 1 and the truncated
+// fused multiply-add size * scale + 0.5.
+int avf_pixel_extent(double size, double scale);
+
+// The scale used for the host layer: contentsScale when positive, otherwise
+// the main screen's scale.
+double avf_layer_scale(double contents_scale, double screen_scale);
+
+struct avf_canvas {
+    int w, h;                   // canvas pixel grid
+    int ml, mt, mr, mb;         // margins
+    double display_par;
+    struct avf_irect src, dst;  // source (frame) and destination (canvas)
+};
+
+bool avf_canvas_empty(const struct avf_canvas *c);
+
+// Frame space: the canvas is the frame's own pixel grid (the image's size,
+// or the configured size without an image), source and destination cover
+// the whole frame, margins are 0 and display_par is p_h / p_w (1.0 when
+// either is missing). A non-positive size gives an empty canvas.
+void avf_frame_space_canvas(int frame_w, int frame_h, int p_w, int p_h,
+                            struct avf_canvas *out);
+
+#endif
