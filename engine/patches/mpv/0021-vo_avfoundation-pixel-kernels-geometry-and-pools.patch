+ * mpv is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "common/msg.h"
+
+#include "pool.h"
+
+static void set_int(CFMutableDictionaryRef d, CFStringRef key, int value)
+{
+    CFNumberRef n = CFNumberCreate(NULL, kCFNumberIntType, &value);
+    if (n) {
+        CFDictionarySetValue(d, key, n);
+        CFRelease(n);
+    }
+}
+
+static CVPixelBufferPoolRef create_pool(int w, int h, OSType format)
+{
+    CFMutableDictionaryRef pool_attrs = CFDictionaryCreateMutable(NULL, 0,
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    CFMutableDictionaryRef buf_attrs = CFDictionaryCreateMutable(NULL, 0,
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    CFDictionaryRef iosurface = CFDictionaryCreate(NULL, NULL, NULL, 0,
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    CVPixelBufferPoolRef pool = NULL;
+    if (!pool_attrs || !buf_attrs || !iosurface)
+        goto done;
+
+    set_int(pool_attrs, kCVPixelBufferPoolMinimumBufferCountKey, 3);
+    double age = 1.0;
+    CFNumberRef age_n = CFNumberCreate(NULL, kCFNumberDoubleType, &age);
+    if (age_n) {
+        CFDictionarySetValue(pool_attrs, kCVPixelBufferPoolMaximumBufferAgeKey, age_n);
+        CFRelease(age_n);
+    }
+
+    int fmt = (int)format;
+    set_int(buf_attrs, kCVPixelBufferPixelFormatTypeKey, fmt);
+    set_int(buf_attrs, kCVPixelBufferWidthKey, w);
+    set_int(buf_attrs, kCVPixelBufferHeightKey, h);
+    CFDictionarySetValue(buf_attrs, kCVPixelBufferMetalCompatibilityKey, kCFBooleanTrue);
+    CFDictionarySetValue(buf_attrs, kCVPixelBufferIOSurfacePropertiesKey, iosurface);
+
+    if (CVPixelBufferPoolCreate(NULL, pool_attrs, buf_attrs, &pool) != kCVReturnSuccess)
+        pool = NULL;
+
+done:
+    if (pool_attrs)
+        CFRelease(pool_attrs);
+    if (buf_attrs)
+        CFRelease(buf_attrs);
+    if (iosurface)
+        CFRelease(iosurface);
+    return pool;
+}
+
+static void fourcc(OSType f, char out[5])
+{
+    out[0] = (char)((f >> 24) & 0xFF);
+    out[1] = (char)((f >> 16) & 0xFF);
+    out[2] = (char)((f >> 8) & 0xFF);
+    out[3] = (char)(f & 0xFF);
+    out[4] = '\0';
+    for (int i = 0; i < 4; i++) {
+        if (out[i] < 32 || out[i] > 126)
+            out[i] = '?';
+    }
+}
+
+CVPixelBufferRef avf_pool_get(struct avf_pool *p, struct mp_log *log,
+                              int w, int h, OSType format, bool *recreated)
+{
+    if (recreated)
+        *recreated = false;
+    if (!p->pool || p->w != w || p->h != h || p->format != format) {
+        avf_pool_release(p);
+        char cc[5];
+        fourcc(format, cc);
+        p->pool = create_pool(w, h, format);
+        if (!p->pool) {
+            mp_err(log, "Could not create the %s pixel buffer pool (%dx%d %s).\n",
+                   p->name, w, h, cc);
+            return NULL;
+        }
+        p->w = w;
+        p->h = h;
+        p->format = format;
+        if (recreated)
+            *recreated = true;
+        mp_verbose(log, "Created the %s pixel buffer pool: %dx%d %s.\n",
+                   p->name, w, h, cc);
+    }
+    CVPixelBufferRef buf = NULL;
+    if (CVPixelBufferPoolCreatePixelBuffer(NULL, p->pool, &buf) != kCVReturnSuccess ||
+        !buf)
+    {
+        mp_err(log, "No buffer from the %s pixel buffer pool.\n", p->name);
+        return NULL;
+    }
+    return buf;
+}
+
+void avf_pool_flush_excess(struct avf_pool *p)
+{
+    if (p->pool)
+        CVPixelBufferPoolFlush(p->pool, kCVPixelBufferPoolFlushExcessBuffers);
+}
+
+void avf_pool_release(struct avf_pool *p)
+{
+    if (p->pool) {
+        CVPixelBufferPoolFlush(p->pool, kCVPixelBufferPoolFlushExcessBuffers);
+        CVPixelBufferPoolRelease(p->pool);
+    }
+    p->pool = NULL;
+    p->w = p->h = 0;
+    p->format = 0;
+}
