+// The layers of the AVFoundation video output: the host layer Vivid passes
+// through wid, the separate subtitle layer, their renderers and timebase, and
+// the observers that follow the host's size and the app's active state.
+//
+// Every function is called on mpv's VO thread. Work that must run on the main
+// thread is done there with a synchronous hop (run inline if already on main)
+// or, where the function says so, queued asynchronously. Nothing here waits
+// for the player core, so the hops cannot deadlock with a main thread that
+// never waits on mpv.
+
+#ifndef MP_AVFOUNDATION_LAYERS_H
+#define MP_AVFOUNDATION_LAYERS_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include <CoreMedia/CoreMedia.h>
+
+struct mp_log;
+struct vo;
+struct avf_layers;
+
+// Takes a strong reference to the host layer (an AVSampleBufferDisplayLayer
+// at the given address, unvalidated).
+struct avf_layers *avf_layers_create(struct mp_log *log, void *host_layer);
+// Releases what is left; call after the teardown steps below.
+void avf_layers_destroy(struct avf_layers *l);
+
+// ---- creation (synchronous main-thread hops) -----------------------------------
+
+void avf_layers_attach_timebase(struct avf_layers *l, CMTimebaseRef tb);
+// The host layer's pixel size (2.5): bounds (or frame) times contentsScale
+// (or the main screen's scale), rounded as specified.
+void avf_layers_read_geometry(struct avf_layers *l, int *w, int *h);
+void avf_layers_create_subtitle_layer(struct avf_layers *l, CMTimebaseRef tb);
+void avf_layers_observe_app_state(struct avf_layers *l, struct vo *vo);
+void avf_layers_observe_geometry(struct avf_layers *l, struct vo *vo);
+
+// ---- events set by the observers ------------------------------------------------
+
+// Consumes the app-active resync flag.
+bool avf_layers_take_resync(struct avf_layers *l);
+// Consumes the host resize flag.
+bool avf_layers_take_resize(struct avf_layers *l);
+
+// ---- subtitle layer -----------------------------------------------------------------
+
+bool avf_layers_has_subtitle_layer(struct avf_layers *l);
+// Queues the subtitle layer's frame, scale and gravity copy on main.
+void avf_layers_copy_frame_async(struct avf_layers *l);
+// Queues a flush with removal of the subtitle layer on main.
+void avf_layers_flush_subtitles_async(struct avf_layers *l);
+// Flushes the subtitle layer's renderer on this thread.
+void avf_layers_flush_subtitles(struct avf_layers *l, bool remove_image);
+bool avf_layers_subtitles_ready(struct avf_layers *l);
+void avf_layers_enqueue_subtitles(struct avf_layers *l, CMSampleBufferRef s);
+
+// ---- host layer renderer ------------------------------------------------------------
+
+void avf_layers_flush_host(struct avf_layers *l, bool remove_image);
+bool avf_layers_host_ready(struct avf_layers *l);
+// status failed, or requiresFlushToResumeDecoding.
+bool avf_layers_host_needs_recovery(struct avf_layers *l);
+void avf_layers_enqueue_host(struct avf_layers *l, CMSampleBufferRef s);
+
+struct avf_recovery_state {
+    long status;
+    bool requires_flush;
+    bool ready;
+    double timebase_s;
+    double timebase_rate;
+};
+
+// Display layer recovery, on main: reads the host renderer's state and the
+// timebase, then flushes both renderers without removing their images.
+void avf_layers_recover(struct avf_layers *l, CMTimebaseRef tb,
+                        struct avf_recovery_state *out);
+
+// ---- teardown (in this order) ---------------------------------------------------------
+
+// Removes both kinds of observer on main; the observers can no longer reach
+// the VO afterwards.
+void avf_layers_remove_observers(struct avf_layers *l);
+// Flushes both renderers with removal of their images, on this thread.
+void avf_layers_flush_for_teardown(struct avf_layers *l);
+// Clears controlTimebase on both layers, on main.
+void avf_layers_detach_timebase(struct avf_layers *l);
+// Removes the subtitle layer from its superlayer, on main.
+void avf_layers_remove_subtitle_layer(struct avf_layers *l);
+
+#endif
diff --git a/video/out/avfoundation/layers.m b/video/out/avfoundation/layers.m
new file mode 100644
--- /dev/null
+++ b/video/out/avfoundation/layers.m
@@ -0,0 +1,451 @@
+/*
+ * This file is part of mpv.
+ *
