+ * License along with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+// Manual reference counting, like the rest of mpv's Objective-C.
+//
+// The renderer API used here (AVSampleBufferDisplayLayer.sampleBufferRenderer)
+// exists from iOS and tvOS 17. The output refuses to start below that (see
+// preinit), so none of this runs on older systems.
+#pragma clang diagnostic ignored "-Wunguarded-availability-new"
+
+#import <AVFoundation/AVFoundation.h>
+#import <Foundation/Foundation.h>
+#import <QuartzCore/QuartzCore.h>
+#import <UIKit/UIKit.h>
+
+#include <math.h>
+#include <os/lock.h>
+#include <stdlib.h>
+
+#include "common/msg.h"
+#include "video/out/vo.h"
+
+#include "geometry.h"
+#include "layers.h"
+
+// Shared between the VO and the observers. The observers' blocks and the
+// key-value observer keep it alive, so a notification that arrives after
+// teardown finds no VO and does nothing.
+@interface AVFOutputLink : NSObject {
+@public
+    os_unfair_lock lock;
+    struct vo *vo;          // NULL once detached
+    bool resync;
+    bool resize;
+    bool suspended;         // main thread only
+}
+- (void)raiseResync;
+- (void)raiseResize;
+- (void)detach;
+@end
+
+@implementation AVFOutputLink
+- (instancetype)init
+{
+    if ((self = [super init]))
+        lock = OS_UNFAIR_LOCK_INIT;
+    return self;
+}
+
+- (void)raise:(bool *)flag
+{
+    os_unfair_lock_lock(&lock);
+    if (vo) {
+        *flag = true;
+        vo_wakeup(vo);
+    }
+    os_unfair_lock_unlock(&lock);
+}
+
+- (void)raiseResync
+{
+    [self raise:&resync];
+}
+
+- (void)raiseResize
+{
+    [self raise:&resize];
+}
+
+- (void)detach
+{
+    os_unfair_lock_lock(&lock);
+    vo = NULL;
+    os_unfair_lock_unlock(&lock);
+}
+
+- (bool)take:(bool *)flag
+{
+    os_unfair_lock_lock(&lock);
+    bool v = *flag;
+    *flag = false;
+    os_unfair_lock_unlock(&lock);
+    return v;
+}
+@end
+
+static void *const kAVFGeometryContext = (void *)&kAVFGeometryContext;
+
+@interface AVFGeometryObserver : NSObject {
+    AVFOutputLink *link;
+}
+- (instancetype)initWithLink:(AVFOutputLink *)l;
+@end
+
+@implementation AVFGeometryObserver
+- (instancetype)initWithLink:(AVFOutputLink *)l
+{
+    if ((self = [super init]))
+        link = [l retain];
+    return self;
+}
+
+- (void)dealloc
+{
+    [link release];
+    [super dealloc];
+}
+
+- (void)observeValueForKeyPath:(NSString *)keyPath ofObject:(id)object
+                        change:(NSDictionary *)change context:(void *)context
+{
+    if (context != kAVFGeometryContext) {
+        [super observeValueForKeyPath:keyPath ofObject:object change:change
+                              context:context];
+        return;
+    }
+    id old = change[NSKeyValueChangeOldKey];
+    id new = change[NSKeyValueChangeNewKey];
+    // Writing an identical value is not a change; a missing value counts as
+    // one.
+    if (old && new && old != [NSNull null] && new != [NSNull null] &&
+        [old isEqual:new])
+        return;
+    [link raiseResize];
+}
+@end
+
+struct avf_layers {
+    struct mp_log *log;
+    AVSampleBufferDisplayLayer *host;   // retained
+    AVSampleBufferDisplayLayer *sub;    // retained
+    bool nested;                        // subtitle layer inside the host
+    AVFOutputLink *link;
+    id resign_token;
+    id active_token;
+    AVFGeometryObserver *geometry;
+    bool observing_geometry;
+};
+
+static void run_on_main(void (^block)(void))
+{
+    if ([NSThread isMainThread]) {
+        block();
+    } else {
+        dispatch_sync(dispatch_get_main_queue(), block);
+    }
+}
+
+static CGFloat main_screen_scale(void)
+{
+    return [UIScreen mainScreen].scale;
+}
+
+struct avf_layers *avf_layers_create(struct mp_log *log, void *host_layer)
+{
+    struct avf_layers *l = calloc(1, sizeof(*l));
+    if (!l)
+        return NULL;
+    l->log = log;
+    l->host = [(AVSampleBufferDisplayLayer *)host_layer retain];
+    l->link = [[AVFOutputLink alloc] init];
+    return l;
+}
+
+void avf_layers_destroy(struct avf_layers *l)
+{
+    if (!l)
+        return;
+    [l->link detach];
+    [l->resign_token release];
+    [l->active_token release];
+    [l->geometry release];
+    [l->link release];
+    [l->sub release];
+    [l->host release];
+    free(l);
+}
+
+void avf_layers_attach_timebase(struct avf_layers *l, CMTimebaseRef tb)
+{
+    run_on_main(^{
+        l->host.controlTimebase = tb;
+    });
+}
+
+void avf_layers_read_geometry(struct avf_layers *l, int *w, int *h)
+{
+    __block CGSize size = CGSizeZero;
+    __block double scale = 1;
+    run_on_main(^{
+        AVSampleBufferDisplayLayer *host = l->host;
+        size = host.bounds.size;
+        if (size.width <= 0 || size.height <= 0)
+            size = host.frame.size;
+        scale = avf_layer_scale(host.contentsScale, main_screen_scale());
+    });
+    *w = avf_pixel_extent(size.width, scale);
+    *h = avf_pixel_extent(size.height, scale);
+}
+
+void avf_layers_create_subtitle_layer(struct avf_layers *l, CMTimebaseRef tb)
+{
+    __block bool nested = false;
+    run_on_main(^{
+        AVSampleBufferDisplayLayer *host = l->host;
+        AVSampleBufferDisplayLayer *sub = [[AVSampleBufferDisplayLayer alloc] init];
+        sub.backgroundColor = NULL;
+        sub.opaque = NO;
+        sub.videoGravity = AVLayerVideoGravityResize;
+        sub.anchorPoint = CGPointMake(0.5, 0.5);
+        sub.controlTimebase = tb;
+        CGFloat scale = host.contentsScale;
+        sub.contentsScale = scale > 0 ? scale : main_screen_scale();
+        sub.frame = host.frame;
+        CALayer *parent = host.superlayer;
+        if (parent) {
+            [parent addSublayer:sub];
+            sub.zPosition = host.zPosition + 1;
+        } else {
+            [host addSublayer:sub];
+            sub.frame = host.bounds;
+            nested = true;
+        }
+        l->sub = sub;
+        l->nested = nested;
+    });
+    if (nested) {
+        mp_warn(l->log, "The video layer has no superlayer; subtitles are drawn "
+                "inside it, so the system cannot present the video directly.\n");
+    }
+}
+
+void avf_layers_observe_app_state(struct avf_layers *l, struct vo *vo)
+{
+    AVFOutputLink *link = l->link;
+    os_unfair_lock_lock(&link->lock);
+    link->vo = vo;
+    os_unfair_lock_unlock(&link->lock);
+    run_on_main(^{
+        NSNotificationCenter *nc = [NSNotificationCenter defaultCenter];
+        NSOperationQueue *queue = [NSOperationQueue mainQueue];
+        l->resign_token = [[nc addObserverForName:UIApplicationWillResignActiveNotification
+                                           object:nil
+                                            queue:queue
+                                       usingBlock:^(NSNotification *note) {
+            link->suspended = true;
+        }] retain];
+        l->active_token = [[nc addObserverForName:UIApplicationDidBecomeActiveNotification
+                                           object:nil
+                                            queue:queue
+                                       usingBlock:^(NSNotification *note) {
+            if (link->suspended) {
+                link->suspended = false;
+                [link raiseResync];
+            }
+        }] retain];
+    });
+}
+
+void avf_layers_observe_geometry(struct avf_layers *l, struct vo *vo)
+{
+    AVFOutputLink *link = l->link;
+    os_unfair_lock_lock(&link->lock);
+    link->vo = vo;
+    os_unfair_lock_unlock(&link->lock);
+    l->geometry = [[AVFGeometryObserver alloc] initWithLink:link];
+    run_on_main(^{
+        NSKeyValueObservingOptions opts = NSKeyValueObservingOptionOld |
+                                          NSKeyValueObservingOptionNew;
+        [l->host addObserver:l->geometry forKeyPath:@"bounds" options:opts
+                     context:kAVFGeometryContext];
+        [l->host addObserver:l->geometry forKeyPath:@"contentsScale" options:opts
+                     context:kAVFGeometryContext];
+        l->observing_geometry = true;
+    });
+}
+
+bool avf_layers_take_resync(struct avf_layers *l)
+{
+    return [l->link take:&l->link->resync];
+}
+
+bool avf_layers_take_resize(struct avf_layers *l)
+{
+    return [l->link take:&l->link->resize];
+}
+
+bool avf_layers_has_subtitle_layer(struct avf_layers *l)
+{
+    return !!l->sub;
+}
+
+void avf_layers_copy_frame_async(struct avf_layers *l)
+{
+    AVSampleBufferDisplayLayer *host = l->host, *sub = l->sub;
+    bool nested = l->nested;
+    if (!sub)
+        return;
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [CATransaction begin];
+        [CATransaction setDisableActions:YES];
+        if (nested) {
+            sub.frame = host.bounds;
+        } else {
+            sub.frame = host.frame;
+            sub.zPosition = host.zPosition + 1;
+        }
+        CGFloat scale = host.contentsScale;
+        sub.contentsScale = scale > 0 ? scale : main_screen_scale();
+        sub.videoGravity = AVLayerVideoGravityResize;
+        [CATransaction commit];
+    });
+}
+
+void avf_layers_flush_subtitles_async(struct avf_layers *l)
+{
+    AVSampleBufferDisplayLayer *sub = l->sub;
+    if (!sub)
+        return;
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [sub.sampleBufferRenderer flushWithRemovalOfDisplayedImage:YES
+                                                 completionHandler:nil];
+    });
+}
+
+void avf_layers_flush_subtitles(struct avf_layers *l, bool remove_image)
+{
+    if (!l->sub)
+        return;
+    AVSampleBufferVideoRenderer *r = l->sub.sampleBufferRenderer;
+    if (remove_image) {
+        [r flushWithRemovalOfDisplayedImage:YES completionHandler:nil];
+    } else {
+        [r flush];
+    }
+}
+
+bool avf_layers_subtitles_ready(struct avf_layers *l)
+{
+    return l->sub && l->sub.sampleBufferRenderer.isReadyForMoreMediaData;
+}
+
+void avf_layers_enqueue_subtitles(struct avf_layers *l, CMSampleBufferRef s)
+{
+    [l->sub.sampleBufferRenderer enqueueSampleBuffer:s];
+}
+
+void avf_layers_flush_host(struct avf_layers *l, bool remove_image)
+{
+    AVSampleBufferVideoRenderer *r = l->host.sampleBufferRenderer;
+    if (remove_image) {
+        [r flushWithRemovalOfDisplayedImage:YES completionHandler:nil];
+    } else {
+        [r flush];
+    }
+}
+
+bool avf_layers_host_ready(struct avf_layers *l)
+{
+    return l->host.sampleBufferRenderer.isReadyForMoreMediaData;
+}
+
+bool avf_layers_host_needs_recovery(struct avf_layers *l)
+{
+    AVSampleBufferVideoRenderer *r = l->host.sampleBufferRenderer;
+    return r.status == AVQueuedSampleBufferRenderingStatusFailed ||
+           r.requiresFlushToResumeDecoding;
+}
+
+void avf_layers_enqueue_host(struct avf_layers *l, CMSampleBufferRef s)
+{
+    [l->host.sampleBufferRenderer enqueueSampleBuffer:s];
+}
+
+void avf_layers_recover(struct avf_layers *l, CMTimebaseRef tb,
+                        struct avf_recovery_state *out)
+{
+    __block struct avf_recovery_state st = {0};
+    run_on_main(^{
+        AVSampleBufferVideoRenderer *r = l->host.sampleBufferRenderer;
+        st.status = (long)r.status;
+        st.requires_flush = r.requiresFlushToResumeDecoding;
+        st.ready = r.isReadyForMoreMediaData;
+        CMTime t = CMTimebaseGetTime(tb);
+        st.timebase_s = CMTIME_IS_NUMERIC(t) ? CMTimeGetSeconds(t) : NAN;
+        st.timebase_rate = CMTimebaseGetRate(tb);
+        [r flush];
+        if (l->sub)
+            [l->sub.sampleBufferRenderer flush];
+    });
+    *out = st;
+}
+
+void avf_layers_remove_observers(struct avf_layers *l)
+{
+    run_on_main(^{
+        NSNotificationCenter *nc = [NSNotificationCenter defaultCenter];
+        if (l->resign_token)
+            [nc removeObserver:l->resign_token];
+        if (l->active_token)
+            [nc removeObserver:l->active_token];
+        if (l->observing_geometry) {
+            [l->host removeObserver:l->geometry forKeyPath:@"bounds"
+                            context:kAVFGeometryContext];
+            [l->host removeObserver:l->geometry forKeyPath:@"contentsScale"
+                            context:kAVFGeometryContext];
+            l->observing_geometry = false;
+        }
+    });
+    [l->link detach];
+}
+
+void avf_layers_flush_for_teardown(struct avf_layers *l)
+{
+    avf_layers_flush_host(l, true);
+    avf_layers_flush_subtitles(l, true);
+}
+
+void avf_layers_detach_timebase(struct avf_layers *l)
+{
+    run_on_main(^{
+        l->host.controlTimebase = NULL;
+        if (l->sub)
+            l->sub.controlTimebase = NULL;
+    });
+}
+
+void avf_layers_remove_subtitle_layer(struct avf_layers *l)
+{
+    if (!l->sub)
+        return;
+    run_on_main(^{
+        [l->sub removeFromSuperlayer];
+    });
+}
