+++ b/audio/out/ao_avfoundation_startup.h
@@ -0,0 +1,111 @@
+/*
+ * AVFoundation audio output: start-up supervision and clock anchoring for
+ * compressed passthrough (the AirPlay start-up handling).
+ *
+ * Copyright (C) 2026 blurbery
+ *
+ * This file is part of mpv.
+ *
