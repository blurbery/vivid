+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#ifndef MP_AO_AVFOUNDATION_STARTUP_H
+#define MP_AO_AVFOUNDATION_STARTUP_H
+
+#include "ao_avfoundation_core.h"
+
+#define AVFAO_PRIMED_NS AVFAO_NS_PER_S
+#define AVFAO_ANCHOR_PACING_NS (100 * AVFAO_NS_PER_MS)
+#define AVFAO_ANCHOR_START_EXTRA_NS (4 * AVFAO_NS_PER_S)
+#define AVFAO_ANCHOR_RESUME_NS (2 * AVFAO_NS_PER_S)
+
+struct avfao_startup_cfg {
+    int64_t grace_ns;          // compressed-start-grace
+    int64_t initial_grace_ns;  // min(compressed-first-start-grace, grace)
+    int64_t lead_ns;           // compressed-lead (start-up lead is twice it)
+    bool anchor_start;
+    bool anchor_resume;
+};
+
+struct avfao_startup {
+    // For the AO's lifetime.
+    bool initial_mode;          // until the AO's first engagement
+    int64_t anchor_pacing_ns;   // last anchor read, or mpv's clock origin
+    int anchors;
+
+    // For the current item.
+    bool rate_requested;
+    int64_t rate1_ns;
+    bool seek_attempted;
+    int64_t watermark_ns;
+    bool deadline_set;
+    bool deadline_cleared;      // engaged: cleared for good
+    int64_t deadline_ns;
+    bool resume_pending;
+    int64_t resume_clock_ns;
+    int64_t resume_ns;
+};
+
+// The only player calls supervision makes, plus the compressed clock.
+struct avfao_startup_ops {
+    void (*request_rate)(void *ctx);
+    void (*seek_to_start)(void *ctx);
+    void (*fallback)(void *ctx);
+    int64_t (*clock)(void *ctx);
+};
+
+struct avfao_startup_view {
+    int64_t now_ns;
+    int64_t fed_ns;
+    int64_t clock_ns;          // compressed clock
+    bool eof;
+    bool item_ready;           // AVPlayerItemStatusReadyToPlay
+};
+
+void avfao_startup_init(struct avfao_startup *st);
+// Item created or torn down.
+void avfao_startup_new_item(struct avfao_startup *st);
+void avfao_startup_cfg_init(struct avfao_startup_cfg *cfg, double lead,
+                            double grace, double first_grace,
+                            bool anchor_start, bool anchor_resume);
+
+// One supervision evaluation (3.4.10's table, first matching row wins).
+void avfao_supervise(struct avfao_startup *st, const struct avfao_startup_cfg *cfg,
+                     const struct avfao_startup_view *view,
+                     const struct avfao_host *host,
+                     const struct avfao_startup_ops *ops, void *ctx);
+
+// Pause and unpause. When rate 1 was already requested for the item, an
+// unpause requests it again and then records the clock it reads.
+void avfao_startup_pause(struct avfao_startup *st);
+void avfao_startup_unpause(struct avfao_startup *st, const struct avfao_startup_cfg *cfg,
+                           int64_t now_ns, const struct avfao_startup_ops *ops,
+                           void *ctx);
+
+// Whether a start or resume anchor read is due. fallback and room (the
+// window can take a whole carry-over buffer) come from the sink.
+bool avfao_start_anchor_due(const struct avfao_startup *st,
+                            const struct avfao_startup_cfg *cfg,
+                            const struct avfao_startup_view *view,
+                            bool fallback, bool room);
+bool avfao_resume_anchor_due(const struct avfao_startup *st,
+                             const struct avfao_startup_cfg *cfg,
+                             const struct avfao_startup_view *view,
+                             bool fallback, bool room);
+// Ends a pending resume once the clock has moved past its recorded value.
+void avfao_resume_detect(struct avfao_startup *st,
+                         const struct avfao_startup_view *view,
+                         const struct avfao_host *host);
+
+#endif
