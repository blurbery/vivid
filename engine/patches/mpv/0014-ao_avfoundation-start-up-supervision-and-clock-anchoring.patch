--- /dev/null
+++ b/audio/out/ao_avfoundation_startup.c
@@ -0,0 +1,199 @@
+/*
+ * AVFoundation audio output: start-up supervision and clock anchoring for
+ * compressed passthrough (the AirPlay start-up handling).
+ *
+ * Copyright (C) 2026 blurbery
+ *
+ * This file is part of mpv.
+ *
+ * mpv is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * mpv is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "ao_avfoundation_startup.h"
+
+void avfao_startup_init(struct avfao_startup *st)
+{
+    *st = (struct avfao_startup){
+        .initial_mode = true,
+        // mpv's clock origin, not a minimum-value sentinel.
+        .anchor_pacing_ns = 0,
+        .anchors = 0,
+    };
+}
+
+void avfao_startup_new_item(struct avfao_startup *st)
+{
+    st->rate_requested = false;
+    st->rate1_ns = 0;
+    st->seek_attempted = false;
+    st->watermark_ns = 0;
+    st->deadline_set = false;
+    st->deadline_cleared = false;
+    st->deadline_ns = 0;
+    st->resume_pending = false;
+    st->resume_clock_ns = 0;
+    st->resume_ns = 0;
+}
+
+void avfao_startup_cfg_init(struct avfao_startup_cfg *cfg, double lead,
+                            double grace, double first_grace,
+                            bool anchor_start, bool anchor_resume)
+{
+    int64_t grace_ns = avfao_seconds_to_ns(grace);
+    int64_t first_ns = avfao_seconds_to_ns(first_grace);
+    *cfg = (struct avfao_startup_cfg){
+        .grace_ns = grace_ns,
+        .initial_grace_ns = first_ns < grace_ns ? first_ns : grace_ns,
+        .lead_ns = avfao_seconds_to_ns(lead),
+        .anchor_start = anchor_start,
+        .anchor_resume = anchor_resume,
+    };
+}
+
+static void set_deadline(struct avfao_startup *st, int64_t when)
+{
+    st->deadline_set = true;
+    st->deadline_ns = when;
+}
+
+void avfao_supervise(struct avfao_startup *st, const struct avfao_startup_cfg *cfg,
+                     const struct avfao_startup_view *view,
+                     const struct avfao_host *host,
+                     const struct avfao_startup_ops *ops, void *ctx)
+{
+    int64_t now = view->now_ns;
+
+    if (!st->rate_requested) {
+        bool primed = view->fed_ns >= AVFAO_PRIMED_NS || view->eof;
+        if (!primed) {
+            set_deadline(st, now + cfg->grace_ns);
+            return;
+        }
+        // Rate 1 goes in without waiting for the item to report ready.
+        ops->request_rate(ctx);
+        st->rate_requested = true;
+        st->rate1_ns = now;
+        st->anchor_pacing_ns = 0;
+        st->anchors = 0;
+        set_deadline(st, now + (st->initial_mode ? cfg->initial_grace_ns
+                                                 : cfg->grace_ns));
+        return;
+    }
+
+    if (st->deadline_cleared)
+        return;
+
+    if (view->clock_ns > 0) {
+        st->deadline_cleared = true;
+        st->deadline_set = false;
+        st->initial_mode = false;
+        avfao_log(host, AVFAO_V, "compressed clock engaged after %.3f s, seeked %d, "
+                  "anchors %d\n", avfao_ns_to_seconds(now - st->rate1_ns),
+                  st->seek_attempted ? 1 : 0, st->anchors);
+        return;
+    }
+
+    // A slow source keeps extending the deadline after the seek, as long as
+    // the stream keeps growing towards the start-up lead.
+    if (st->seek_attempted && view->fed_ns > st->watermark_ns &&
+        view->fed_ns < 2 * cfg->lead_ns)
+    {
+        st->watermark_ns = view->fed_ns;
+        set_deadline(st, now + cfg->grace_ns);
+        return;
+    }
+
+    if (st->deadline_set && now < st->deadline_ns)
+        return;
+
+    // Before a title's first engagement, give an item that is not ready yet
+    // up to the ordinary grace.
+    if (!st->seek_attempted && st->initial_mode && !view->item_ready &&
+        now - st->rate1_ns < cfg->grace_ns)
+        return;
+
+    if (!st->seek_attempted) {
+        if (st->initial_mode) {
+            avfao_log(host, AVFAO_V, "first start recovery after %.3f s\n",
+                      avfao_ns_to_seconds(now - st->rate1_ns));
+        }
+        avfao_log(host, AVFAO_WARN,
+                  "playback did not engage; seeking to the stream start\n");
+        st->seek_attempted = true;
+        set_deadline(st, now + cfg->grace_ns);
+        ops->seek_to_start(ctx);
+        ops->request_rate(ctx);
+        return;
+    }
+
+    avfao_log(host, AVFAO_ERR,
+              "native compressed playback did not start; falling back to PCM\n");
+    ops->fallback(ctx);
+}
+
+void avfao_startup_pause(struct avfao_startup *st)
+{
+    st->resume_pending = false;
+}
+
+void avfao_startup_unpause(struct avfao_startup *st, const struct avfao_startup_cfg *cfg,
+                           int64_t now_ns, const struct avfao_startup_ops *ops,
+                           void *ctx)
+{
+    if (!st->rate_requested)
+        return;
+    ops->request_rate(ctx);
+    if (!st->deadline_cleared)
+        set_deadline(st, now_ns + cfg->grace_ns);
+    st->resume_pending = true;
+    st->resume_clock_ns = ops->clock(ctx);
+    st->resume_ns = now_ns;
+    st->anchor_pacing_ns = 0;
+    st->anchors = 0;
+}
+
+bool avfao_start_anchor_due(const struct avfao_startup *st,
+                            const struct avfao_startup_cfg *cfg,
+                            const struct avfao_startup_view *view,
+                            bool fallback, bool room)
+{
+    return cfg->anchor_start && st->rate_requested && !view->eof &&
+           view->clock_ns == 0 &&
+           view->fed_ns < 2 * cfg->lead_ns + AVFAO_ANCHOR_START_EXTRA_NS &&
+           view->now_ns - st->anchor_pacing_ns >= AVFAO_ANCHOR_PACING_NS &&
+           !fallback && room;
+}
+
+bool avfao_resume_anchor_due(const struct avfao_startup *st,
+                             const struct avfao_startup_cfg *cfg,
+                             const struct avfao_startup_view *view,
+                             bool fallback, bool room)
+{
+    return st->resume_pending && cfg->anchor_resume && !view->eof &&
+           view->clock_ns <= st->resume_clock_ns &&
+           view->now_ns - st->resume_ns < AVFAO_ANCHOR_RESUME_NS &&
+           view->now_ns - st->anchor_pacing_ns >= AVFAO_ANCHOR_PACING_NS &&
+           !fallback && room;
+}
+
+void avfao_resume_detect(struct avfao_startup *st,
+                         const struct avfao_startup_view *view,
+                         const struct avfao_host *host)
+{
+    if (!st->resume_pending || view->clock_ns <= st->resume_clock_ns)
+        return;
+    avfao_log(host, AVFAO_V, "compressed clock resumed after %.3f s, anchors %d\n",
+              avfao_ns_to_seconds(view->now_ns - st->resume_ns), st->anchors);
+    st->resume_pending = false;
+}
