---
diff --git a/filters/f_output_chain.c b/filters/f_output_chain.c
index 0000000000..0000000000 100644
--- a/filters/f_output_chain.c
+++ b/filters/f_output_chain.c
@@ -339,6 +339,10 @@
         p->ao = NULL;
         mp_autoconvert_clear(p->convert);
     }
+
+    // A request from downstream may still be pending; without a wakeup the
+    // reset chain could sit idle until something unrelated wakes it.
+    mp_filter_wakeup(p->f);
 }
 
 static void output_chain_destroy(struct mp_filter *f)
