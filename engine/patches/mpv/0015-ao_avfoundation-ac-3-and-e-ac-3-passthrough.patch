+ * License along with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "ao_avfoundation_iec61937.h"
+
+bool avfao_window_alloc(struct avfao_window *w, int64_t capacity)
+{
+    *w = (struct avfao_window){0};
+    w->data = malloc((size_t)capacity);
+    if (!w->data)
+        return false;
+    w->capacity = capacity;
+    return true;
+}
+
+void avfao_window_free(struct avfao_window *w)
+{
+    free(w->data);
+    *w = (struct avfao_window){0};
+}
+
+void avfao_window_clear(struct avfao_window *w)
+{
+    w->storage_offset = 0;
+    w->base = 0;
+    w->head = 0;
+}
+
+int64_t avfao_window_space(const struct avfao_window *w)
+{
+    return w->capacity - (w->head - w->base);
+}
+
+const uint8_t *avfao_window_bytes(const struct avfao_window *w, int64_t offset)
+{
+    return w->data + (offset - w->storage_offset);
+}
+
+void avfao_window_trim(struct avfao_window *w, int64_t low_water)
+{
+    int64_t keep_from = low_water - AVFAO_WINDOW_HISTORY;
+    if (keep_from > w->head)
+        keep_from = w->head;
+    if (keep_from > w->base)
+        w->base = keep_from;
+}
+
+int64_t avfao_window_capacity(double lead_seconds)
+{
+    return (int64_t)((double)(AVFAO_WINDOW_HISTORY + AVFAO_WINDOW_SLACK) +
+                     2.0 * lead_seconds * AVFAO_WINDOW_BYTES_PER_SECOND);
+}
+
+// Room for len bytes at the write head. Retained bytes move to the front of
+// the storage only when the tail has run out, so trimming costs nothing.
+static uint8_t *window_tail(struct avfao_window *w, int64_t len)
+{
+    if (w->head - w->storage_offset + len > w->capacity) {
+        memmove(w->data, w->data + (w->base - w->storage_offset),
+                (size_t)(w->head - w->base));
+        w->storage_offset = w->base;
+    }
+    return w->data + (w->head - w->storage_offset);
+}
+
+enum avfao_serve avfao_serve_request(const struct avfao_host *host,
+                                     const struct avfao_window *w,
+                                     int64_t offset, int64_t end, int64_t *len)
+{
+    *len = 0;
+    if (end >= 0 && offset >= end)
+        return AVFAO_SERVE_FINISH;
+    if (offset < w->base) {
+        avfao_log(host, AVFAO_ERR,
+                  "loader requested offset %lld below the retained window at %lld\n",
+                  (long long)offset, (long long)w->base);
+        return AVFAO_SERVE_BELOW;
+    }
+    if (offset < w->head) {
+        int64_t stop = w->head;
+        if (end >= 0 && end < stop)
+            stop = end;
+        *len = stop - offset;
+        avfao_log(host, AVFAO_TRACE, "serving %lld bytes from %lld\n",
+                  (long long)*len, (long long)offset);
+        return AVFAO_SERVE_DATA;
+    }
+    if (offset == w->head)
+        return AVFAO_SERVE_WAIT;
+    // Never answer with data: AVFoundation would later play whatever bytes
+    // it was given for these offsets.
+    avfao_log(host, AVFAO_V, "refusing a loader request at %lld beyond the "
+              "write head at %lld\n", (long long)offset, (long long)w->head);
+    return AVFAO_SERVE_BEYOND;
+}
+
+bool avfao_iec_alloc(struct avfao_iec *iec, enum avfao_codec codec,
+                     int carrier_rate)
+{
+    bool eac3 = codec == AVFAO_CODEC_EAC3;
+    int codec_rate = eac3 ? carrier_rate / 4 : carrier_rate;
+    *iec = (struct avfao_iec){
+        .data_type = eac3 ? 0x15 : 0x01,
+        .burst_bytes = eac3 ? 24576 : 6144,
+        .pd_in_bits = !eac3,
+        .burst_ns = avfao_frames_to_ns(AVFAO_IEC_FRAMES_PER_BURST, codec_rate),
+    };
+    // 100 ms of carrier bytes plus four bursts.
+    iec->carry_size = (int64_t)(carrier_rate / 10) * AVFAO_CARRIER_FRAME_BYTES +
+                      4 * (int64_t)iec->burst_bytes;
+    iec->carry = malloc((size_t)iec->carry_size);
+    return iec->carry != NULL;
+}
+
+void avfao_iec_free(struct avfao_iec *iec)
+{
+    free(iec->carry);
+    iec->carry = NULL;
+    iec->carry_len = 0;
+}
+
+// One payload, in the order that decides which single outcome it gets.
+// Returns false when it must fall back to PCM.
+static bool take_payload(struct avfao_iec *iec, struct avfao_window *w,
+                         const struct avfao_host *host, const uint8_t *src,
+                         int64_t len, int64_t *fed_ns, int64_t *dropped_ns)
+{
+    if (len & 1) {
+        avfao_log(host, AVFAO_WARN, "discarding burst with odd payload length\n");
+        *dropped_ns += iec->burst_ns;
+        return true;
+    }
+    if (len > avfao_window_space(w)) {
+        avfao_log(host, AVFAO_ERR,
+                  "elementary stream window overflow; falling back to PCM\n");
+        return false;
+    }
+    // The muxer writes little-endian 16-bit words; AVFoundation wants the
+    // bitstream's own byte order.
+    uint8_t *dst = window_tail(w, len);
+    for (int64_t n = 0; n < len; n += 2) {
+        dst[n] = src[n + 1];
+        dst[n + 1] = src[n];
+    }
+    if (dst[0] != 0x0B || dst[1] != 0x77) {
+        avfao_log(host, AVFAO_WARN, "discarding burst without syncframe\n");
+        *dropped_ns += iec->burst_ns;
+        return true;
+    }
+    w->head += len;
+    *fed_ns += iec->burst_ns;
+    return true;
+}
+
+bool avfao_iec_unwrap(struct avfao_iec *iec, struct avfao_window *w,
+                      const struct avfao_host *host,
+                      int64_t *fed_ns, int64_t *dropped_ns)
+{
+    uint8_t *buf = iec->carry;
+    int64_t len = iec->carry_len;
+    int64_t pos = 0;
+
+    // Only positions with a whole preamble after them are examined; the
+    // last 7 bytes wait for the next read.
+    while (len - pos >= AVFAO_IEC_HEADER) {
+        const uint8_t *h = buf + pos;
+        if (h[0] != 0x72 || h[1] != 0xF8 || h[2] != 0x1F || h[3] != 0x4E) {
+            pos += 1;
+            continue;
+        }
+        int type = h[4] & 0x7F;
+        if (type != iec->data_type) {
+            avfao_log(host, AVFAO_WARN,
+                      "skipping unexpected IEC 61937 data type 0x%x\n", type);
+            pos += 1;
+            continue;
+        }
+        int pd = h[6] | (h[7] << 8);
+        int payload = iec->pd_in_bits ? pd / 8 : pd;
+        if (payload < AVFAO_IEC_HEADER || payload > iec->burst_bytes - AVFAO_IEC_HEADER) {
+            avfao_log(host, AVFAO_WARN,
+                      "skipping burst with invalid payload length %d\n", payload);
+            pos += 1;
+            continue;
+        }
+        int64_t padded = ((int64_t)payload + 1) & ~(int64_t)1;
+        if (pos + AVFAO_IEC_HEADER + padded > len)
+            break; // incomplete: keep it, from its preamble on
+        if (!take_payload(iec, w, host, h + AVFAO_IEC_HEADER, payload,
+                          fed_ns, dropped_ns))
+        {
+            iec->carry_len = 0;
+            return false;
+        }
+        pos += AVFAO_IEC_HEADER + padded;
+    }
+
+    memmove(buf, buf + pos, (size_t)(len - pos));
+    iec->carry_len = len - pos;
+
+    // With the rules above the buffer never holds this much here; the check
+    // stays as a last resort.
+    if (iec->carry_len > 3 * (int64_t)iec->burst_bytes) {
+        avfao_log(host, AVFAO_ERR,
+                  "no IEC 61937 sync found in %d bytes; falling back to PCM\n",
+                  (int)iec->carry_len);
+        iec->carry_len = 0;
+        return false;
+    }
+    return true;
+}
