+ * License along with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "ao_avfoundation_compressed.h"
+
+static void startup_request_rate(void *ctx)
+{
+    struct avfao_cx *cx = ctx;
+    cx->ops->set_rate(cx->ctx, 1);
+}
+
+static void startup_seek_to_start(void *ctx)
+{
+    struct avfao_cx *cx = ctx;
+    cx->ops->seek_to_start(cx->ctx);
+}
+
+static void startup_fallback(void *ctx)
+{
+    avfao_cx_fallback(ctx);
+}
+
+static int64_t startup_clock(void *ctx)
+{
+    return avfao_cx_clock(ctx);
+}
+
+static const struct avfao_startup_ops startup_ops = {
+    .request_rate = startup_request_rate,
+    .seek_to_start = startup_seek_to_start,
+    .fallback = startup_fallback,
+    .clock = startup_clock,
+};
+
+static int64_t clamp_fed(const struct avfao_cx *cx, int64_t t)
+{
+    if (t < 0)
+        return 0;
+    return t > cx->fed_ns ? cx->fed_ns : t;
+}
+
+int64_t avfao_cx_clock(const struct avfao_cx *cx)
+{
+    if (!cx->item)
+        return 0;
+    int64_t t;
+    if (!cx->ops->timebase_time(cx->ctx, &t) && !cx->ops->current_time(cx->ctx, &t))
+        t = 0;
+    return clamp_fed(cx, t);
+}
+
+int64_t avfao_cx_feed_position(const struct avfao_cx *cx)
+{
+    int64_t position = avfao_cx_clock(cx);
+    int64_t current;
+    // Pacing against the later reading keeps enough queued on HDMI routes
+    // whose timebase lags the item's currentTime.
+    if (cx->item && cx->ops->current_time(cx->ctx, &current) && current > position)
+        position = current;
+    return clamp_fed(cx, position);
+}
+
+static void reset_item_state(struct avfao_cx *cx)
+{
+    cx->iec.carry_len = 0;
+    avfao_window_clear(&cx->win);
+    cx->fed_ns = 0;
+    cx->consumed_frames = 0;
+    cx->dropped_ns = 0;
+    cx->eof = false;
+    avfao_startup_new_item(&cx->st);
+}
+
+bool avfao_cx_init(struct avfao_cx *cx, const struct avfao_host *host,
+                   const struct avfao_cx_ops *ops, void *ctx,
+                   struct avfao_trace *trace, enum avfao_codec codec,
+                   int carrier_rate, const struct avfao_cx_cfg *cfg)
+{
+    *cx = (struct avfao_cx){
+        .host = host,
+        .ops = ops,
+        .ctx = ctx,
+        .trace = trace,
+        .codec = codec,
+        .carrier_rate = carrier_rate,
+        .read_frames = carrier_rate / 10,
+        .last_status = -1,
+        .last_time_control = -1,
+    };
+    avfao_startup_cfg_init(&cx->cfg, cfg->lead, cfg->grace, cfg->first_grace,
+                           cfg->anchor_start, cfg->anchor_resume);
+    avfao_startup_init(&cx->st);
+    if (!avfao_iec_alloc(&cx->iec, codec, carrier_rate) ||
+        !avfao_window_alloc(&cx->win, avfao_window_capacity(cfg->lead)))
+    {
+        avfao_log(host, AVFAO_FATAL, "failed to allocate the passthrough buffers\n");
+        avfao_cx_uninit(cx);
+        return false;
+    }
+    return true;
+}
+
+void avfao_cx_uninit(struct avfao_cx *cx)
+{
+    avfao_iec_free(&cx->iec);
+    avfao_window_free(&cx->win);
+}
+
+void avfao_cx_fallback(struct avfao_cx *cx)
+{
+    if (cx->fallback)
+        return;
+    cx->fallback = true;
+    avfao_block_set(cx->codec);
+    cx->ops->set_rate(cx->ctx, 0);
+    cx->ops->timer(cx->ctx, false);
+    cx->host->ops->request_reload(cx->host->ctx);
+}
+
+static bool window_has_room(const struct avfao_cx *cx)
+{
+    return avfao_window_space(&cx->win) >= cx->iec.carry_size;
+}
+
+// One read from mpv into the carry-over buffer, then unwrapping. Returns
+// whether it was successful: frames came back, no end of file, no fallback.
+static bool read_once(struct avfao_cx *cx)
+{
+    const struct avfao_host *host = cx->host;
+    int64_t frames = (cx->iec.carry_size - cx->iec.carry_len) / AVFAO_CARRIER_FRAME_BYTES;
+    if (frames > cx->read_frames)
+        frames = cx->read_frames;
+    if (frames <= 0)
+        return false;
+
+    int64_t reserve = cx->fed_ns - avfao_cx_feed_position(cx);
+    if (avfao_prefetch_skip(reserve, host->ops->queued_frames(host->ctx), frames))
+        return false;
+
+    // mpv takes this end time as its audio clock. It is built from the
+    // carrier frames consumed, never from the fed duration, which moves in
+    // whole burst periods.
+    int64_t clock = avfao_cx_clock(cx);
+    int64_t now = avfao_now(host);
+    int64_t written = avfao_frames_to_ns(cx->consumed_frames, cx->carrier_rate) -
+                      cx->dropped_ns;
+    int64_t end = now + (written - clock) +
+                  avfao_frames_to_ns(frames, cx->carrier_rate);
+
+    bool eof = false;
+    int got = host->ops->read(host->ctx, cx->iec.carry + cx->iec.carry_len,
+                              (int)frames, end, &eof);
+    if (got > 0) {
+        cx->consumed_frames += got;
+        cx->iec.carry_len += (int64_t)got * AVFAO_CARRIER_FRAME_BYTES;
+    }
+    if (eof) {
+        cx->eof = true;
+        host->ops->stop_streaming(host->ctx);
+    }
+    if (got > 0 && !avfao_iec_unwrap(&cx->iec, &cx->win, host, &cx->fed_ns,
+                                     &cx->dropped_ns))
+        avfao_cx_fallback(cx);
+    return got > 0 && !eof && !cx->fallback;
+}
+
+static void anchor_read(struct avfao_cx *cx)
+{
+    cx->st.anchor_pacing_ns = avfao_now(cx->host);
+    if (read_once(cx))
+        cx->st.anchors++;
+}
+
+static struct avfao_startup_view view(const struct avfao_cx *cx, bool with_status)
+{
+    return (struct avfao_startup_view){
+        .now_ns = avfao_now(cx->host),
+        .fed_ns = cx->fed_ns,
+        .clock_ns = avfao_cx_clock(cx),
+        .eof = cx->eof,
+        .item_ready = with_status &&
+                      cx->ops->item_status(cx->ctx) == AVFAO_ITEM_READY,
+    };
+}
+
+static void diagnostics(struct avfao_cx *cx)
+{
+    const struct avfao_cx_ops *ops = cx->ops;
+    int status = ops->item_status(cx->ctx);
+    int time_control = ops->time_control(cx->ctx);
+    int64_t clock = avfao_cx_clock(cx);
+
+    if (status != cx->last_status || time_control != cx->last_time_control) {
+        avfao_log(cx->host, AVFAO_V, "item status %d -> %d, time control %d -> %d, "
+                  "pos %.3fs, fed %.3fs\n", cx->last_status, status,
+                  cx->last_time_control, time_control, avfao_ns_to_seconds(clock),
+                  avfao_ns_to_seconds(cx->fed_ns));
+        cx->last_status = status;
+        cx->last_time_control = time_control;
+    }
+
+    bool detail = avfao_in_detail_window(cx->host, cx->trace);
+    if (cx->heartbeat % AVFAO_HEARTBEAT_EVERY == 0 ||
+        (detail && cx->heartbeat % AVFAO_HEARTBEAT_DETAIL_EVERY == 0))
+    {
+        int64_t raw_ns;
+        double raw = ops->current_time(cx->ctx, &raw_ns) ? avfao_ns_to_seconds(raw_ns)
+                                                         : -1.0;
+        avfao_log(cx->host, AVFAO_V, "heartbeat: raw pos %.3fs, clamped %.3fs, "
+                  "fed %.3fs, status %d, tc %d, reader gap %lld B\n", raw,
+                  avfao_ns_to_seconds(clock), avfao_ns_to_seconds(cx->fed_ns),
+                  status, time_control, (long long)ops->reader_gap(cx->ctx));
+    }
+}
+
+// An item that failed, or a player with an error, ends passthrough. The
+// rejection and the fallback are two separate lines.
+static bool rejected(struct avfao_cx *cx)
+{
+    char desc[512] = "unknown";
+    char domain[256] = "-";
+    long code = 0;
+    if (!cx->ops->failure(cx->ctx, desc, sizeof(desc), domain, sizeof(domain), &code))
+        return false;
+    avfao_log(cx->host, AVFAO_ERR, "player rejected the compressed stream: %s (%s:%ld)\n",
+              desc, domain, code);
+    avfao_log(cx->host, AVFAO_ERR, "falling back to PCM\n");
+    avfao_cx_fallback(cx);
+    return true;
+}
+
+static void fill(struct avfao_cx *cx)
+{
+    for (int n = 0; n < AVFAO_FILL_MAX_READS; n++) {
+        if (cx->eof || cx->fallback || !window_has_room(cx))
+            return;
+        int64_t position = avfao_cx_feed_position(cx);
+        int64_t target = position > 0 ? cx->cfg.lead_ns : 2 * cx->cfg.lead_ns;
+        if (cx->fed_ns - position >= target)
+            return;
+        if (!read_once(cx))
+            return;
+    }
+}
+
+void avfao_cx_supervise(struct avfao_cx *cx)
+{
+    if (!cx->playing || !cx->item || cx->fallback)
+        return;
+    struct avfao_startup_view v = view(cx, true);
+    avfao_supervise(&cx->st, &cx->cfg, &v, cx->host, &startup_ops, cx);
+}
+
+void avfao_cx_step(struct avfao_cx *cx)
+{
+    if (cx->fallback || !cx->item)
+        return;
+    cx->heartbeat++;
+
+    // Diagnostics and failure detection come before any read, so a
+    // rejected item is never fed again.
+    diagnostics(cx);
+    if (rejected(cx))
+        return;
+
+    fill(cx);
+
+    // Anchor reads only after filling has stopped. A fallback raised by a
+    // read skips the rest, apart from resume detection.
+    struct avfao_startup_view v = view(cx, false);
+    if (avfao_start_anchor_due(&cx->st, &cx->cfg, &v, cx->fallback, window_has_room(cx)))
+        anchor_read(cx);
+    v = view(cx, false);
+    avfao_resume_detect(&cx->st, &v, cx->host);
+    if (avfao_resume_anchor_due(&cx->st, &cx->cfg, &v, cx->fallback, window_has_room(cx)))
+        anchor_read(cx);
+    if (cx->fallback)
+        return;
+
+    cx->ops->serve(cx->ctx);
+    avfao_cx_supervise(cx);
+}
+
+enum avfao_serve avfao_cx_serve_request(struct avfao_cx *cx, int64_t offset,
+                                        int64_t end, int64_t *len)
+{
+    return avfao_serve_request(cx->host, &cx->win, offset, end, len);
+}
+
+void avfao_cx_start(struct avfao_cx *cx)
+{
+    cx->playing = true;
+    // mpv starts the AO again, without a reset, when audio arrives after an
+    // end of file: clear it before anything can read from mpv.
+    if (cx->eof)
+        avfao_log(cx->host, AVFAO_V, "resuming compressed feed after audio EOF\n");
+    cx->eof = false;
+
+    if (!cx->item) {
+        // Each item's stream begins at byte 0 and time 0. After a fallback
+        // the item is still made, but its feed steps do nothing.
+        reset_item_state(cx);
+        if (cx->ops->item_create(cx->ctx)) {
+            cx->item = true;
+            cx->last_status = -1;
+            cx->last_time_control = -1;
+        } else {
+            avfao_log(cx->host, AVFAO_FATAL,
+                      "failed to create the passthrough player item\n");
+            avfao_cx_fallback(cx);
+        }
+    } else if (cx->st.rate_requested) {
+        cx->ops->set_rate(cx->ctx, 1);
+    }
+
+    avfao_trace_edge(cx->host, cx->trace, "start", avfao_cx_clock(cx), cx->fed_ns);
+    cx->ops->timer(cx->ctx, true);
+    avfao_cx_step(cx);
+}
+
+void avfao_cx_reset(struct avfao_cx *cx)
+{
+    avfao_trace_edge(cx->host, cx->trace, "reset", avfao_cx_clock(cx), cx->fed_ns);
+    cx->playing = false;
+    cx->ops->timer(cx->ctx, false);
+    if (cx->item) {
+        cx->ops->item_teardown(cx->ctx);
+        cx->item = false;
+    }
+    reset_item_state(cx);
+}
+
+void avfao_cx_pause(struct avfao_cx *cx, bool paused)
+{
+    if (paused) {
+        cx->playing = false;
+        avfao_trace_edge(cx->host, cx->trace, "pause", avfao_cx_clock(cx), cx->fed_ns);
+        cx->ops->timer(cx->ctx, false);
+        cx->ops->set_rate(cx->ctx, 0);
+        avfao_startup_pause(&cx->st);
+        return;
+    }
+
+    cx->playing = true;
+    avfao_trace_edge(cx->host, cx->trace, "resume", avfao_cx_clock(cx), cx->fed_ns);
+    avfao_startup_unpause(&cx->st, &cx->cfg, avfao_now(cx->host), &startup_ops, cx);
+    cx->ops->timer(cx->ctx, true);
+    avfao_cx_step(cx);
+}
