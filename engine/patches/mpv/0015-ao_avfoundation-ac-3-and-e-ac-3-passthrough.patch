+++ b/audio/out/ao_avfoundation_iec61937.c
@@ -0,0 +1,232 @@
+/*
+ * AVFoundation audio output: IEC 61937 unwrapping and the stream window.
+ *
+ * Copyright (C) 2026 blurbery
+ *
