---
diff --git a/video/decode/vd_lavc.c b/video/decode/vd_lavc.c
index 0000000000..0000000000 100644
--- a/video/decode/vd_lavc.c
+++ b/video/decode/vd_lavc.c
@@ -66,6 +66,13 @@
                           struct bstr name);
 
 #define HWDEC_DELAY_QUEUE_COUNT 2
+
+// Once hardware decoding has output a frame, a run of decoding errors that
+// reaches --hwdec-software-fallback ends it only after this many keyframes
+// have been sent during the run without recovering, or once the run is this
+// long.
+#define HWDEC_FAIL_KEYFRAMES 2
+#define HWDEC_FAIL_MAX_RUN 240
 
 #define OPT_BASE_STRUCT struct vd_lavc_params
 
@@ -237,6 +244,9 @@
 
     bool hwdec_request_reinit;
     int hwdec_fail_count;
+    // Keyframe packets accepted by the decoder during the current run of
+    // hardware decoding errors (hwdec_fail_count above 0).
+    int hwdec_fail_keyframes;
 
     struct mp_image_pool *hwdec_swpool;
 
@@ -918,6 +928,7 @@
 
     ctx->hwdec_failed = false;
     ctx->hwdec_fail_count = 0;
+    ctx->hwdec_fail_keyframes = 0;
     ctx->max_delay_queue = 0;
     ctx->hw_probing = false;
     ctx->hwdec = (struct hwdec_info){0};
@@ -1159,7 +1170,13 @@
 
     if (ctx->use_hwdec) {
         ctx->hwdec_fail_count += 1;
-        if (ctx->hwdec_fail_count >= hwdec_opts->software_fallback)
+        // While probing (no frame output since the decoder was set up), fall
+        // back at once. Afterwards, tolerate a short burst of errors, such as
+        // a single frame the hardware decoder rejects.
+        if (ctx->hwdec_fail_count >= hwdec_opts->software_fallback &&
+            (!ctx->hwdec_notified ||
+             ctx->hwdec_fail_keyframes >= HWDEC_FAIL_KEYFRAMES ||
+             ctx->hwdec_fail_count >= HWDEC_FAIL_MAX_RUN))
             ctx->hwdec_failed = true;
     }
 }
@@ -1188,6 +1205,11 @@
     int ret = avcodec_send_packet(avctx, pkt ? ctx->avpkt : NULL);
     if (ret == AVERROR(EAGAIN) || ret == AVERROR_EOF)
         return ret;
+
+    // A keyframe accepted during a run of hardware decoding errors counts
+    // before this packet's own error, if any.
+    if (ctx->use_hwdec && ctx->hwdec_fail_count > 0 && pkt && pkt->keyframe)
+        ctx->hwdec_fail_keyframes += 1;
 
     if (ctx->hw_probing && ctx->num_sent_packets < 32 &&
         ctx->hwdec_opts->software_fallback <= 32)
@@ -1264,7 +1286,12 @@
         return AVERROR_BUG;
     }
 
+    if (ctx->hwdec_fail_count > 0) {
+        MP_WARN(vd, "Hardware decoding recovered after %d failed frame%s.\n",
+                ctx->hwdec_fail_count, ctx->hwdec_fail_count == 1 ? "" : "s");
+    }
     ctx->hwdec_fail_count = 0;
+    ctx->hwdec_fail_keyframes = 0;
 
     mpi->pts = mp_pts_from_av(ctx->pic->pts, &ctx->codec_timebase);
     mpi->dts = mp_pts_from_av(ctx->pic->pkt_dts, &ctx->codec_timebase);
