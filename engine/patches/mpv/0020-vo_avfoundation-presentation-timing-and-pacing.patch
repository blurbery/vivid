+ * License along with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include <math.h>
+#include <string.h>
+
+#include "common/common.h"
+
+#include "clock.h"
+
+static double clampd(double v, double lo, double hi)
+{
+    return v < lo ? lo : (v > hi ? hi : v);
+}
+
+// Truncates towards zero, saturating at the int64 limits (infinities
+// included). Only NaN has no value.
+static bool to_int64(double v, int64_t *out)
+{
+    if (isnan(v))
+        return false;
+    if (v >= 0x1p63) {
+        *out = INT64_MAX;
+    } else if (v <= -0x1p63) {
+        *out = INT64_MIN;
+    } else {
+        *out = (int64_t)v;
+    }
+    return true;
+}
+
+bool avf_media_seconds_to_ns(double pts, int64_t *out_ns)
+{
+    if (pts == MP_NOPTS_VALUE || !isfinite(pts))
+        return false;
+    // One rounding for the product and the half-unit offset together. A
+    // finite time beyond the int64 range saturates rather than being lost.
+    double v = fma(pts, 1e9, pts < 0 ? -0.5 : 0.5);
+    return to_int64(v, out_ns);
+}
+
+int64_t avf_frame_duration_ns(bool display_synced, double ideal_frame_duration,
+                              double duration_ns)
+{
+    int64_t d = 0;
+    // A display-synced frame always takes the ideal duration, so one below
+    // 1 ns truncates to 0 and is unusable; vo_frame.duration is not tried.
+    if (display_synced && ideal_frame_duration > 0) {
+        to_int64(ideal_frame_duration * 1e9, &d);
+        return d;
+    }
+    // nearbyint rounds to nearest with ties to even in the default mode.
+    if (duration_ns > 0 && to_int64(nearbyint(duration_ns), &d))
+        return d;
+    return 0;
+}
+
+static void empty_fast(struct avf_estimator *e)
+{
+    e->fast_media = e->fast_duration = 0;
+    e->fast_count = 0;
+}
+
+static void empty_avg(struct avf_estimator *e)
+{
+    e->avg_media = e->avg_duration = 0;
+}
+
+void avf_estimator_reset(struct avf_estimator *e)
+{
+    memset(e, 0, sizeof(*e));
+}
+
+static bool accept_rate(double r)
+{
+    return r >= AVF_EST_MIN_RATE && r <= AVF_EST_MAX_RATE;
+}
+
+// Adds a step to the averaging window and returns its estimate once it holds
+// at least 500 ms of frame duration; only the averaging window is emptied.
+static bool feed_avg(struct avf_estimator *e, int64_t delta, int64_t dur,
+                     double *rate)
+{
+    e->avg_media += delta;
+    e->avg_duration += dur;
+    if (e->avg_duration < AVF_EST_WINDOW_NS)
+        return false;
+    double r = (double)e->avg_media / (double)e->avg_duration;
+    empty_avg(e);
+    if (!accept_rate(r))
+        return false;
+    *rate = r;
+    return true;
+}
+
+bool avf_estimator_push(struct avf_estimator *e, int64_t media_ns,
+                        int64_t duration_ns, double nominal, double *rate)
+{
+    double n = nominal > 0 ? nominal : 1.0;
+
+    // Unusable duration: nothing changes.
+    if (duration_ns <= 0)
+        return false;
+
+    // First sample: remember it.
+    if (!e->has_prev) {
+        e->has_prev = true;
+        e->prev_media = media_ns;
+        e->prev_duration = duration_ns;
+        return false;
+    }
+
+    int64_t delta = media_ns - e->prev_media;
+
+    // No media step: the stored sample stays as it is.
+    if (delta == 0)
+        return false;
+
+    int64_t d0 = e->prev_duration;
+    int64_t abs_d0 = d0 < 0 ? -d0 : d0;
+    int64_t gate = abs_d0 / 100;
+    if (gate < AVF_EST_STEP_FLOOR_NS)
+        gate = AVF_EST_STEP_FLOOR_NS;
+    int64_t step = duration_ns - d0;
+    if (step < 0)
+        step = -step;
+    double r = (double)delta / (double)d0;
+
+    e->prev_media = media_ns;
+    e->prev_duration = duration_ns;
+
+    // Discontinuity: both windows are emptied before any ratio is used.
+    if (delta < 0 || step > gate || !accept_rate(r)) {
+        empty_fast(e);
+        empty_avg(e);
+        return false;
+    }
+
+    if (fabs(r - n) <= AVF_EST_NEAR * n) {
+        // Near nominal.
+        empty_fast(e);
+        return feed_avg(e, delta, d0, rate);
+    }
+
+    // Far from nominal. A fast window whose ratio disagrees with this step by
+    // more than 4% of the window's own ratio starts again.
+    if (e->fast_count > 0) {
+        double fr = (double)e->fast_media / (double)e->fast_duration;
+        if (fabs(fr - r) > AVF_EST_NEAR * fr)
+            empty_fast(e);
+    }
+    e->fast_media += delta;
+    e->fast_duration += d0;
+    e->fast_count += 1;
+    if (e->fast_count >= 2) {
+        double fr = (double)e->fast_media / (double)e->fast_duration;
+        empty_fast(e);
+        empty_avg(e);
+        if (!accept_rate(fr))
+            return false;
+        *rate = fr;
+        return true;
+    }
+    return feed_avg(e, delta, d0, rate);
+}
+
+double avf_clock_nominal(const struct avf_clock *c)
+{
+    return c->nominal > 0 ? c->nominal : 1.0;
+}
+
+void avf_clock_reset(struct avf_clock *c)
+{
+    c->have_last_media = false;
+    c->last_media_ns = 0;
+    c->anchor_valid = false;
+    c->integral = 0;
+    c->have_eval = false;
+    c->last_eval_ns = 0;
+    c->last_rate_write_ns = 0;
+    avf_estimator_reset(&c->est);
+    c->nominal = avf_clock_nominal(c);
+    c->applied = c->nominal;
+    c->applied_valid = true;
+    c->timebase_paused = c->playback_paused;
+}
+
+void avf_clock_init(struct avf_clock *c)
+{
+    memset(c, 0, sizeof(*c));
+    c->nominal = 1.0;
+    avf_clock_reset(c);
+}
+
+void avf_clock_step(struct avf_clock *c, const struct avf_clock_frame *in,
+                    struct avf_clock_result *out)
+{
+    *out = (struct avf_clock_result){ .op = AVF_CLOCK_KEEP };
+
+    double nominal = avf_clock_nominal(c);
+    if (in->has_estimate && !c->playback_paused &&
+        fabs(in->estimate - nominal) > AVF_RATE_ADOPT * nominal)
+    {
+        c->nominal = in->estimate;
+        nominal = in->estimate;
+        out->nominal_changed = true;
+    }
+
+    double applied = c->applied_valid ? c->applied : nominal;
+    double lead = (double)(in->target_ns - in->now_ns);
+    int64_t projection = (int64_t)(lead * applied); // truncated to whole ns
+    int64_t e = in->media_ns - (in->timebase_ns + projection);
+    out->error_ns = e;
+    int64_t abs_e = e < 0 ? -e : e;
+    bool too_far = abs_e > AVF_REANCHOR_NS;
+    bool paused = c->playback_paused || c->timebase_paused;
+
+    // The pacing summary samples the phase error only on frames that reach
+    // the phase-error test: a valid anchor, neither playback nor the
+    // timebase paused, and the nominal rate unchanged on this frame. A frame
+    // that re-anchors because its error is too large still counts.
+    if (c->anchor_valid && !paused && !out->nominal_changed &&
+        abs_e > c->max_abs_error_ns)
+        c->max_abs_error_ns = abs_e;
+
+    if (!c->anchor_valid || paused || out->nominal_changed || too_far) {
+        out->error_anchor = too_far && c->anchor_valid && !paused &&
+                            !out->nominal_changed;
+        double rate = paused ? 0.0 : nominal;
+        out->op = AVF_CLOCK_ANCHOR;
+        out->rate = rate;
+        c->integral = 0;
+        c->have_eval = false;
+        c->last_rate_write_ns = in->now_ns;
+        c->nominal = rate;
+        c->applied = rate;
+        c->applied_valid = true;
+        c->anchor_valid = true;
+        c->timebase_paused = c->playback_paused;
+        c->anchors += 1;
+    } else {
+        double p = clampd(((double)e / 1e9) / AVF_SERVO_HORIZON,
+                          -AVF_SERVO_LIMIT, AVF_SERVO_LIMIT);
+        if (c->have_eval) {
+            int64_t dt = in->now_ns - c->last_eval_ns;
+            if (dt > 0 && dt <= AVF_SERVO_MAX_STEP_NS) {
+                // P times the step in nanoseconds, over Ti in nanoseconds.
+                c->integral += p * (double)dt / AVF_SERVO_INTEGRAL_TIME_NS;
+                c->integral = clampd(c->integral, -AVF_SERVO_LIMIT,
+                                     AVF_SERVO_LIMIT);
+            }
+        }
+        c->have_eval = true;
+        c->last_eval_ns = in->now_ns;
+        double r = nominal * (1.0 + clampd(p + c->integral, -AVF_SERVO_LIMIT,
+                                           AVF_SERVO_LIMIT));
+        if (fabs(r - applied) > AVF_SERVO_MIN_CHANGE * nominal &&
+            in->now_ns - c->last_rate_write_ns >= AVF_SERVO_WRITE_GAP_NS)
+        {
+            out->op = AVF_CLOCK_SET_RATE;
+            out->rate = r;
+            c->applied = r;
+            c->applied_valid = true;
+            c->last_rate_write_ns = in->now_ns;
+            c->rate_writes += 1;
+        }
+    }
+
+    c->have_last_media = true;
+    c->last_media_ns = in->media_ns;
+}
+
+void avf_clock_pause(struct avf_clock *c)
+{
+    c->playback_paused = true;
+    c->applied = 0;
+    c->applied_valid = true;
+    c->timebase_paused = true;
+}
+
+void avf_clock_resume(struct avf_clock *c)
+{
+    c->playback_paused = false;
+    c->timebase_paused = false;
+    c->anchor_valid = false;
+}
+
+void avf_clock_invalidate(struct avf_clock *c)
+{
+    c->anchor_valid = false;
+    c->timebase_paused = c->playback_paused;
+}
