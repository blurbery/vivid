+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+// Frame pacing for the AVFoundation video output: the readiness wait before
+// each enqueue, deadline drops, the not-ready run and the throttle on display
+// layer recovery. The renderer, the clock and the recovery work are reached
+// through callbacks, so the rules can be tested with a fake renderer.
+
+#ifndef MP_AVFOUNDATION_PACING_H
+#define MP_AVFOUNDATION_PACING_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define AVF_READY_MARGIN_NS 4000000LL        // give up 4 ms before the target
+#define AVF_POLL_NS 1000000LL                // poll every 1 ms
+#define AVF_RECOVERY_THROTTLE_NS 500000000LL // at most one recovery per 500 ms
+#define AVF_RUN_GAP_NS 500000000LL           // a later drop restarts the run
+#define AVF_ENQUEUE_STALE_NS 500000000LL     // enqueue staleness for recovery
+#define AVF_RUN_RECOVERY 3                   // run length that tries recovery
+#define AVF_PACING_WINDOW_NS 5000000000LL    // pacing summary window
+
+enum avf_drop_kind {
+    AVF_DROP_PAST,          // the give-up moment had already passed
+    AVF_DROP_DEADLINE,      // reached while waiting
+    AVF_DROP_UNRECOVERED,   // the layer still needed recovery
+};
+
+struct avf_pacing_ops {
+    void *ctx;
+    int64_t (*now)(void *ctx);
+    void (*sleep)(void *ctx, int64_t ns);
+    bool (*ready)(void *ctx);
+    bool (*needs_recovery)(void *ctx);
+    // The recovery itself (flushes, logging and the state that follows a
+    // recovery outside this module). Called only when the throttle allows.
+    void (*recover)(void *ctx, const char *reason);
+    // One deadline drop: add 1 to mpv's drop count and log it.
+    void (*dropped)(void *ctx, enum avf_drop_kind kind, double remaining_ms);
+};
+
+struct avf_pacing {
+    int run;                    // not-ready run
+    bool have_last_drop;
+    int64_t last_drop_ns;
+    bool have_last_recovery;
+    int64_t last_recovery_ns;
+    bool have_last_enqueue;
+    int64_t last_enqueue_ns;
+
+    // Pacing summary window.
+    bool window_started;
+    int64_t window_start_ns;
+    unsigned waits;
+    int64_t wait_total_ns;
+    int64_t wait_max_ns;
+    unsigned drops;
+    unsigned recoveries;
+};
+
+enum avf_wait_result {
+    AVF_WAIT_PROCEED,
+    AVF_WAIT_DROP,
+};
+
+void avf_pacing_init(struct avf_pacing *p);
+
+// VOCTRL_RESET: clears the run, the last drop, recovery and enqueue times.
+void avf_pacing_reset(struct avf_pacing *p);
+
+// Waits until the renderer is ready for the frame due at target_ns, or drops
+// it. A drop counts once through ops->dropped.
+enum avf_wait_result avf_pacing_wait(struct avf_pacing *p,
+                                     const struct avf_pacing_ops *ops,
+                                     int64_t target_ns);
+
+// Runs a recovery unless the throttle suppresses it (forced recoveries are
+// never suppressed). Returns whether it ran.
+bool avf_pacing_recover(struct avf_pacing *p, const struct avf_pacing_ops *ops,
+                        const char *reason, bool forced);
+
+// Records a video enqueue at now_ns.
+void avf_pacing_enqueued(struct avf_pacing *p, int64_t now_ns);
+
+// Opens the first summary window (at the start of the first flip); later
+// calls do nothing.
+void avf_pacing_window_open(struct avf_pacing *p, int64_t now_ns);
+
+// Returns true when the summary window has ended; the caller then logs the
+// counters (if any of them other than the recoveries is non-zero) and calls
+// avf_pacing_window_restart().
+bool avf_pacing_window_due(struct avf_pacing *p, int64_t now_ns);
+void avf_pacing_window_restart(struct avf_pacing *p, int64_t now_ns);
+
+#endif
diff --git a/video/out/avfoundation/pacing.c b/video/out/avfoundation/pacing.c
new file mode 100644
--- /dev/null
+++ b/video/out/avfoundation/pacing.c
@@ -0,0 +1,146 @@
+/*
+ * This file is part of mpv.
+ *
+ * Copyright (C) 2026 blurbery
+ *
+ * mpv is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * mpv is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include <string.h>
+
+#include "pacing.h"
+
+void avf_pacing_init(struct avf_pacing *p)
+{
+    memset(p, 0, sizeof(*p));
+}
+
+void avf_pacing_reset(struct avf_pacing *p)
+{
+    p->run = 0;
+    p->have_last_drop = false;
+    p->have_last_recovery = false;
+    p->have_last_enqueue = false;
+}
+
+bool avf_pacing_recover(struct avf_pacing *p, const struct avf_pacing_ops *ops,
+                        const char *reason, bool forced)
+{
+    int64_t now = ops->now(ops->ctx);
+    if (!forced && p->have_last_recovery &&
+        now - p->last_recovery_ns < AVF_RECOVERY_THROTTLE_NS)
+        return false;
+    ops->recover(ops->ctx, reason);
+    p->run = 0;
+    p->have_last_drop = false;
+    p->have_last_enqueue = false;
+    p->have_last_recovery = true;
+    p->last_recovery_ns = now;
+    p->recoveries += 1;
+    return true;
+}
+
+static enum avf_wait_result drop(struct avf_pacing *p,
+                                 const struct avf_pacing_ops *ops,
+                                 enum avf_drop_kind kind, int64_t now,
+                                 int64_t target_ns)
+{
+    ops->dropped(ops->ctx, kind, (target_ns - now) / 1e6);
+    p->drops += 1;
+    if (p->have_last_drop && now - p->last_drop_ns > AVF_RUN_GAP_NS)
+        p->run = 0;
+    p->run += 1;
+    p->have_last_drop = true;
+    p->last_drop_ns = now;
+    if (p->run >= AVF_RUN_RECOVERY &&
+        (!p->have_last_enqueue ||
+         now - p->last_enqueue_ns >= AVF_ENQUEUE_STALE_NS))
+        avf_pacing_recover(p, ops, "repeated not-ready drops", false);
+    return AVF_WAIT_DROP;
+}
+
+enum avf_wait_result avf_pacing_wait(struct avf_pacing *p,
+                                     const struct avf_pacing_ops *ops,
+                                     int64_t target_ns)
+{
+    if (ops->needs_recovery(ops->ctx))
+        avf_pacing_recover(p, ops, "layer recovery request", false);
+
+    int64_t deadline = target_ns - AVF_READY_MARGIN_NS;
+    int64_t entered = ops->now(ops->ctx);
+    bool polled = false;
+    // Each pass checks readiness, then the deadline, then whether the layer
+    // needs recovery, and only then sleeps for one poll.
+    while (1) {
+        if (ops->ready(ops->ctx)) {
+            p->run = 0;
+            if (polled) {
+                int64_t waited = ops->now(ops->ctx) - entered;
+                p->waits += 1;
+                p->wait_total_ns += waited;
+                if (waited > p->wait_max_ns)
+                    p->wait_max_ns = waited;
+            }
+            return AVF_WAIT_PROCEED;
+        }
+        int64_t now = ops->now(ops->ctx);
+        if (now >= deadline) {
+            return drop(p, ops, polled ? AVF_DROP_DEADLINE : AVF_DROP_PAST, now,
+                        target_ns);
+        }
+        if (ops->needs_recovery(ops->ctx)) {
+            avf_pacing_recover(p, ops, "not-ready wait", false);
+            // Whether it ran or the throttle suppressed it, a layer that still
+            // needs recovery cannot take the frame.
+            if (ops->needs_recovery(ops->ctx))
+                return drop(p, ops, AVF_DROP_UNRECOVERED, ops->now(ops->ctx),
+                            target_ns);
+            continue; // look at the recovered layer at once
+        }
+        ops->sleep(ops->ctx, AVF_POLL_NS);
+        polled = true;
+    }
+}
+
+void avf_pacing_enqueued(struct avf_pacing *p, int64_t now_ns)
+{
+    p->have_last_enqueue = true;
+    p->last_enqueue_ns = now_ns;
+}
+
+void avf_pacing_window_open(struct avf_pacing *p, int64_t now_ns)
+{
+    if (!p->window_started)
+        avf_pacing_window_restart(p, now_ns);
+}
+
+bool avf_pacing_window_due(struct avf_pacing *p, int64_t now_ns)
+{
+    if (!p->window_started) {
+        avf_pacing_window_restart(p, now_ns);
+        return false;
+    }
+    return now_ns - p->window_start_ns >= AVF_PACING_WINDOW_NS;
+}
+
+void avf_pacing_window_restart(struct avf_pacing *p, int64_t now_ns)
+{
+    p->window_started = true;
+    p->window_start_ns = now_ns;
+    p->waits = 0;
+    p->wait_total_ns = 0;
+    p->wait_max_ns = 0;
+    p->drops = 0;
+    p->recoveries = 0;
+}
