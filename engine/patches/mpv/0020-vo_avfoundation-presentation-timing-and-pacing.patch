+// The presentation timebase of the AVFoundation video output: one CoreMedia
+// timebase on the host time clock, in nanoseconds throughout.
+
+#ifndef MP_AVFOUNDATION_TIMEBASE_H
+#define MP_AVFOUNDATION_TIMEBASE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include <CoreMedia/CoreMedia.h>
+
+// A timebase driven by CMClockGetHostTimeClock() (+1), or NULL.
+CMTimebaseRef avf_timebase_create(void);
+
+// Host mode: time = now_ns at rate 1. Media mode: time 0 at rate 0.
+void avf_timebase_seed(CMTimebaseRef tb, bool host_mode, int64_t now_ns);
+
+// The timebase time in nanoseconds (default rounding). Returns false, with
+// *ns set to 0, when the time is not numeric.
+bool avf_timebase_read(CMTimebaseRef tb, int64_t *ns);
+
+// Anchors media_ns at rate. The source time is the source clock's current
+// time plus (target_ns minus host_now()), with host_now() read after the
+// source clock; without host_now it is the source clock's time itself.
+OSStatus avf_timebase_anchor(CMTimebaseRef tb, double rate, int64_t media_ns,
+                             int64_t target_ns, int64_t (*host_now)(void));
+
+OSStatus avf_timebase_set_rate(CMTimebaseRef tb, double rate);
+
+#endif
diff --git a/video/out/avfoundation/timebase.c b/video/out/avfoundation/timebase.c
new file mode 100644
--- /dev/null
+++ b/video/out/avfoundation/timebase.c
@@ -0,0 +1,83 @@
+/*
+ * This file is part of mpv.
+ *
+ * Copyright (C) 2026 blurbery
+ *
+ * mpv is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * mpv is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "timebase.h"
+
+#define NS 1000000000
+
+CMTimebaseRef avf_timebase_create(void)
+{
+    CMTimebaseRef tb = NULL;
+    if (CMTimebaseCreateWithSourceClock(NULL, CMClockGetHostTimeClock(), &tb) != noErr)
+        return NULL;
+    return tb;
+}
+
+void avf_timebase_seed(CMTimebaseRef tb, bool host_mode, int64_t now_ns)
+{
+    // A failed write leaves the timebase as it was; nothing retries it.
+    if (host_mode) {
+        CMTimebaseSetTime(tb, CMTimeMake(now_ns, NS));
+        CMTimebaseSetRate(tb, 1.0);
+    } else {
+        CMTimebaseSetRate(tb, 0.0);
+        CMTimebaseSetTime(tb, CMTimeMake(0, NS));
+    }
+}
+
+bool avf_timebase_read(CMTimebaseRef tb, int64_t *ns)
+{
+    CMTime t = CMTimeConvertScale(CMTimebaseGetTime(tb), NS,
+                                  kCMTimeRoundingMethod_Default);
+    if (!CMTIME_IS_NUMERIC(t)) {
+        *ns = 0;
+        return false;
+    }
+    *ns = t.value;
+    return true;
+}
+
+static CMTime source_now(CMTimebaseRef tb)
+{
+    CMTime t = kCMTimeInvalid;
+    CMClockOrTimebaseRef src = CMTimebaseCopySource(tb);
+    if (src) {
+        t = CMSyncGetTime(src);
+        CFRelease(src);
+    }
+    if (!CMTIME_IS_NUMERIC(t))
+        t = CMClockGetTime(CMClockGetHostTimeClock());
+    return t;
+}
+
+OSStatus avf_timebase_anchor(CMTimebaseRef tb, double rate, int64_t media_ns,
+                             int64_t target_ns, int64_t (*host_now)(void))
+{
+    CMTime source = source_now(tb);
+    // The host clock is read only now, after the source clock, so the offset
+    // to the target is as fresh as the source time it is added to.
+    if (host_now)
+        source = CMTimeAdd(source, CMTimeMake(target_ns - host_now(), NS));
+    return CMTimebaseSetRateAndAnchorTime(tb, rate, CMTimeMake(media_ns, NS), source);
+}
+
+OSStatus avf_timebase_set_rate(CMTimebaseRef tb, double rate)
+{
+    return CMTimebaseSetRate(tb, rate);
+}
