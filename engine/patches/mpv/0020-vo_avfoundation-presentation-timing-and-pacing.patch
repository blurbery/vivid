+
+// Presentation timing for the AVFoundation video output: the playback rate
+// estimator and the media-mode timebase servo. Pure arithmetic with no
+// framework calls, so the decisions can be tested on their own. The caller
+// reads the timebase, passes the readings in and applies what comes back.
+
+#ifndef MP_AVFOUNDATION_CLOCK_H
+#define MP_AVFOUNDATION_CLOCK_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define AVF_NS_PER_SEC 1000000000LL
+#define AVF_NS_PER_MS 1000000LL
+
+// Servo and estimator constants.
+#define AVF_REANCHOR_NS (50 * AVF_NS_PER_MS)    // phase error that re-anchors
+#define AVF_SERVO_HORIZON 2.0                   // seconds
+#define AVF_SERVO_INTEGRAL_TIME_NS 8e9          // Ti, in nanoseconds
+#define AVF_SERVO_LIMIT 0.015                   // on P, the integral and their sum
+#define AVF_SERVO_MIN_CHANGE 0.0001             // of nominal
+#define AVF_SERVO_WRITE_GAP_NS (200 * AVF_NS_PER_MS)
+#define AVF_SERVO_MAX_STEP_NS (500 * AVF_NS_PER_MS)
+#define AVF_RATE_ADOPT 0.01                     // nominal change threshold
+#define AVF_EST_WINDOW_NS (500 * AVF_NS_PER_MS)
+#define AVF_EST_NEAR 0.04
+#define AVF_EST_MIN_RATE 0.05
+#define AVF_EST_MAX_RATE 8.0
+#define AVF_EST_STEP_FLOOR_NS 250000LL          // 250 us
+
+// Media seconds to nanoseconds: pts * 1e9 + 0.5 (or - 0.5 for negative pts)
+// as one fused multiply-add, truncated towards zero, saturating at the int64
+// limits. Returns false when pts is not a usable media time (mpv's "no pts"
+// value, or not finite).
+bool avf_media_seconds_to_ns(double pts, int64_t *out_ns);
+
+// The frame duration the estimator uses: a display-synced frame with a
+// positive ideal_frame_duration (seconds) uses it * 1e9 truncated (0, so
+// unusable, below 1 ns); otherwise vo_frame.duration (nanoseconds) rounded to
+// nearest with ties to even when positive; otherwise 0.
+int64_t avf_frame_duration_ns(bool display_synced, double ideal_frame_duration,
+                              double duration_ns);
+
+struct avf_estimator {
+    bool has_prev;
+    int64_t prev_media, prev_duration;
+    int64_t fast_media, fast_duration;
+    int fast_count;
+    int64_t avg_media, avg_duration;
+};
+
+void avf_estimator_reset(struct avf_estimator *e);
+
+// Feed one frame with a valid media time. nominal is the current nominal
+// playback rate (0 or below counts as 1.0). Returns true and sets *rate when
+// this frame produced an estimate inside the accepted range.
+bool avf_estimator_push(struct avf_estimator *e, int64_t media_ns,
+                        int64_t duration_ns, double nominal, double *rate);
+
+struct avf_clock {
+    struct avf_estimator est;
+    double nominal;             // as stored; 0 or below reads as 1.0
+    bool applied_valid;
+    double applied;             // rate currently applied to the timebase
+    bool anchor_valid;
+    bool playback_paused;
+    bool timebase_paused;
+    double integral;
+    bool have_eval;
+    int64_t last_eval_ns;
+    int64_t last_rate_write_ns;
+    bool have_last_media;
+    int64_t last_media_ns;
+
+    // Pacing summary counters, cleared by the caller.
+    unsigned anchors;
+    unsigned rate_writes;
+    int64_t max_abs_error_ns;
+};
+
+// What the caller must do to the timebase for this frame.
+enum avf_clock_op {
+    AVF_CLOCK_KEEP,     // leave the timebase alone (servo state updated)
+    AVF_CLOCK_ANCHOR,   // anchor: rate, frame media time, source time "target"
+    AVF_CLOCK_SET_RATE, // set the timebase rate to result.rate
+};
+
+struct avf_clock_frame {
+    int64_t media_ns;       // the frame's media time (valid)
+    int64_t target_ns;      // target host time
+    int64_t now_ns;         // host time now
+    int64_t timebase_ns;    // timebase time now (0 if not numeric)
+    bool has_estimate;      // this frame's rate estimate
+    double estimate;
+};
+
+struct avf_clock_result {
+    enum avf_clock_op op;
+    double rate;
+    bool nominal_changed;   // the estimate became the nominal rate
+    bool error_anchor;      // anchored because the phase error exceeded 50 ms
+    int64_t error_ns;       // phase error (positive: timebase behind)
+};
+
+double avf_clock_nominal(const struct avf_clock *c);
+
+// Media timing reset: creation (nominal 1.0) and every VOCTRL_RESET.
+void avf_clock_reset(struct avf_clock *c);
+void avf_clock_init(struct avf_clock *c);
+
+// Per enqueued frame with a valid media time, after the readiness wait.
+void avf_clock_step(struct avf_clock *c, const struct avf_clock_frame *in,
+                    struct avf_clock_result *out);
+
+// VOCTRL_PAUSE in media mode. The caller anchors the timebase at rate 0.
+void avf_clock_pause(struct avf_clock *c);
+// VOCTRL_RESUME in media mode.
+void avf_clock_resume(struct avf_clock *c);
+// After a display layer recovery: the next frame anchors again.
+void avf_clock_invalidate(struct avf_clock *c);
+
+#endif
