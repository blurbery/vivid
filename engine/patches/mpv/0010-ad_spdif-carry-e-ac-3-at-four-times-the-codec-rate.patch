---
diff --git a/audio/decode/ad_spdif.c b/audio/decode/ad_spdif.c
index 0000000000..0000000000 100644
--- a/audio/decode/ad_spdif.c
+++ b/audio/decode/ad_spdif.c
@@ -285,8 +285,10 @@
         break;
     }
     case AV_CODEC_ID_EAC3:
+        // IEC 61937 carries E-AC-3 at four times the codec rate, so a
+        // 44.1 kHz stream needs a 176.4 kHz carrier rather than 192 kHz.
         sample_format                   = AF_FORMAT_S_EAC3;
-        samplerate                      = 192000;
+        samplerate                      = 4 * (c_rate > 0 ? c_rate : 48000);
         num_channels                    = 2;
         break;
     case AV_CODEC_ID_MP3:
