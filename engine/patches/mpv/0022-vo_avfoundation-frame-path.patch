+
+// The frame path of the AVFoundation video output: software uploads and
+// their colour tags, the pixel aspect attachment, the Dolby Vision transfer
+// repair, Picture in Picture subtitle composites, format descriptions and
+// video samples. Nothing here touches a layer.
+
+#ifndef MP_AVFOUNDATION_FRAME_H
+#define MP_AVFOUNDATION_FRAME_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include <CoreGraphics/CoreGraphics.h>
+#include <CoreMedia/CoreMedia.h>
+#include <CoreVideo/CoreVideo.h>
+
+#include "pixels.h"
+
+struct mp_log;
+struct mp_image;
+struct mp_image_params;
+struct avf_frame;
+
+// Software formats the output accepts besides VideoToolbox frames.
+enum avf_sw_format {
+    AVF_SW_NONE = 0,
+    AVF_SW_NV12,
+    AVF_SW_420P,
+    AVF_SW_P010,
+    AVF_SW_420P10,  // mpv's format for AV_PIX_FMT_YUV420P10
+    AVF_SW_420P12,  // mpv's format for AV_PIX_FMT_YUV420P12
+};
+
+// The Dolby Vision key VideoToolbox attaches to frames of native Dolby
+// Vision sessions.
+#define AVF_DOLBY_VISION_RPU_KEY CFSTR("DolbyVisionRPUData")
+
+struct avf_frame *avf_frame_create(struct mp_log *log);
+void avf_frame_destroy(struct avf_frame *f);
+
+// Copies a software image into a biplanar upload buffer (+1). Logs an error
+// and returns NULL on failure.
+CVPixelBufferRef avf_frame_upload(struct avf_frame *f, enum avf_sw_format fmt,
+                                  const struct mp_image *img);
+
+// Colour tags for an uploaded software frame, from the image's own params.
+void avf_frame_tag_software(CVPixelBufferRef buf,
+                            const struct mp_image_params *params);
+
+// Attaches or removes the pixel aspect ratio, from the configured params
+// (NULL leaves the buffer as it is).
+void avf_frame_pixel_aspect(CVPixelBufferRef buf,
+                            const struct mp_image_params *vo_params);
+
+// Fills a missing transfer function on a Dolby Vision passthrough frame from
+// the image's own params. Returns whether it changed the buffer.
+bool avf_frame_dolby_vision_repair(CVPixelBufferRef buf,
+                                   const struct mp_image_params *params);
+
+// A video sample (+1) at pts_ns, with the cached format description. Logs an
+// error and returns NULL on failure.
+CMSampleBufferRef avf_frame_sample(struct avf_frame *f, CVPixelBufferRef buf,
+                                   int64_t pts_ns);
+
+// The rendered subtitles a composite needs.
+struct avf_overlay {
+    CVPixelBufferRef bgra;      // premultiplied BGRA canvas, or NULL
+    struct avf_irect bbox;      // drawn area in canvas pixels
+    CGImageRef image;           // CoreGraphics snapshot, or NULL
+    int canvas_w, canvas_h;
+    struct avf_irect src, dst;  // frame and canvas rectangles
+};
+
+enum avf_composite_kind {
+    AVF_COMPOSITE_NONE,         // nothing composited
+    AVF_COMPOSITE_IN_PLACE,     // blended into the output's own upload buffer
+    AVF_COMPOSITE_DECODER,      // blended into the decoder's buffer, whose
+                                // original rows are kept for a restore
+    AVF_COMPOSITE_CORE_IMAGE,   // Core Image render into a new buffer
+};
+
+// Composites the subtitles into the picture. A biplanar 4:2:0 buffer is
+// blended in place: an upload buffer (writable) as it is, a decoder buffer
+// after the rows the blend changes have been kept, so they can be put back
+// (avf_frame_restore). Other formats, and a blend that produces nothing, go
+// through Core Image into a new buffer; a format Core Image cannot read gets
+// no composite. Returns the buffer to enqueue (+1), or NULL when the frame
+// goes out without the subtitle.
+CVPixelBufferRef avf_frame_composite(struct avf_frame *f, CVPixelBufferRef video,
+                                     bool writable, const struct avf_overlay *ov,
+                                     enum avf_composite_kind *kind);
+
+// Called for every buffer about to be presented: if an earlier composite
+// changed this buffer, its original rows are put back, so each sample carries
+// its current subtitle exactly once. Any other kept buffer is let go
+// untouched, since mpv only presents its current image again.
+void avf_frame_restore(struct avf_frame *f, CVPixelBufferRef buf);
+
+// Compositing has stopped: puts back the rows of a kept decoder buffer and
+// frees everything kept for it.
+void avf_frame_end_composites(struct avf_frame *f);
+
+// The decoder buffer a composite changed (NULL if none) and how many bytes
+// of rows are held for restores. For the host tests.
+CVPixelBufferRef avf_frame_kept_buffer(const struct avf_frame *f, size_t *saved_bytes);
+
+// The 60-flip maintenance: flushes excess buffers in the frame pools.
+void avf_frame_maintain(struct avf_frame *f);
+
+// Releases the Core Image context and the Metal device.
+void avf_frame_release_core_image(struct avf_frame *f);
+
+// Copies the attachments of buf in mode (NULL if none). +1. Like the colour
+// tags, the Dolby Vision repair and the composites, these use CoreVideo calls
+// from iOS and tvOS 15, below the output's own floor of 17.
+CFDictionaryRef avf_copy_attachments(CVBufferRef buf, CVAttachmentMode mode);
+// Copies one attachment (+1) and its mode, or NULL.
+CFTypeRef avf_copy_attachment(CVBufferRef buf, CFStringRef key,
+                              CVAttachmentMode *mode);
+
+#endif
diff --git a/video/out/avfoundation/frame.m b/video/out/avfoundation/frame.m
new file mode 100644
--- /dev/null
+++ b/video/out/avfoundation/frame.m
@@ -0,0 +1,722 @@
+/*
