     void *logctx;
+
+    // Dolby Vision class of the HEVC stream, set at every session start.
+    FFVTDoviStream              dovi;
+
+    // Whether the current session is a Dolby Vision HEVC ('dvh1') session.
+    bool                        dovi_session;
+
+    // The current session's Dolby Vision frame flags, shared with every
+    // frame this hwaccel allocates so they are tagged at output time.
+    struct VTDoviFrameState    *dovi_frame_state;
 } VTContext;
 
 int ff_videotoolbox_alloc_frame(AVCodecContext *avctx, AVFrame *frame);
