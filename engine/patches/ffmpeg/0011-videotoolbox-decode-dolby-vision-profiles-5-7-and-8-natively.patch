     FrameDecodeData *fdd;
     if (ret < 0)
@@ -169,6 +194,10 @@
 
     fdd = frame->private_ref;
     fdd->post_process = videotoolbox_postproc_frame;
+    if (vtctx && vtctx->dovi_frame_state) {
