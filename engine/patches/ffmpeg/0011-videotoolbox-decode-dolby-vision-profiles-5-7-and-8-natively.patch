+#include <stdatomic.h>
+
 #include "config.h"
 #include "config_components.h"
 #include "videotoolbox.h"
 #include "libavutil/hwcontext_videotoolbox.h"
 #include "libavutil/mem.h"
+#include "libavutil/refstruct.h"
 #include "vt_internal.h"
 #include "libavutil/avutil.h"
 #include "libavutil/hwcontext.h"
@@ -67,6 +70,20 @@
     AVBufferRef *hw_frames_ctx;
 } VTHWFrame;
 
+/**
+ * The Dolby Vision flags (FF_VT_DOVI_FRAME_*) of the current session. Each
+ * frame holds a reference, so that it is tagged for the session current
+ * when it is output rather than the one that decoded it.
+ */
+typedef struct VTDoviFrameState {
+    atomic_int flags;
+} VTDoviFrameState;
+
+static void videotoolbox_dovi_state_unref(void *opaque)
+{
+    av_refstruct_unref(&opaque);
+}
+
 static void videotoolbox_buffer_release(void *opaque, uint8_t *data)
 {
     VTHWFrame *ref = (VTHWFrame *)data;
@@ -120,6 +137,9 @@
 {
     int ret;
     VTHWFrame *ref = (VTHWFrame *)frame->buf[0]->data;
+    FrameDecodeData *fdd = frame->private_ref;
+    VTDoviFrameState *dovi = fdd ? fdd->post_process_opaque : NULL;
+    int dovi_flags = dovi ? atomic_load(&dovi->flags) : 0;
 
     if (!ref->pixbuf) {
         av_log(avctx, AV_LOG_ERROR, "No frame decoded?\n");
@@ -132,7 +152,11 @@
     frame->crop_top = 0;
     frame->crop_bottom = 0;
 
-    if ((ret = av_vt_pixbuf_set_attachments(avctx, ref->pixbuf, frame)) < 0)
+    // Dolby Vision HEVC sessions keep VideoToolbox's own attachments
+    // (DolbyVisionRPUData among them) and only get missing HDR tags.
