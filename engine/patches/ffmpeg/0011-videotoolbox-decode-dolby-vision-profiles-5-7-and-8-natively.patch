+#include <stdint.h>
+#include <string.h>
+
+#include <Availability.h>
+#include <AvailabilityMacros.h>
+#include <TargetConditionals.h>
+
+#include <CoreFoundation/CoreFoundation.h>
+#include <CoreMedia/CoreMedia.h>
+#include <CoreVideo/CoreVideo.h>
+#include <VideoToolbox/VideoToolbox.h>
+
+#include <libdovi/rpu_parser.h>
+
+#include "libavutil/error.h"
+#include "libavutil/log.h"
+
+#include "videotoolbox_dovi.h"
+
+void ff_vt_dovi_classify(FFVTDoviStream *s, const uint8_t *side_data,
+                         size_t size)
+{
+    AVDOVIDecoderConfigurationRecord rec;
+
+    memset(s, 0, sizeof(*s));
+    s->cls = FF_VT_DOVI_PLAIN;
+
+    // A record smaller than the public struct counts as absent.
+    if (!side_data || size < sizeof(rec))
+        return;
+    memcpy(&rec, side_data, sizeof(rec));
+
+    // Usable only with both an RPU and a base layer, whatever the profile.
+    if (!rec.rpu_present_flag || !rec.bl_present_flag)
+        return;
+
+    switch (rec.dv_profile) {
+    case 5:
+        // The profile 5 base layer is not a picture a plain decode can show.
+        s->cls = FF_VT_DOVI_NATIVE;
+        break;
+    case 8:
+        // Every compatibility id qualifies; only 4 is an HLG base, the rest
+        // (0 and 2 included) are treated as PQ.
+        s->cls      = FF_VT_DOVI_NATIVE;
+        s->hdr_base = 1;
+        s->hlg_base = rec.dv_bl_signal_compatibility_id == 4;
+        break;
+    case 7:
+        s->cls      = FF_VT_DOVI_CONVERTED;
+        s->hdr_base = 1;
+        break;
+    default:
+        return;
+    }
+    s->record = rec;
+}
+
+int ff_vt_dovi_effective_profile(const FFVTDoviStream *s)
+{
+    switch (s->cls) {
+    case FF_VT_DOVI_NATIVE:
+        return s->record.dv_profile;
+    case FF_VT_DOVI_CONVERTED:
+        return 8;
+    default:
+        return 0;
+    }
+}
+
+int ff_vt_dovi_write_record(const FFVTDoviStream *s,
+                            uint8_t record[FF_VT_DOVI_RECORD_SIZE])
+{
+    const AVDOVIDecoderConfigurationRecord *rec = &s->record;
+    unsigned profile, level, rpu, el, bl, compat, fields;
+
+    if (s->cls == FF_VT_DOVI_PLAIN)
+        return AVERROR(EINVAL);
+
+    profile = ff_vt_dovi_effective_profile(s) & 0x7f;
+    level   = rec->dv_level & 0x3f;
+    rpu     = !!rec->rpu_present_flag;
+    bl      = !!rec->bl_present_flag;
+    if (s->cls == FF_VT_DOVI_CONVERTED) {
+        // Presented as profile 8.1: no enhancement layer, an HDR10 base.
+        el     = 0;
+        compat = 1;
+    } else {
+        el     = !!rec->el_present_flag;
+        compat = rec->dv_bl_signal_compatibility_id & 0x0f;
+    }
+
+    // ETSI TS 103 572 DOVIDecoderConfigurationRecord. The metadata
+    // compression field and the reserved bits are always written as zero:
+    // VideoToolbox refuses a non-zero compression value, which FFmpeg's
+    // MPEG-TS demuxer can report.
+    fields = profile << 9 | level << 3 | rpu << 2 | el << 1 | bl;
+    memset(record, 0, FF_VT_DOVI_RECORD_SIZE);
+    record[0] = rec->dv_version_major;
+    record[1] = rec->dv_version_minor;
+    record[2] = fields >> 8;
+    record[3] = fields & 0xff;
+    record[4] = compat << 4;
+    return 0;
+}
+
+CFStringRef ff_vt_dovi_atom_key(const FFVTDoviStream *s)
+{
+    return ff_vt_dovi_effective_profile(s) > 7 ? CFSTR("dvvC") : CFSTR("dvcC");
+}
+
+int ff_vt_dovi_add_extensions(const FFVTDoviStream *s,
+                              CFMutableDictionaryRef extensions,
+                              CFMutableDictionaryRef atoms)
+{
+    uint8_t record[FF_VT_DOVI_RECORD_SIZE];
+    CFDataRef data;
+    int ret;
+
+    if ((ret = ff_vt_dovi_write_record(s, record)) < 0)
+        return ret;
+
+    data = CFDataCreate(kCFAllocatorDefault, record, sizeof(record));
+    if (!data)
+        return AVERROR(ENOMEM);
+    CFDictionarySetValue(atoms, ff_vt_dovi_atom_key(s), data);
+    CFRelease(data);
+
+    // Colour extensions only where the base layer is an HDR picture, so
+    // never for profile 5.
+    if (s->hdr_base) {
+        CFDictionarySetValue(extensions,
+                             kCMFormatDescriptionExtension_ColorPrimaries,
+                             kCMFormatDescriptionColorPrimaries_ITU_R_2020);
+        CFDictionarySetValue(extensions,
+                             kCMFormatDescriptionExtension_TransferFunction,
+                             s->hlg_base ?
+                                 kCMFormatDescriptionTransferFunction_ITU_R_2100_HLG :
+                                 kCMFormatDescriptionTransferFunction_SMPTE_ST_2084_PQ);
+        CFDictionarySetValue(extensions,
+                             kCMFormatDescriptionExtension_YCbCrMatrix,
+                             kCMFormatDescriptionYCbCrMatrix_ITU_R_2020);
+    }
+    return 0;
+}
+
+int ff_vt_dovi_retry_as_hevc(const FFVTDoviStream *s, OSStatus status)
+{
+    return status != 0 && s->cls != FF_VT_DOVI_PLAIN && s->hdr_base;
+}
+
+void ff_vt_dovi_set_session_properties(void *logctx,
+                                       VTDecompressionSessionRef session)
+{
+    OSStatus status;
+
+    if (__builtin_available(macOS 11.0, iOS 14.0, tvOS 14.0, *)) {
+        status = VTSessionSetProperty(session,
+                                      kVTDecompressionPropertyKey_PropagatePerFrameHDRDisplayMetadata,
+                                      kCFBooleanTrue);
+        if (status)
+            av_log(logctx, AV_LOG_VERBOSE,
+                   "Could not ask VideoToolbox to propagate per-frame HDR "
+                   "display metadata: %d\n", (int)status);
+    }
+
+    if (__builtin_available(macOS 14.0, iOS 17.0, tvOS 17.0, *)) {
+        status = VTSessionSetProperty(session,
+                                      kVTDecompressionPropertyKey_GeneratePerFrameHDRDisplayMetadata,
+                                      kCFBooleanTrue);
+        if (status)
+            av_log(logctx, AV_LOG_VERBOSE,
+                   "Could not ask VideoToolbox to generate per-frame HDR "
+                   "display metadata: %d\n", (int)status);
+    }
+}
+
+int ff_vt_dovi_drop_nal(const FFVTDoviStream *s, const uint8_t *nal,
+                        size_t size)
+{
+    int type;
+
+    if (s->cls != FF_VT_DOVI_CONVERTED || size < 2)
+        return 0;
+
+    type = (nal[0] >> 1) & 0x3f;
+    return type == FF_VT_DOVI_NAL_RPU || type == FF_VT_DOVI_NAL_EL;
+}
+
+int ff_vt_dovi_is_rpu(int nal_type, int raw_size)
+{
+    return nal_type == FF_VT_DOVI_NAL_RPU && raw_size > 2;
+}
+
+int ff_vt_dovi_rpu_is_empty(const uint8_t *nal, size_t size)
+{
+    static const uint8_t start[5] = { 0x7c, 0x01, 0x19, 0x08, 0x09 };
+    const uint8_t *payload;
+    size_t payload_size, kept = 0, used = 0;
+
+    if (size < 25 || memcmp(nal, start, sizeof(start)))
+        return 0;
+
+    // Count what is left after dropping the 2-byte NAL header, every
+    // emulation prevention byte (a 0x03 whose two preceding bytes in the
+    // header-less input are both zero; the first two bytes are always kept)
+    // and the run of zero bytes at the end.
+    payload      = nal + 2;
+    payload_size = size - 2;
+    for (size_t i = 0; i < payload_size; i++) {
+        if (i >= 2 && payload[i] == 0x03 && !payload[i - 1] && !payload[i - 2])
+            continue;
+        kept++;
+        if (payload[i])
+            used = kept;
+    }
+    return used <= 5;
+}
+
+static int vt_dovi_stripped(void *logctx, const FFVTDoviStream *s)
+{
+    av_log(logctx, AV_LOG_WARNING, "Dolby Vision RPU stripped (could not %s)\n",
+           s->cls == FF_VT_DOVI_CONVERTED ? "convert" : "append");
+    return 0;
+}
+
+static const char *vt_dovi_error(const DoviRpuOpaque *rpu)
+{
+    const char *error = dovi_rpu_get_error(rpu);
+    return error ? error : "unknown error";
+}
+
+static int vt_dovi_convert_rpu(void *logctx, const FFVTDoviStream *s,
+                               const uint8_t *nal, size_t size,
+                               FFVTDoviAppendFn append, void *opaque)
+{
+    DoviRpuOpaque *rpu;
+    const DoviData *out;
+    const char *error;
+    int appended = 0;
+
+    // Zero-filled or truncated RPUs make libdovi 3.3.2 abort the process,
+    // so they are skipped as parse failures without calling it.
+    if (ff_vt_dovi_rpu_is_empty(nal, size)) {
+        av_log(logctx, AV_LOG_WARNING,
+               "Dolby Vision RPU holds no metadata after its header and was "
+               "not passed to libdovi\n");
+        return vt_dovi_stripped(logctx, s);
+    }
+
+    rpu = dovi_parse_unspec62_nalu(nal, size);
+    if (!rpu)
+        return vt_dovi_stripped(logctx, s);
+
+    error = dovi_rpu_get_error(rpu);
+    if (error) {
+        av_log(logctx, AV_LOG_WARNING,
+               "Could not parse Dolby Vision RPU: %s\n", error);
+        goto end;
+    }
+
+    if (dovi_convert_rpu_with_mode(rpu, FF_VT_DOVI_CONVERSION_MODE) < 0) {
+        av_log(logctx, AV_LOG_WARNING,
+               "Could not convert Dolby Vision RPU to profile 8.1: %s\n",
+               vt_dovi_error(rpu));
+        goto end;
+    }
+
+    out = dovi_write_unspec62_nalu(rpu);
+    if (!out) {
+        av_log(logctx, AV_LOG_WARNING,
+               "Could not write converted Dolby Vision RPU: %s\n",
+               vt_dovi_error(rpu));
+        goto end;
+    }
+
+    // The sample's 4-byte length prefix must be able to describe it.
+    if (out->len <= UINT32_MAX && append(opaque, out->data, out->len) >= 0)
+        appended = 1;
+    dovi_data_free(out);
+
+end:
+    dovi_rpu_free(rpu);
+    return appended ? 1 : vt_dovi_stripped(logctx, s);
+}
+
+int ff_vt_dovi_forward_rpu(void *logctx, const FFVTDoviStream *s,
+                           const uint8_t *nal, size_t size,
+                           FFVTDoviAppendFn append, void *opaque)
+{
+    switch (s->cls) {
+    case FF_VT_DOVI_NATIVE:
+        if (size <= UINT32_MAX && append(opaque, nal, size) >= 0)
+            return 1;
+        return vt_dovi_stripped(logctx, s);
+    case FF_VT_DOVI_CONVERTED:
+        return vt_dovi_convert_rpu(logctx, s, nal, size, append, opaque);
+    default:
+        return 0;
+    }
+}
+
+int ff_vt_dovi_frame_flags(const FFVTDoviStream *s, int dvh1_session)
+{
+    int flags;
+
+    if (!dvh1_session)
+        return 0;
+
+    flags = FF_VT_DOVI_FRAME_DVH1;
+    if (s->hdr_base)
+        flags |= FF_VT_DOVI_FRAME_HDR_BASE;
+    if (s->hlg_base)
+        flags |= FF_VT_DOVI_FRAME_HLG_BASE;
+    return flags;
+}
+
+/**
+ * Copy all attachments in a mode, with the API the running OS has.
+ */
+static CFDictionaryRef vt_dovi_copy_attachments(CVBufferRef buffer,
+                                                CVAttachmentMode mode)
+{
+#if (TARGET_OS_OSX  && defined(__MAC_12_0)    && __MAC_OS_X_VERSION_MAX_ALLOWED  >= __MAC_12_0)     || \
+    (TARGET_OS_IOS  && defined(__IPHONE_15_0) && __IPHONE_OS_VERSION_MAX_ALLOWED >= __IPHONE_15_0)  || \
+    (TARGET_OS_TV   && defined(__TVOS_15_0)   && __TV_OS_VERSION_MAX_ALLOWED     >= __TVOS_15_0)
+    if (__builtin_available(macOS 12.0, iOS 15.0, tvOS 15.0, *))
+        return CVBufferCopyAttachments(buffer, mode);
+#endif
+
+#if (TARGET_OS_OSX  && (!defined(__MAC_12_0)    || __MAC_OS_X_VERSION_MIN_REQUIRED  < __MAC_12_0))     || \
+    (TARGET_OS_IOS  && (!defined(__IPHONE_15_0) || __IPHONE_OS_VERSION_MIN_REQUIRED < __IPHONE_15_0))  || \
+    (TARGET_OS_TV   && (!defined(__TVOS_15_0)   || __TV_OS_VERSION_MIN_REQUIRED     < __TVOS_15_0))
+    {
+        CFDictionaryRef dict = CVBufferGetAttachments(buffer, mode);
+        return dict ? CFDictionaryCreateCopy(kCFAllocatorDefault, dict) : NULL;
+    }
+#else
+    return NULL;
+#endif
+}
+
+/**
+ * Whether the buffer carries an attachment for the key, in any mode.
+ */
+static int vt_dovi_has_attachment(CVBufferRef buffer, CFStringRef key)
+{
+#if (TARGET_OS_OSX  && defined(__MAC_12_0)    && __MAC_OS_X_VERSION_MAX_ALLOWED  >= __MAC_12_0)     || \
+    (TARGET_OS_IOS  && defined(__IPHONE_15_0) && __IPHONE_OS_VERSION_MAX_ALLOWED >= __IPHONE_15_0)  || \
+    (TARGET_OS_TV   && defined(__TVOS_15_0)   && __TV_OS_VERSION_MAX_ALLOWED     >= __TVOS_15_0)
+    if (__builtin_available(macOS 12.0, iOS 15.0, tvOS 15.0, *))
+        return CVBufferHasAttachment(buffer, key);
+#endif
+
+#if (TARGET_OS_OSX  && (!defined(__MAC_12_0)    || __MAC_OS_X_VERSION_MIN_REQUIRED  < __MAC_12_0))     || \
+    (TARGET_OS_IOS  && (!defined(__IPHONE_15_0) || __IPHONE_OS_VERSION_MIN_REQUIRED < __IPHONE_15_0))  || \
+    (TARGET_OS_TV   && (!defined(__TVOS_15_0)   || __TV_OS_VERSION_MIN_REQUIRED     < __TVOS_15_0))
+    return CVBufferGetAttachment(buffer, key, NULL) != NULL;
+#else
+    return 0;
+#endif
+}
+
+static void vt_dovi_set_if_absent(CVBufferRef buffer, CFStringRef key,
+                                  CFTypeRef value)
+{
+    if (!vt_dovi_has_attachment(buffer, key))
+        CVBufferSetAttachment(buffer, key, value,
+                              kCVAttachmentMode_ShouldPropagate);
+}
+
+void ff_vt_dovi_tag_frame(CVPixelBufferRef pixbuf, int frame_flags)
+{
+    CFDictionaryRef attachments;
+    CGColorSpaceRef colorspace;
+
+    // Profile 5 buffers keep exactly what VideoToolbox gave them.
+    if (!(frame_flags & FF_VT_DOVI_FRAME_DVH1) ||
+        !(frame_flags & FF_VT_DOVI_FRAME_HDR_BASE))
+        return;
+
+    vt_dovi_set_if_absent(pixbuf, kCVImageBufferColorPrimariesKey,
+                          kCVImageBufferColorPrimaries_ITU_R_2020);
+    vt_dovi_set_if_absent(pixbuf, kCVImageBufferTransferFunctionKey,
+                          frame_flags & FF_VT_DOVI_FRAME_HLG_BASE ?
+                              kCVImageBufferTransferFunction_ITU_R_2100_HLG :
+                              kCVImageBufferTransferFunction_SMPTE_ST_2084_PQ);
+    vt_dovi_set_if_absent(pixbuf, kCVImageBufferYCbCrMatrixKey,
+                          kCVImageBufferYCbCrMatrix_ITU_R_2020);
+
+    if (vt_dovi_has_attachment(pixbuf, kCVImageBufferCGColorSpaceKey))
+        return;
+
+    attachments = vt_dovi_copy_attachments(pixbuf,
+                                           kCVAttachmentMode_ShouldPropagate);
+    if (!attachments)
+        return;
+    colorspace = CVImageBufferCreateColorSpaceFromAttachments(attachments);
+    CFRelease(attachments);
+    if (!colorspace)
+        return;
+    CVBufferSetAttachment(pixbuf, kCVImageBufferCGColorSpaceKey, colorspace,
+                          kCVAttachmentMode_ShouldPropagate);
+    CFRelease(colorspace);
+}
