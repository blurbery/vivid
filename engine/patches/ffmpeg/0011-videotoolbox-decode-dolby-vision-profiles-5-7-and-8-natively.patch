+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/**
+ * @file
+ * Dolby Vision decisions for VideoToolbox HEVC sessions.
+ *
+ * HEVC streams whose container record describes Dolby Vision profile 5, 7
+ * or 8 with an RPU and a base layer are decoded with a Dolby Vision HEVC
+ * ('dvh1') session. Profile 7 is presented to VideoToolbox as profile 8.1:
+ * the configuration record is rewritten, every RPU is converted with
+ * libdovi and the enhancement layer is never sent. Everything here is
+ * independent of the HEVC decoder's internals, so it can be exercised on
+ * its own; videotoolbox.c calls it at session start, for each NAL unit it
+ * appends, at the end of each frame and when a decoded frame is output.
+ */
+
+#ifndef AVCODEC_VIDEOTOOLBOX_DOVI_H
+#define AVCODEC_VIDEOTOOLBOX_DOVI_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <CoreFoundation/CoreFoundation.h>
+#include <CoreVideo/CoreVideo.h>
+#include <VideoToolbox/VideoToolbox.h>
+
+#include "libavutil/dovi_meta.h"
+#include "libavutil/macros.h"
+
+/**
+ * CoreMedia's kCMVideoCodecType_DolbyVisionHEVC, written as its
+ * four-character code so that no SDK availability guard is needed.
+ */
+#define FF_VT_DOVI_CODEC_TYPE MKBETAG('d', 'v', 'h', '1')
+
+/** Size of the DOVIDecoderConfigurationRecord handed to VideoToolbox. */
+#define FF_VT_DOVI_RECORD_SIZE 24
+
+/** libdovi 3.3.2 conversion mode 2 ("To81"). */
+#define FF_VT_DOVI_CONVERSION_MODE 2
+
+/** HEVC NAL unit types that carry Dolby Vision RPUs and enhancement layers. */
+#define FF_VT_DOVI_NAL_RPU 62
+#define FF_VT_DOVI_NAL_EL  63
+
+enum FFVTDoviClass {
+    /** No usable record: a pristine HEVC session. */
+    FF_VT_DOVI_PLAIN = 0,
+    /** Profile 5 or 8: a 'dvh1' session, RPUs forwarded unchanged. */
+    FF_VT_DOVI_NATIVE,
+    /** Profile 7: a 'dvh1' session as profile 8.1, RPUs converted. */
+    FF_VT_DOVI_CONVERTED,
+};
+
+typedef struct FFVTDoviStream {
+    enum FFVTDoviClass cls;
+    /** The container's record; only meaningful when cls is not plain. */
+    AVDOVIDecoderConfigurationRecord record;
+    /** The base layer is a picture a plain HDR decode can show. */
+    int hdr_base;
+    /** That base layer is HLG (profile 8 with compatibility id 4). */
+    int hlg_base;
+} FFVTDoviStream;
+
+/**
+ * Flags describing the session current when a frame is output.
+ */
+enum {
+    FF_VT_DOVI_FRAME_DVH1     = 1 << 0, ///< the session is a 'dvh1' session
+    FF_VT_DOVI_FRAME_HDR_BASE = 1 << 1, ///< the stream has an HDR-compatible base
+    FF_VT_DOVI_FRAME_HLG_BASE = 1 << 2, ///< ... which is HLG
+};
+
+/**
+ * Classify a stream from its coded AV_PKT_DATA_DOVI_CONF side data.
+ *
+ * @param side_data the side data payload, or NULL when there is none
+ * @param size      the payload size; a record smaller than
+ *                  AVDOVIDecoderConfigurationRecord counts as absent
+ */
+void ff_vt_dovi_classify(FFVTDoviStream *s, const uint8_t *side_data,
+                         size_t size);
+
+/** The Dolby Vision profile presented to VideoToolbox (7 becomes 8). */
+int ff_vt_dovi_effective_profile(const FFVTDoviStream *s);
+
+/**
+ * Write the 24-byte configuration record presented to VideoToolbox.
+ *
+ * @return 0, or a negative error code for a plain HEVC stream
+ */
+int ff_vt_dovi_write_record(const FFVTDoviStream *s,
+                            uint8_t record[FF_VT_DOVI_RECORD_SIZE]);
+
+/** "dvvC" when the effective profile is above 7, otherwise "dvcC". */
+CFStringRef ff_vt_dovi_atom_key(const FFVTDoviStream *s);
+
+/**
+ * Add the Dolby Vision configuration atom to the sample description
+ * extension atoms, and, for an HDR-compatible base, the colour extensions
+ * to the top level of the format description extensions.
+ *
+ * @return 0, or a negative error code when nothing could be added
+ */
+int ff_vt_dovi_add_extensions(const FFVTDoviStream *s,
+                              CFMutableDictionaryRef extensions,
+                              CFMutableDictionaryRef atoms);
+
+/**
+ * Whether a refused 'dvh1' session is retried once as plain HEVC:
+ * only for a non-zero status and an HDR-compatible base, never profile 5.
+ */
+int ff_vt_dovi_retry_as_hevc(const FFVTDoviStream *s, OSStatus status);
+
+/**
+ * Ask a 'dvh1' session for per-frame HDR display metadata where the OS has
+ * the properties. A property that cannot be set is logged and ignored.
+ */
+void ff_vt_dovi_set_session_properties(void *logctx,
+                                       VTDecompressionSessionRef session);
+
+/**
+ * The profile 7 NAL filter: whether a NAL unit headed for the sample must
+ * be dropped because it is an RPU or an enhancement layer NAL unit of a
+ * converted stream. NAL units shorter than 2 bytes are never dropped.
+ */
+int ff_vt_dovi_drop_nal(const FFVTDoviStream *s, const uint8_t *nal,
+                        size_t size);
+
+/**
+ * Whether a NAL unit of the current packet is forwarded at the end of the
+ * frame: type 62, more than 2 bytes escaped, header included.
+ */
+int ff_vt_dovi_is_rpu(int nal_type, int raw_size);
+
+/**
+ * Whether a profile 7 RPU is zero-filled or truncated, so that it is
+ * skipped as a parse failure without calling libdovi: at least 25 bytes,
+ * starting 0x7C 0x01 0x19 0x08 0x09, and 5 bytes or fewer left once the
+ * header, the emulation prevention bytes and the trailing zero bytes are
+ * removed.
+ */
+int ff_vt_dovi_rpu_is_empty(const uint8_t *nal, size_t size);
+
+/**
+ * Appends one NAL unit to the sample, length-prefixed.
+ *
+ * @return 0, or a negative error code
+ */
+typedef int (*FFVTDoviAppendFn)(void *opaque, const uint8_t *nal,
+                                size_t size);
+
+/**
+ * Forward one RPU NAL unit (escaped, header included) of a Dolby Vision
+ * stream: unchanged for native streams, converted to profile 8.1 for
+ * profile 7. An RPU that cannot be converted or appended is skipped with
+ * warnings; the frame carries on without it.
+ *
+ * @return 1 if the RPU was appended, 0 if it was skipped
+ */
+int ff_vt_dovi_forward_rpu(void *logctx, const FFVTDoviStream *s,
+                           const uint8_t *nal, size_t size,
+                           FFVTDoviAppendFn append, void *opaque);
+
+/** The FF_VT_DOVI_FRAME_* flags for a stream and its current session. */
+int ff_vt_dovi_frame_flags(const FFVTDoviStream *s, int dvh1_session);
+
+/**
+ * Tag a decoded buffer from a 'dvh1' session. VideoToolbox's own
+ * attachments are kept; for an HDR-compatible base, BT.2020 primaries, PQ
+ * (or HLG) transfer and BT.2020 matrix are added where absent, and then a
+ * colour space where absent. Profile 5 buffers are left untouched.
+ */
+void ff_vt_dovi_tag_frame(CVPixelBufferRef pixbuf, int frame_flags);
+
+#endif /* AVCODEC_VIDEOTOOLBOX_DOVI_H */
