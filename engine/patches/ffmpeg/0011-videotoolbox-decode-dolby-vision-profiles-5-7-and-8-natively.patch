     frame->width  = avctx->width;
     frame->height = avctx->height;
@@ -535,6 +564,7 @@
 
     av_buffer_unref(&vtctx->cached_hw_frames_ctx);
     av_freep(&vtctx->vt_ctx);
+    av_refstruct_unref(&vtctx->dovi_frame_state);
 
     return 0;
 }
@@ -834,7 +864,8 @@
 }
 
 static CFDictionaryRef videotoolbox_decoder_config_create(CMVideoCodecType codec_type,
-                                                          AVCodecContext *avctx)
+                                                          AVCodecContext *avctx,
+                                                          const FFVTDoviStream *dovi)
 {
     CFMutableDictionaryRef avc_info;
     CFDataRef data = NULL;
@@ -845,7 +876,8 @@
                                                                    &kCFTypeDictionaryValueCallBacks);
 
     CFDictionarySetValue(config_info,
-                         codec_type == kCMVideoCodecType_HEVC ?
+                         codec_type == kCMVideoCodecType_HEVC ||
+                         codec_type == FF_VT_DOVI_CODEC_TYPE ?
                             kVTVideoDecoderSpecification_EnableHardwareAcceleratedVideoDecoder :
                             kVTVideoDecoderSpecification_RequireHardwareAcceleratedVideoDecoder,
                          kCFBooleanTrue);
@@ -868,9 +900,14 @@
             CFDictionarySetValue(avc_info, CFSTR("avcC"), data);
         break;
     case kCMVideoCodecType_HEVC :
+    case FF_VT_DOVI_CODEC_TYPE :
         data = ff_videotoolbox_hvcc_extradata_create(avctx);
         if (data)
             CFDictionarySetValue(avc_info, CFSTR("hvcC"), data);
+        // Dolby Vision HEVC: the configuration atom next to hvcC, plus the
+        // colour extensions for an HDR-compatible base.
+        if (codec_type == FF_VT_DOVI_CODEC_TYPE && dovi)
+            ff_vt_dovi_add_extensions(dovi, config_info, avc_info);
         break;
 #if CONFIG_VP9_VIDEOTOOLBOX_HWACCEL
     case kCMVideoCodecType_VP9 :
@@ -899,15 +936,116 @@
 
     CFRelease(avc_info);
     return config_info;
+}
+
+/**
+ * Classify an HEVC stream from its container's Dolby Vision record at each
+ * session start, and choose a Dolby Vision HEVC session for profiles 5, 7
+ * and 8.
+ */
+static int videotoolbox_dovi_start(AVCodecContext *avctx,
+                                   AVVideotoolboxContext *videotoolbox)
+{
+    VTContext *vtctx = avctx->internal->hwaccel_priv_data;
+    const AVPacketSideData *sd;
+    const AVDOVIDecoderConfigurationRecord *rec;
+
+    if (!vtctx)
+        return 0;
+
+    // The frame flags are published once the session exists (or has
+    // failed), so frames output meanwhile keep the previous session's.
+    vtctx->dovi_session = false;
+
+    if (avctx->codec_id != AV_CODEC_ID_HEVC) {
+        ff_vt_dovi_classify(&vtctx->dovi, NULL, 0);
+        return 0;
+    }
+
+    if (!vtctx->dovi_frame_state) {
+        vtctx->dovi_frame_state = av_refstruct_allocz(sizeof(*vtctx->dovi_frame_state));
+        if (!vtctx->dovi_frame_state)
+            return AVERROR(ENOMEM);
+    }
+
+    sd = ff_get_coded_side_data(avctx, AV_PKT_DATA_DOVI_CONF);
+    ff_vt_dovi_classify(&vtctx->dovi, sd ? sd->data : NULL, sd ? sd->size : 0);
+    if (vtctx->dovi.cls == FF_VT_DOVI_PLAIN)
+        return 0;
+
+    rec = &vtctx->dovi.record;
+    av_log(avctx, AV_LOG_VERBOSE,
+           "Dolby Vision profile %d, level %d, compatibility id %d: "
+           "opening a Dolby Vision HEVC session%s\n",
+           rec->dv_profile, rec->dv_level, rec->dv_bl_signal_compatibility_id,
+           vtctx->dovi.cls == FF_VT_DOVI_CONVERTED ?
+               " as profile 8.1 with converted RPUs" : "");
+    videotoolbox->cm_codec_type = FF_VT_DOVI_CODEC_TYPE;
+    return 0;
+}
+
+/**
+ * VideoToolbox refused the Dolby Vision HEVC session of a stream with an
+ * HDR-compatible base: make exactly one more attempt with a plain HEVC
+ * description. Returns the status of that attempt, or the original status
+ * if the plain description could not be built.
+ */
+static OSStatus videotoolbox_dovi_retry(AVCodecContext *avctx,
+                                        AVVideotoolboxContext *videotoolbox,
+                                        OSStatus status,
+                                        CFDictionaryRef buf_attr,
+                                        const VTDecompressionOutputCallbackRecord *decoder_cb)
+{
+    CFDictionaryRef decoder_spec;
+    CMVideoFormatDescriptionRef cm_fmt_desc;
+
+    av_log(avctx, AV_LOG_WARNING,
+           "VideoToolbox refused the Dolby Vision HEVC session (status %d); "
+           "trying a plain HEVC session\n", (int)status);
+
+    if (videotoolbox->session) {
+        VTDecompressionSessionInvalidate(videotoolbox->session);
+        CFRelease(videotoolbox->session);
+        videotoolbox->session = NULL;
+    }
+
+    decoder_spec = videotoolbox_decoder_config_create(kCMVideoCodecType_HEVC, avctx, NULL);
+    if (!decoder_spec)
+        return status;
+
+    cm_fmt_desc = videotoolbox_format_desc_create(kCMVideoCodecType_HEVC,
+                                                  decoder_spec,
+                                                  avctx->width,
+                                                  avctx->height);
+    if (!cm_fmt_desc) {
+        CFRelease(decoder_spec);
+        return status;
+    }
+
+    // Samples are created from the session's format description.
+    CFRelease(videotoolbox->cm_fmt_desc);
+    videotoolbox->cm_fmt_desc   = cm_fmt_desc;
+    videotoolbox->cm_codec_type = kCMVideoCodecType_HEVC;
+
+    status = VTDecompressionSessionCreate(NULL,
+                                          videotoolbox->cm_fmt_desc,
+                                          decoder_spec,
+                                          buf_attr,
+                                          decoder_cb,
+                                          &videotoolbox->session);
+    CFRelease(decoder_spec);
+    return status;
 }
 
 static int videotoolbox_start(AVCodecContext *avctx)
 {
     AVVideotoolboxContext *videotoolbox = videotoolbox_get_context(avctx);
+    VTContext *vtctx = avctx->internal->hwaccel_priv_data;
     OSStatus status;
     VTDecompressionOutputCallbackRecord decoder_cb;
     CFDictionaryRef decoder_spec;
     CFDictionaryRef buf_attr;
+    int ret;
 
     if (!videotoolbox) {
         av_log(avctx, AV_LOG_ERROR, "hwaccel context is not set\n");
@@ -958,6 +1096,9 @@
         break;
     }
 
+    if ((ret = videotoolbox_dovi_start(avctx, videotoolbox)) < 0)
+        return ret;
+
 #if defined(MAC_OS_X_VERSION_10_9) && !TARGET_OS_IPHONE && (MAC_OS_X_VERSION_MAX_ALLOWED >= MAC_OS_X_VERSION_10_9) && AV_HAS_BUILTIN(__builtin_available)
     if (avctx->codec_id == AV_CODEC_ID_PRORES) {
         if (__builtin_available(macOS 10.9, *)) {
@@ -972,7 +1113,8 @@
     }
 #endif
 
-    decoder_spec = videotoolbox_decoder_config_create(videotoolbox->cm_codec_type, avctx);
+    decoder_spec = videotoolbox_decoder_config_create(videotoolbox->cm_codec_type, avctx,
+                                                      vtctx ? &vtctx->dovi : NULL);
 
     if (!decoder_spec) {
         av_log(avctx, AV_LOG_ERROR, "decoder specification creation failed\n");
@@ -1005,11 +1147,25 @@
                                           &decoder_cb,               // outputCallback
                                           &videotoolbox->session);   // decompressionSessionOut
 
+    if (vtctx && videotoolbox->cm_codec_type == FF_VT_DOVI_CODEC_TYPE &&
+        ff_vt_dovi_retry_as_hevc(&vtctx->dovi, status))
+        status = videotoolbox_dovi_retry(avctx, videotoolbox, status,
+                                         buf_attr, &decoder_cb);
+
     if (decoder_spec)
         CFRelease(decoder_spec);
     if (buf_attr)
         CFRelease(buf_attr);
 
+    if (vtctx && status == 0 &&
+        videotoolbox->cm_codec_type == FF_VT_DOVI_CODEC_TYPE) {
+        vtctx->dovi_session = true;
+        ff_vt_dovi_set_session_properties(avctx, videotoolbox->session);
+    }
+    if (vtctx && vtctx->dovi_frame_state)
+        atomic_store(&vtctx->dovi_frame_state->flags,
+                     ff_vt_dovi_frame_flags(&vtctx->dovi, vtctx->dovi_session));
+
     switch (status) {
     case kVTVideoDecoderNotAvailableNowErr:
         av_log(avctx, AV_LOG_VERBOSE, "VideoToolbox session not available.\n");
@@ -1109,6 +1265,13 @@
                                           const uint8_t *buffer,
                                           uint32_t size)
 {
+    VTContext *vtctx = avctx->internal->hwaccel_priv_data;
+
+    // Profile 7: neither RPUs nor enhancement layer NAL units reach the
+    // sample this way; converted RPUs are appended at the end of the frame.
+    if (ff_vt_dovi_drop_nal(&vtctx->dovi, buffer, size))
+        return 0;
+
     return videotoolbox_common_decode_slice(avctx, buffer, size);
 }
 
@@ -1118,9 +1281,50 @@
                                            const uint8_t *buffer,
                                            uint32_t size)
 {
+    VTContext *vtctx = avctx->internal->hwaccel_priv_data;
+
+    if (ff_vt_dovi_drop_nal(&vtctx->dovi, buffer, size))
+        return 0;
+
     return videotoolbox_common_decode_slice(avctx, buffer, size);
 }
 
+static int videotoolbox_dovi_append(void *opaque, const uint8_t *nal, size_t size)
+{
+    AVCodecContext *avctx = opaque;
+    VTContext *vtctx = avctx->internal->hwaccel_priv_data;
+
+    if (size > INT_MAX - 4 || vtctx->bitstream_size > INT_MAX - 4 - (int)size)
+        return AVERROR(ERANGE);
+
+    return videotoolbox_common_decode_slice(avctx, nal, size);
+}
+
+/**
+ * Append the current packet's Dolby Vision RPUs after its slices, in packet
+ * order: unchanged for profiles 5 and 8, converted to profile 8.1 for
+ * profile 7. Done only while the session is a Dolby Vision HEVC session; a
+ * failed RPU is left out and the frame is decoded without it.
+ */
+static void videotoolbox_dovi_forward_rpus(AVCodecContext *avctx)
+{
+    HEVCContext *h = avctx->priv_data;
+    VTContext *vtctx = avctx->internal->hwaccel_priv_data;
+
+    if (!vtctx->dovi_session || vtctx->dovi.cls == FF_VT_DOVI_PLAIN ||
+        !vtctx->bitstream_size)
+        return;
+
+    for (int i = 0; i < h->pkt.nb_nals; i++) {
+        const H2645NAL *nal = &h->pkt.nals[i];
+
+        if (ff_vt_dovi_is_rpu(nal->type, nal->raw_size))
+            ff_vt_dovi_forward_rpu(avctx, &vtctx->dovi, nal->raw_data,
+                                   nal->raw_size, videotoolbox_dovi_append,
+                                   avctx);
+    }
+}
+
 static int videotoolbox_hevc_end_frame(AVCodecContext *avctx)
 {
     HEVCContext *h = avctx->priv_data;
@@ -1128,6 +1332,10 @@
     VTContext *vtctx = avctx->internal->hwaccel_priv_data;
     int ret;
 
+    // Before the pending-restart check in ff_videotoolbox_common_end_frame,
+    // so a frame that triggers a restart follows the session it replaces.
+    videotoolbox_dovi_forward_rpus(avctx);
+
     ret = ff_videotoolbox_common_end_frame(avctx, frame);
     vtctx->bitstream_size = 0;
     return ret;
