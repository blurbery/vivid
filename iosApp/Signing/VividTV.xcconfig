// Retained tvOS development signing defaults; Vivid distribution is not configured.
// Override locally with Local.xcconfig; see Local.xcconfig.sample.
// VIVID_* variables support repository-local signing overrides.

VIVID_TV_BUNDLE_ID = com.blurbery.vivid
VIVID_TV_DISPLAY_NAME = Vivid
VIVID_TV_ENTITLEMENTS = VividTV.entitlements
VIVID_USER_INDEPENDENT_KEYCHAIN = YES

PRODUCT_BUNDLE_IDENTIFIER = $(VIVID_TV_BUNDLE_ID)
CODE_SIGN_ENTITLEMENTS = $(VIVID_TV_ENTITLEMENTS)

#include? "Local.xcconfig"
