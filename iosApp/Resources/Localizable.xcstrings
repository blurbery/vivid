    },
    "Captions apply across Home, Search, Movies, Series and For You. Title & Year, Title Only and Artwork Only keep the same text size and left alignment. Episodes show episode details instead of the year." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Beschriftung gilt für Home, Suchen, Filme, Serien und Für dich. „Titel & Jahr“, „Nur Titel“ und „Nur Bild“ behalten dieselbe Textgröße und linksbündige Ausrichtung. Folgen zeigen statt des Jahres Details zur Folge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los rótulos se aplican en Inicio, Buscar, Películas, Series y Para ti. Título y año, Solo título y Solo ilustración mantienen el mismo tamaño de texto y la alineación a la izquierda. Los episodios muestran sus detalles en lugar del año."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les légendes s’appliquent à Accueil, Rechercher, Films, Séries et Pour vous. Titre et année, Titre seul et Illustration seule conservent la même taille de texte et l’alignement à gauche. Les épisodes affichent les détails de l’épisode au lieu de l’année."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャプションはホーム、検索、映画、シリーズ、おすすめに適用されます。「タイトルと年」「タイトルのみ」「アートワークのみ」では、文字サイズと左揃えが共通です。エピソードでは年の代わりにエピソードの詳細が表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说明文字适用于主页、搜索、电影、剧集和为你推荐。“标题和年份”、“仅标题”和“仅图片”保持相同的文字大小和左对齐。单集会显示分集信息，而不是年份。"
          }
        }
      }
    },
