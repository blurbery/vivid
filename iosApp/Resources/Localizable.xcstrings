    "Lucid buffers ahead automatically, with up to 256 MB ahead and 16 MB behind for seeking. Playback starts before the buffer fills." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lucid puffert automatisch voraus, mit bis zu 256 MB voraus und 16 MB zurück zum Springen. Die Wiedergabe beginnt, bevor der Puffer voll ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lucid precarga automáticamente, con hasta 256 MB por delante y 16 MB por detrás para saltar. La reproducción empieza antes de que se llene el búfer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lucid met automatiquement en mémoire tampon jusqu’à 256 Mo en avance et 16 Mo en arrière pour les déplacements. La lecture démarre avant que la mémoire tampon soit pleine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lucidは自動的に先読みし、前方に最大256 MB、シーク用に後方に16 MBをバッファします。再生はバッファがいっぱいになる前に始まります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lucid 会自动预缓冲，最多向前缓冲 256 MB，并保留 16 MB 已播内容以便跳转。播放会在缓冲填满前开始。"
          }
        }
      }
    },
