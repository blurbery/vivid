    "Send completed watches to MDBList and sync watchlists both ways. Watchlist matches include titles on your active server." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet abgeschlossene Wiedergaben an MDBList und synchronisiert Watchlists in beide Richtungen. Watchlist-Treffer umfassen Titel auf deinem aktiven Server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía a MDBList lo que termines de ver y sincroniza Mi lista en ambos sentidos. Las coincidencias de Mi lista incluyen títulos de tu servidor activo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyer les visionnages terminés à MDBList et synchroniser les listes de titres à regarder dans les deux sens. Les correspondances de ces listes incluent les titres de votre serveur actif."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視聴を完了した作品をMDBListに送信し、ウォッチリストを双方向で同期します。ウォッチリストの照合には、使用中のサーバ上のタイトルが含まれます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将已看完的记录发送到 MDBList，并双向同步待播清单。待播清单匹配包括你当前服务器上的作品。"
          }
        }
      }
    },
    "Send to Vivid" : {
      "extractionState" : "manual"
