    "Home is required. Use the arrows to reorder tabs. Downloads (when available), Search, and Profile stay automatic." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home ist erforderlich. Ordne die Tabs mit den Pfeilen neu an. Downloads (falls verfügbar), Suchen und Profil werden automatisch angeordnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicio es obligatorio. Usa las flechas para reordenar las pestañas. Descargas (si está disponible), Buscar y Perfil se gestionan automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’onglet Accueil est obligatoire. Utilisez les flèches pour réorganiser les onglets. Téléchargements (si disponible), Rechercher et Profil restent automatiques."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ホーム」は必須です。矢印を使ってタブを並べ替えます。「ダウンロード」（利用可能な場合）、「検索」、「プロフィール」は自動的に配置されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“主页”为必需项。使用箭头重新排列标签。“下载”（可用时）、“搜索”和“个人资料”保持自动。"
          }
        }
      }
    },
