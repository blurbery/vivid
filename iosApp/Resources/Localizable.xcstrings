    },
    "Sending completed watches" : {
      "extractionState" : "manual"
    },
    "Sending…" : {
      "extractionState" : "manual"
    },
    "Sends the reports to Vivid, where they're emailed to %@ and kept for 30 days. Other Options sends them with Mail or the share sheet instead. Open a report to send it on its own. Anything you write in the note is sent as written, so leave out passwords and server addresses." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet die Berichte an Vivid, wo sie per E-Mail an %@ gehen und 30 Tage aufbewahrt werden. „Weitere Optionen“ sendet sie stattdessen mit Mail oder über das Teilen-Menü. Öffne einen Bericht, um ihn einzeln zu senden. Alles, was du in die Notiz schreibst, wird unverändert gesendet. Lass also Passwörter und Serveradressen weg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía los informes a Vivid, donde se mandan por correo a %@ y se conservan durante 30 días. Con Otras opciones se envían con Mail o con el menú Compartir. Abre un informe para enviarlo por separado. Todo lo que escribas en la nota se envía tal cual, así que no incluyas contraseñas ni direcciones de servidores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie les rapports à Vivid, où ils sont transmis par e-mail à %@ et conservés 30 jours. Autres options les envoie plutôt avec Mail ou la feuille de partage. Ouvrez un rapport pour l’envoyer seul. Tout ce que vous écrivez dans la note est envoyé tel quel : n’y mettez ni mots de passe ni adresses de serveur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レポートをVividに送信します。レポートは%@宛てにメールで送られ、30日間保管されます。「その他のオプション」では、代わりにメールまたは共有シートで送信します。レポートを開くと、そのレポートだけを送信できます。メモに書いた内容はそのまま送信されるため、パスワードやサーバのアドレスは書かないでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将报告发送给 Vivid，报告会通过电子邮件发送至 %@ 并保留 30 天。“其他选项”可改用“邮件”或共享表单发送。打开某份报告可单独发送。你在备注中填写的任何内容都会原样发送，因此请勿填写密码和服务器地址。"
          }
        }
      }
    },
    "Sends these reports to Vivid, where they're emailed to %@ and kept for 30 days. Open a report in Diagnostics to see exactly what it contains. Anything you write in the note is sent as written, so leave out passwords and server addresses." : {
      "extractionState" : "manual"
    },
    "Sends this session to Vivid, where it's emailed to %@ and kept for 30 days. It contains no titles, account details or server addresses. Anything you write in the note is sent as written, so leave out passwords and server addresses." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet diese Sitzung an Vivid, wo sie per E-Mail an %@ geht und 30 Tage aufbewahrt wird. Sie enthält keine Titel, Account-Details oder Serveradressen. Alles, was du in die Notiz schreibst, wird unverändert gesendet. Lass also Passwörter und Serveradressen weg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía esta sesión a Vivid, donde se manda por correo a %@ y se conserva durante 30 días. No contiene títulos, datos de la cuenta ni direcciones de servidores. Todo lo que escribas en la nota se envía tal cual, así que no incluyas contraseñas ni direcciones de servidores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie cette session à Vivid, où elle est transmise par e-mail à %@ et conservée 30 jours. Elle ne contient aucun titre, détail de compte ni adresse de serveur. Tout ce que vous écrivez dans la note est envoyé tel quel : n’y mettez ni mots de passe ni adresses de serveur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このセッションをVividに送信します。セッションは%@宛てにメールで送られ、30日間保管されます。タイトル、アカウント情報、サーバのアドレスは含まれません。メモに書いた内容はそのまま送信されるため、パスワードやサーバのアドレスは書かないでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将本次播放记录发送给 Vivid，记录会通过电子邮件发送至 %@ 并保留 30 天。其中不包含作品名称、账户详细信息或服务器地址。你在备注中填写的任何内容都会原样发送，因此请勿填写密码和服务器地址。"
          }
        }
      }
    },
