    "New Home data replaces stale items automatically. Use a bin to clear a section’s saved metadata and unused artwork. It caches again the next time Home refreshes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Home-Daten ersetzen veraltete Einträge automatisch. Leere mit dem Papierkorb die gespeicherten Metadaten und ungenutzten Bilder eines Bereichs. Er wird beim nächsten Aktualisieren von Home wieder zwischengespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos nuevos de Inicio sustituyen automáticamente a los elementos antiguos. Usa una papelera para borrar los metadatos guardados de una sección y las ilustraciones sin usar. Vuelve a guardarse en caché la próxima vez que Inicio se actualice."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouvelles données de l’accueil remplacent automatiquement les éléments obsolètes. Utilisez une corbeille pour effacer les métadonnées enregistrées et les illustrations inutilisées d’une section. Elle est remise en cache à la prochaine actualisation de l’accueil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホームの新しいデータで古い項目は自動的に置き換えられます。ゴミ箱を使うと、セクションの保存済みメタデータと使われていないアートワークを消去できます。次にホームが更新されたときに再びキャッシュされます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新的主页数据会自动替换过期的项目。使用废纸篓图标可清除某个栏目已存储的元数据和未使用的插图。主页下次刷新时会重新缓存。"
          }
        }
      }
    },
    "New PIN" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue PIN"
