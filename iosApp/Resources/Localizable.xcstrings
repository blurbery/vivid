    "Signing in saves this profile and its server together. Saved servers are available in Manage Servers and when adding another profile." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der Anmeldung werden dieses Profil und sein Server zusammen gespeichert. Gespeicherte Server sind unter „Server verwalten“ und beim Hinzufügen eines weiteren Profils verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
