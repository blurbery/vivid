    },
    "Vivid couldn't verify that profile's PIN. Please try again." : {
      "extractionState" : "manual"
    },
    "Vivid couldn’t read your saved login from Keychain. Your saved account has not been removed. Try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vivid konnte deine gespeicherte Anmeldung nicht aus dem Schlüsselbund lesen. Dein gespeicherter Account wurde nicht entfernt. Versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vivid no ha podido leer tu inicio de sesión guardado del Llavero. Tu cuenta guardada no se ha eliminado. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vivid n’a pas pu lire vos identifiants enregistrés dans le trousseau. Votre compte enregistré n’a pas été supprimé. Réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vividはキーチェーンから保存済みのログイン情報を読み取れませんでした。保存済みのアカウントは削除されていません。もう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vivid 无法从钥匙串读取你已存储的登录信息。你已存储的账户未被移除。请重试。"
          }
        }
      }
    },
