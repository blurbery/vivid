    "Start the following episode automatically." : {
      "extractionState" : "manual"
    },
    "Start with Balanced, Compact, Cinema, or Artwork Only, then fine-tune size and captions. These choices sync with other %@ devices on this profile." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beginne mit „Ausgewogen“, „Kompakt“, „Kino“ oder „Nur Bild“ und passe dann Größe und Beschriftung an. Diese Auswahl wird mit anderen %@ Geräten in diesem Profil synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza con Equilibrado, Compacto, Cine o Solo ilustración y luego ajusta el tamaño y los rótulos. Estas opciones se sincronizan con otros dispositivos %@ de este perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez par Équilibré, Compact, Cinéma ou Illustration seule, puis ajustez la taille et les légendes. Ces choix se synchronisent avec les autres appareils de ce profil (%@)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「バランス」「コンパクト」「シネマ」「アートワークのみ」から選んで、サイズとキャプションを微調整します。これらの設定は、このプロフィールのほかの%@のデバイスと同期されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先选择“均衡”、“紧凑”、“影院”或“仅图片”，再微调大小和说明文字。这些选择会与此个人资料下的其他 %@ 设备同步。"
          }
        }
      }
    },
