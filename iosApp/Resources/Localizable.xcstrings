    "A 4K version only makes 4K copies. Choose a smaller version for a smaller resolution." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine 4K-Version erstellt nur 4K-Kopien. Wähle eine kleinere Version für eine geringere Auflösung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una versión 4K solo genera copias 4K. Elige una versión más ligera para una resolución menor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une version 4K ne produit que des copies 4K. Choisissez une version plus légère pour une résolution inférieure."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4Kのバージョンからは4Kのコピーのみ作成されます。解像度を下げるには、より小さいバージョンを選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4K 版本只能制作 4K 副本。如需更低的分辨率，请选择较小的版本。"
          }
        }
      }
    },
    "A library-specific subtitle setting overrides this profile default. Changes here are saved for the profile, but the library override still applies." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine mediathekspezifische Untertiteleinstellung überschreibt diesen Profilstandard. Änderungen hier werden für das Profil gespeichert, die Anpassung der Mediathek gilt aber weiterhin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ajuste de subtítulos propio de la biblioteca anula este valor predeterminado del perfil. Los cambios que hagas aquí se guardan en el perfil, pero el ajuste de la biblioteca sigue aplicándose."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un réglage de sous-titres propre à la bibliothèque remplace ce réglage par défaut du profil. Les modifications faites ici sont enregistrées pour le profil, mais le réglage de la bibliothèque s’applique toujours."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリ固有の字幕設定が、このプロフィールのデフォルトより優先されます。ここでの変更はプロフィールに保存されますが、ライブラリ固有の設定が引き続き適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "资料库专属的字幕设置会覆盖此个人资料的默认设置。此处的更改会存储到个人资料中，但资料库的覆盖设置仍然有效。"
          }
        }
      }
    },
    "A little dialogue, a lot of story." : {
      "comment" : "Sample subtitle line in the appearance preview",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenig Dialog, viel Geschichte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poco diálogo, mucha historia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peu de dialogues, beaucoup d’histoire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "台詞は少なく、物語はたっぷり。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "台词不多，故事不少。"
          }
        }
