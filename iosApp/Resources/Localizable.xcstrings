    "Move %@. Move left or right, then press centre to drop and save." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verschieben. Nach links oder rechts bewegen und dann die Mitte drücken, um abzulegen und zu speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover %@. Muévelo a la izquierda o a la derecha y pulsa el centro para soltarlo y guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacer %@. Déplacez vers la gauche ou la droite, puis appuyez au centre pour déposer et enregistrer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を移動します。左右に動かしてから中央を押すと、配置して保存します。"
          }
