    "Hold and drag onto another profile to reorder. Release to save." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte ein Profil gedrückt und ziehe es auf ein anderes, um die Reihenfolge zu ändern. Lass los, um zu speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado y arrastra sobre otro perfil para reordenar. Suelta para guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez et faites glisser sur un autre profil pour réorganiser. Relâchez pour enregistrer."
