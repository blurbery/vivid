    "Graphite uses the charcoal background, Black uses solid black, and Native removes Vivid’s background and uses the system appearance." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Graphit“ nutzt den anthrazitfarbenen Hintergrund, „Schwarz“ reines Schwarz und „Nativ“ entfernt den Hintergrund von Vivid und nutzt die Systemdarstellung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grafito usa el fondo carbón, Negro usa negro sólido y Nativo quita el fondo de Vivid y usa el aspecto del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graphite utilise le fond anthracite, Noir utilise un noir uni et Natif supprime l’arrière-plan de Vivid pour utiliser l’apparence du système."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「グラファイト」はチャコールの背景、「ブラック」は黒一色の背景を使用し、「ネイティブ」はVividの背景を使わずにシステムの外観を使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“石墨”使用炭灰色背景，“纯黑”使用纯黑色背景，“原生”会移除 Vivid 的背景并使用系统外观。"
          }
        }
      }
    },
