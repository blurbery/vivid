    "This device family has a more specific subtitle setting. Changes here update the profile default, but the family override still applies." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Gerätefamilie hat eine spezifischere Untertiteleinstellung. Änderungen hier aktualisieren den Profilstandard, die Anpassung der Gerätefamilie gilt aber weiterhin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta familia de dispositivos tiene un ajuste de subtítulos más específico. Los cambios que hagas aquí actualizan el valor predeterminado del perfil, pero el ajuste de la familia sigue aplicándose."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette famille d’appareils possède un réglage de sous-titres plus spécifique. Les modifications faites ici mettent à jour le réglage par défaut du profil, mais le réglage de la famille s’applique toujours."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この種類のデバイスには、より細かい字幕設定があります。ここでの変更はプロフィールのデフォルトを更新しますが、デバイスの種類ごとの設定が引き続き適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此类设备有更具体的字幕设置。此处的更改会更新个人资料的默认设置，但同类设备的覆盖设置仍然有效。"
          }
        }
      }
    },
    "This device has older device-specific interface settings that override family sync." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät hat ältere gerätespezifische Oberflächeneinstellungen, die die Synchronisierung der Gerätefamilie überschreiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo tiene ajustes de interfaz propios más antiguos que anulan la sincronización por familia de dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil possède d’anciens réglages d’interface qui lui sont propres et qui remplacent la synchronisation par famille."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスには、同じ種類のデバイス間の同期より優先される、以前のデバイス固有のインターフェイス設定があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备有较早的设备专属界面设置，会覆盖同类设备同步。"
          }
        }
      }
    },
    "This device, for this profile, has a more specific subtitle setting. Changes here update the profile default, but the device override still applies." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät hat für dieses Profil eine spezifischere Untertiteleinstellung. Änderungen hier aktualisieren den Profilstandard, die Geräteanpassung gilt aber weiterhin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo tiene, para este perfil, un ajuste de subtítulos más específico. Los cambios que hagas aquí actualizan el valor predeterminado del perfil, pero el ajuste del dispositivo sigue aplicándose."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil possède, pour ce profil, un réglage de sous-titres plus spécifique. Les modifications faites ici mettent à jour le réglage par défaut du profil, mais le réglage de l’appareil s’applique toujours."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロフィールのこのデバイスには、より細かい字幕設定があります。ここでの変更はプロフィールのデフォルトを更新しますが、デバイス固有の設定が引き続き適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备在此个人资料下有更具体的字幕设置。此处的更改会更新个人资料的默认设置，但设备的覆盖设置仍然有效。"
          }
        }
