    "This server is too old to store playback preferences. Playback still works using this device's defaults. Ask your server administrator to update Silo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server ist zu alt, um Wiedergabeeinstellungen zu speichern. Die Wiedergabe funktioniert weiterhin mit den Standards dieses Geräts. Bitte deinen Serveradministrator, Silo zu aktualisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor es demasiado antiguo para guardar preferencias de reproducción. La reproducción sigue funcionando con los valores predeterminados de este dispositivo. Pide al administrador del servidor que actualice Silo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur est trop ancien pour stocker les préférences de lecture. La lecture fonctionne toujours avec les réglages par défaut de cet appareil. Demandez à l’administrateur de votre serveur de mettre à jour Silo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバは古いため、再生設定を保存できません。再生はこのデバイスのデフォルト設定で引き続き行えます。サーバ管理者にSiloのアップデートを依頼してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此服务器版本过旧，无法存储播放偏好设置。播放仍会使用此设备的默认设置。请让服务器管理员更新 Silo。"
          }
        }
      }
    },
