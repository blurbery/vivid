    "Your Silo server hasn't been updated to support the latest version of this app. Please update your server, or use an earlier compatible version of Vivid until the server has been updated." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Silo-Server wurde noch nicht aktualisiert, um die neueste Version dieser App zu unterstützen. Bitte aktualisiere deinen Server oder verwende eine frühere kompatible Version von Vivid, bis der Server aktualisiert wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu servidor Silo no se ha actualizado para admitir la última versión de esta app. Actualiza tu servidor o usa una versión anterior compatible de Vivid hasta que se actualice el servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur Silo n’a pas été mis à jour pour prendre en charge la dernière version de cette app. Mettez à jour votre serveur ou utilisez une version antérieure compatible de Vivid en attendant sa mise à jour."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お使いのSiloサーバは、このAppの最新バージョンに対応するようにアップデートされていません。サーバをアップデートするか、サーバがアップデートされるまで互換性のある以前のバージョンのVividを使用してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Silo 服务器尚未更新以支持此 App 的最新版本。请更新你的服务器，或在服务器更新之前使用较早的兼容版本 Vivid。"
          }
        }
      }
    },
