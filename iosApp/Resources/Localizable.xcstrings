    },
    "Subtitles are read from the media. Backup Language is used when full subtitles would play but the title has none in your language. Preferences are saved in Vivid for this profile on this Apple TV." : {
      "extractionState" : "manual"
    },
    "Subtitles with their own built-in styling keep their original appearance; image-based subtitles keep their authored fonts and colors but follow the size, position, and background settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untertitel mit eigener Formatierung behalten ihr ursprüngliches Aussehen; bildbasierte Untertitel behalten ihre Schriften und Farben, folgen aber den Einstellungen für Größe, Position und Hintergrund."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los subtítulos con estilo propio integrado conservan su aspecto original; los subtítulos basados en imágenes conservan sus tipos de letra y colores originales, pero siguen los ajustes de tamaño, posición y fondo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sous-titres dotés de leur propre style conservent leur apparence d’origine ; les sous-titres en image conservent les polices et couleurs prévues par leur auteur, mais suivent les réglages de taille, de position et d’arrière-plan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "独自のスタイルが組み込まれた字幕は元の外観が維持されます。画像ベースの字幕は作成時のフォントと色が維持されますが、サイズ、位置、背景の設定には従います。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自带内置样式的字幕会保留原有外观；图像字幕会保留原有的字体和颜色，但会遵循大小、位置和背景设置。"
          }
        }
      }
    },
