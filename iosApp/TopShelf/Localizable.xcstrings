    "Show Who's Watching when you've been away from Vivid for 1 hour." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Wer schaut gerade?“ anzeigen, wenn du Vivid 1 Stunde lang nicht genutzt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra ¿Quién está viendo? si llevas 1 hora fuera de Vivid."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher « Qui regarde ? » après 1 heure d’absence de Vivid."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vividから1時間離れていた場合に「誰が観ますか？」を表示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离开 Vivid 1 小时后显示“谁在观看”。"
          }
        }
      }
    },
    "Show Who's Watching when you've been away from Vivid for 12 hours." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Wer schaut gerade?“ anzeigen, wenn du Vivid 12 Stunden lang nicht genutzt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra ¿Quién está viendo? si llevas 12 horas fuera de Vivid."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher « Qui regarde ? » après 12 heures d’absence de Vivid."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vividから12時間離れていた場合に「誰が観ますか？」を表示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离开 Vivid 12 小时后显示“谁在观看”。"
          }
        }
      }
    },
    "Show Who's Watching whenever you return to Vivid." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Wer schaut gerade?“ bei jeder Rückkehr zu Vivid anzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra ¿Quién está viendo? cada vez que vuelves a Vivid."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher « Qui regarde ? » chaque fois que vous revenez dans Vivid."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vividに戻るたびに「誰が観ますか？」を表示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次返回 Vivid 时都显示“谁在观看”。"
          }
        }
      }
    },
    "Use the last profile selected on this device. A protected profile can reopen without asking for its PIN." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das zuletzt auf diesem Gerät ausgewählte Profil verwenden. Ein geschütztes Profil kann ohne PIN-Abfrage wieder geöffnet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el último perfil seleccionado en este dispositivo. Un perfil protegido puede volver a abrirse sin pedir su PIN."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser le dernier profil sélectionné sur cet appareil. Un profil protégé peut se rouvrir sans demander son code PIN."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスで最後に選択したプロフィールを使用します。保護されたプロフィールも、PINを求めずに再び開く場合があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用此设备上最后选择的个人资料。受保护的个人资料可以直接重新打开，无需输入 PIN 码。"
          }
        }
      }
    },
    "Use the profile selected for the current Apple TV user. A protected profile can reopen without asking for its PIN." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das für den aktuellen Apple TV-Benutzer ausgewählte Profil verwenden. Ein geschütztes Profil kann ohne PIN-Abfrage wieder geöffnet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el perfil seleccionado para el usuario actual del Apple TV. Un perfil protegido puede volver a abrirse sin pedir su PIN."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser le profil sélectionné pour l’utilisateur actuel de l’Apple TV. Un profil protégé peut se rouvrir sans demander son code PIN."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のApple TVユーザに選択されているプロフィールを使用します。保護されたプロフィールも、PINを求めずに再び開く場合があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用当前 Apple TV 用户所选的个人资料。受保护的个人资料可以直接重新打开，无需输入 PIN 码。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}