{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "vivid-diagnostics",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-05",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {"pattern": "diagnostics.vividapp.co", "custom_domain": true}
  ],
  // Email goes through Resend to diagnostics@vividapp.co only (fixed in
  // worker.mjs). Its API key is the RESEND_API_KEY secret, set with
  // `npx wrangler secret put RESEND_API_KEY`, never committed.
  // Copies expire after 30 days (set per key).
  "kv_namespaces": [
    {"binding": "REPORTS", "id": "3f880d478a1b4cacb5ef3fa1b36fbbd2"}
  ],
  // Five sends a minute from one address.
  "ratelimits": [
    {"name": "RATE_LIMITER", "namespace_id": "4801", "simple": {"limit": 5, "period": 60}}
  ],
  // Off so request details, including addresses, aren't retained in logs.
  "observability": {"enabled": false}
}
