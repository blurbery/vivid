+// An opportunistic prefetch must not report a hardware underrun while
+// AVPlayer still has playable audio. ao_read_data marks the AO stopped on
+// a short read, which otherwise pauses the whole player as this driver
+// builds its lead. Keep pulling normally below the existing one-second
+// priming reserve, so real starvation and EOF still reach mpv.
+static bool avp_wait_for_prefetch(struct ao *ao, int request_samples)
+{
+    struct priv *p = ao->priv;
+    int64_t ahead = p->es_pts - avp_feed_position_ns(ao);
+    return ahead >= AVP_START_MIN_NS &&
+        mp_async_queue_get_samples(ao_get_queue(ao)) < request_samples;
+}
