+static bool pcm_recreate_sink(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    AVSampleBufferAudioRenderer *renderer = [[AVSampleBufferAudioRenderer alloc] init];
+    AVSampleBufferRenderSynchronizer *synchronizer = [[AVSampleBufferRenderSynchronizer alloc] init];
