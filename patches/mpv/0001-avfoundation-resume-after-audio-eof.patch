+#if TARGET_OS_TV
+// Called on p->queue only. A seek discards the old renderer and its clock,
+// just as a new playback session does. Ordinary pause and EOF keep their sink.
+static bool pcm_recreate_sink(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    AVSampleBufferAudioRenderer *renderer = [[AVSampleBufferAudioRenderer alloc] init];
+    AVSampleBufferRenderSynchronizer *synchronizer = [[AVSampleBufferRenderSynchronizer alloc] init];
+    if (!renderer || !synchronizer) {
+        [renderer release];
+        [synchronizer release];
+        MP_WARN(ao, "pcm fresh sink failed; requesting audio reload\n");
+        ao_request_reload(ao);
+        return false;
+    }
+    [synchronizer addRenderer:renderer];
+#if HAVE_MACOS_11_3_FEATURES
+    if (@available(tvOS 14.5, *))
+        [synchronizer setDelaysRateChangeUntilHasSufficientMediaData:NO];
+#endif
+    NSNotificationCenter *center = [NSNotificationCenter defaultCenter];
+    [center removeObserver:p->observer name:nil object:p->renderer];
+    [p->renderer release];
+    [p->synchronizer release];
+    p->renderer = renderer;
+    p->synchronizer = synchronizer;
+    p->end_time_av = -1;
+    p->pcm_last_log_ns = 0;
+    p->pcm_needs_fresh_sink = false;
+#if HAVE_MACOS_12_FEATURES
+    if (@available(tvOS 15.0, *)) {
+        [center addObserver:p->observer selector:@selector(handleRestartNotification:) name:AVSampleBufferAudioRendererOutputConfigurationDidChangeNotification object:renderer];
+    }
+#endif
+    [center addObserver:p->observer selector:@selector(handleRestartNotification:) name:AVSampleBufferAudioRendererWasFlushedAutomaticallyNotification object:renderer];
+    MP_VERBOSE(ao, "pcm fresh sink after reset\n");
+    return true;
+}
+
+static bool pcm_should_feed(bool enabled, bool ready, int64_t ahead, int64_t limit)
+{
+    return enabled && ready && ahead < limit;
+}
+
+static void pcm_pump(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    if (!p->feed_enabled)
+        return;
+    int64_t now = CMTimeGetNanoseconds([p->synchronizer currentTime]);
+    int64_t host_now = mp_time_ns();
+    if (host_now - p->pcm_last_log_ns >= MP_TIME_S_TO_NS(2)) {
+        p->pcm_last_log_ns = host_now;
+        MP_VERBOSE(ao, "pcm: clock %.3f, fed %.3f, ahead %.3f, rate %.3f, status %d\n",
+                   now / 1e9, p->end_time_av / 1e9, (p->end_time_av - now) / 1e9,
+                   (double)p->synchronizer.rate, (int)p->renderer.status);
+    }
+    if (p->renderer.status == AVQueuedSampleBufferRenderingStatusFailed) {
+        MP_WARN(ao, "pcm renderer failed; requesting audio reload\n");
+        p->feed_enabled = false;
+        pcm_cancel_pending_feed(p);
+        ao_request_reload(ao);
+        return;
+    }
+    // Bound per-tick work as well as queued duration. No refill after pause,
+    // no busy-spin when backpressured, and no waiting for a readiness edge.
+    for (int i = 0; i < 4; i++) {
+        now = CMTimeGetNanoseconds([p->synchronizer currentTime]);
+        if (!pcm_should_feed(p->feed_enabled, p->renderer.readyForMoreMediaData,
+                             p->end_time_av - now, p->pcm_lookahead_ns))
+            break;
+        int64_t previous_end = p->end_time_av;
+        feed(ao);
+        if (p->end_time_av == previous_end)
+            break;
+    }
+}
