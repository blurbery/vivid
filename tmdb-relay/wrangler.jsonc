{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "vivid-tmdb",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-05",
  "workers_dev": false,
  "preview_urls": false,
  // The Cache API only works on a custom domain, not workers.dev.
  "routes": [
    {"pattern": "tmdb.vividapp.co", "custom_domain": true}
  ],
  // Vivid's TMDb read access token is the TMDB_READ_TOKEN secret, set with
  // `npx wrangler secret put TMDB_READ_TOKEN`, never committed.
  // Room for two devices' Studios & Networks refreshes at once (up to about
  // 500 requests each), while still capping bulk scraping.
  "ratelimits": [
    {"name": "RATE_LIMITER", "namespace_id": "4802", "simple": {"limit": 1200, "period": 60}}
  ],
  // Off so request details, including addresses, aren't retained in logs.
  "observability": {"enabled": false}
}
