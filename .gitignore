# Xcode / XcodeGen
iosApp/Vivid.xcodeproj/
*.xcworkspace/
xcuserdata/
*.xcuserstate
DerivedData/
iosApp/.deriveddata/

# XcodeGen regenerates the project, but the exact Swift package graph is a
# release input and must remain reviewable.
!iosApp/Vivid.xcodeproj/
iosApp/Vivid.xcodeproj/*
!iosApp/Vivid.xcodeproj/project.xcworkspace/
iosApp/Vivid.xcodeproj/project.xcworkspace/*
!iosApp/Vivid.xcodeproj/project.xcworkspace/xcshareddata/
iosApp/Vivid.xcodeproj/project.xcworkspace/xcshareddata/*
!iosApp/Vivid.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
iosApp/Vivid.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!iosApp/Vivid.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# SwiftPM / CocoaPods
.build/
iosApp/.spm-packages/
iosApp/Pods/

# Fastlane build outputs (IPAs, archives from the ipa_*_unsigned lanes)
build/
fastlane/README.md

