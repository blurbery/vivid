+
+/// Converts a source buffer's media endpoint and host presentation schedule into media time now.
+/// Device/processing latency is supplied once, already combined by AVAudioNode.
+public enum KSAudioPresentationClock {
+    public static func mediaTime(end: Double, hostDelay: Double, frames: UInt32,
+                                 sampleRate: Double, latency: Double) -> Double? {
+        guard end.isFinite, hostDelay.isFinite, sampleRate.isFinite, sampleRate > 0,
+              latency.isFinite, latency >= 0, frames > 0 else { return nil }
+        let result = end - hostDelay - Double(frames) / sampleRate - latency
+        return result.isFinite ? result : nil
+    }
+}
 
